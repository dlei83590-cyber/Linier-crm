# Database
DATABASE_URL="postgresql://nilier:nilier_secret@localhost:5432/nilier_crm?schema=public"

POSTGRES_USER=nilier
POSTGRES_PASSWORD=nilier_secret
POSTGRES_DB=nilier_crm

# Auth
NEXTAUTH_SECRET="change-me-in-production-use-random-string"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV=development

# Build metadata (injected at build time; SSOT = root package.json version)
# CI / Docker 构建时由 GitHub Actions / build args 注入真实值；本地 dev 用 fallback
NEXT_PUBLIC_APP_VERSION=0.2.0-alpha
NEXT_PUBLIC_GIT_SHA=dev
NEXT_PUBLIC_BUILD_ID=dev
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# ERP Release SSOT（与 GitHub Release / Git Tag 同步；见 repo 根 RELEASE_VERSION manifest）
NEXT_PUBLIC_RELEASE_VERSION=v0.6.0-alpha
