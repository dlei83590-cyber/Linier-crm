# Database
DATABASE_URL="postgresql://nilier:nilier_secret@localhost:5432/nilier_crm?schema=public"

POSTGRES_USER=nilier
POSTGRES_PASSWORD=nilier_secret
POSTGRES_DB=nilier_crm

# Auth
NEXTAUTH_SECRET="change-me-in-production-use-random-string"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV=development

# Build metadata (injected at build time; SSOT = root package.json version)
# CI / Docker 构建时由 GitHub Actions / build args 注入真实值；本地 dev 用 fallback
NEXT_PUBLIC_APP_VERSION=0.2.0-alpha
NEXT_PUBLIC_GIT_SHA=dev
NEXT_PUBLIC_BUILD_ID=dev
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# ERP Release SSOT（与 GitHub Release / Git Tag 同步；见 repo 根 RELEASE_VERSION manifest）
NEXT_PUBLIC_RELEASE_VERSION=v0.9.0-alpha

# DingTalk Channel（合同收口 Migration 0055：自建消息底座 + 钉钉酷卡片最小接线）
# - 只在自建 Server 环境配置（绝不进前端 / 不入 git）；DB 只存 channel key（BusinessPartner.collaborationChannelKey）
# - 格式：{ "<key>": { "name": "<协同群名称>", "webhook": "<钉钉群机器人 webhook>", "secret": "<加签密钥，可选>" } }
# - 占位示例（secret 缺省 = 机器人未加签；生产请使用真实 webhook + secret）
DINGTALK_CHANNELS_JSON={"sales-group":{"name":"销售协同群","webhook":"https://oapi.dingtalk.com/robot/send?access_token=replace-with-access-token","secret":"replace-with-robot-secret"}}
# 钉钉卡片 deep link 基址（可点击跳转 Linier 页面；不配置则卡片仅展示相对路径文本）
DINGTALK_APP_URL=https://app.example.com
# 通用 APP 基址（DINGTALK_APP_URL 未配置时的 deep link 回退）
APP_URL=https://app.example.com

# Seed bootstrap（Phase S0 锁死：正式 bootstrap 只走 prisma/seed.ts）
# - Production admin 初始密码仅允许来自 SEED_ADMIN_PASSWORD（缺失时 fail closed，禁止 fallback 固定密码）
# - 本地开发必须显式提供；不得在 repo 中提交任何真实口令
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
# 可选 test 用户 bootstrap — **non-production only**（仅本地/CI 开发环境）
# - ⚠️ production 禁止 test bootstrap：seed.ts 检测到 NODE_ENV=production 且存在 SEED_TEST_* 时直接 throw（fail closed）
# - 仅当 SEED_TEST_EMAIL 与 SEED_TEST_PASSWORD 同时提供时创建/更新，幂等
# - 角色：默认 MEMBER；最高 ADMIN（SEED_TEST_ROLE=ADMIN 显式 opt-in）；SUPER_ADMIN 一律拒绝
SEED_TEST_EMAIL=test@example.com
SEED_TEST_PASSWORD=replace-with-strong-test-password
SEED_TEST_ROLE=MEMBER
