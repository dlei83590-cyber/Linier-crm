  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  snapshotType InvoiceSnapshotType
  revisionNo   Int
  snapshotData Json?    // 完整快照（Header + Lines + sourceDeliveryLineId 集合；金额 Decimal 字符串，禁止 toNumber）
  // CTO Review 必改②：税务/汇率快照（几年后汇率/税率/SST 注册状态都会变化，Snapshot 必须能 100% 还原）
  taxProfileId String?   // 税率档案快照（继承 SalesOrder.taxProfileId）
  taxRate      Decimal?  @db.Decimal(18, 4) // 税率快照
  sstNo        String?   // SST 注册号快照（销售与服务税登记号）
  currencyRate Decimal?  @db.Decimal(18, 8) // 汇率快照
  exchangeRate Decimal?  @db.Decimal(18, 8) // 汇率快照（与 currencyRate 同值冗余，兼容不同字段命名）
  // 增值税要素快照（ADR-0043：ISSUED 快照固化 invoiceType/taxInvoiceCode/taxInvoiceNo，I9 100% 还原）
  invoiceType     InvoiceInvoiceType?
  taxInvoiceCode  String?
  taxInvoiceNo    String?
  generatedById String?
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([invoiceId, snapshotType])
  @@index([invoiceId])
  @@index([deletedAt])
}

/// 应收状态（余额生命周期；OVERDUE 惰性判定，非数据库真实状态——CTO 拍板②：effectiveStatus Projection）
enum AccountsReceivableStatus {
  OPEN            // 未收款（余额 > 0 且未逾期）
  PARTIALLY_PAID  // 部分收款（0 < paidAmount < balance 且未逾期）
  PAID            // 已收清（balanceAmount = 0）
  OVERDUE         // 已逾期（惰性投影：OPEN/PARTIALLY_PAID + dueDate < now）
  CLOSED          // 已关闭（余额=0 且生命周期结束；与 OPEN/PAID 余额状态区分）
}

/// 应收快照类型（仅固化节点生成，只读）
enum AccountsReceivableSnapshotType {
  CREATED          // 创建时固化（ISSUED 后 AR 初始快照，snapshotSource=ISSUE）
  PARTIALLY_PAID   // 部分收款时固化（4E-2 回写，snapshotSource=PAYMENT）
  PAID             // 收清时固化（4E-2 回写，snapshotSource=PAYMENT）
  ADJUSTED         // 金额调整时固化（4E-3 CN/DN 聚合后，snapshotSource=ADJUSTMENT）
  WRITTEN_OFF      // 坏账核销时固化（4E-2，snapshotSource=WRITE_OFF）
  CLOSED           // 关闭时固化（snapshotSource=MANUAL/PAYMENT/WRITE_OFF）
}

/// 应收快照来源类型（CTO Review 必改②：Receipt/CN/DN/WriteOff 全部可复用）
enum AccountsReceivableSnapshotSource {
  ISSUE       // Invoice ISSUED 自动创建 AR 时
  PAYMENT     // 4E-2 Receipt 核销回写时
  WRITE_OFF   // 4E-2 WriteOff 回写时
  ADJUSTMENT  // 4E-3 CN/DN 聚合调整时
  MANUAL      // 手动关闭/人工调整时
}

/// 应收（余额事实源；Invoice 1:1；Invoice=单据事实源，AR=余额事实源，Invoice 上 paidAmount/balanceAmount 仅投影回写）
/// 余额唯一口径：balanceAmount = originalAmount + adjustedAmount - paidAmount - writeOffAmount（禁止前端 PATCH，服务端唯一计算）
model AccountsReceivable {
  id           String   @id @default(cuid())
  invoiceId    String   @unique // 1:1 绑定 Invoice（单据事实源）；Invoice 软删防御；有 AR 的发票禁止删除（CTO 必改③）
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId   String   // 客户（继承 Invoice.customerId；对账用）
  customer     BusinessPartner @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 币种（继承 Invoice.currency）

  // 余额计算四输入（CTO 锁定：前端禁止 PATCH 这些金额；由 4E-2 Receipt/WriteOff、4E-3 CN/DN 动作或下游事实表驱动）
  originalAmount Decimal @db.Decimal(18, 4) // 原始金额（= Invoice.invoiceTotal，AR 创建时复制，不重算）
  adjustedAmount Decimal @default(0) @db.Decimal(18, 4) // 调整金额（4E-3 CN/DN 聚合，可正可负）
  paidAmount     Decimal @default(0) @db.Decimal(18, 4) // 已收款（4E-2 Receipt 回写）
  writeOffAmount Decimal @default(0) @db.Decimal(18, 4) // 坏账核销金额（4E-2 WriteOff 回写）

  // 余额（唯一计算口径，禁止手工写）
  balanceAmount  Decimal @db.Decimal(18, 4) // = originalAmount + adjustedAmount - paidAmount - writeOffAmount

  // 状态与账龄
  status     AccountsReceivableStatus @default(OPEN)
  effectiveStatus AccountsReceivableStatus // 惰性投影（OVERDUE 判定；CTO 拍板②：Projection，非数据库状态）
  dueDate    DateTime? @db.Timestamptz(3) // 到期日（继承 Invoice.dueDate；逾期判定基准）
  lastPaymentAt DateTime? @db.Timestamptz(3) // 最近收款时间（4E-2 回写）
  // 注意：**不持久化 agingBucket**（CTO 必改①：effectiveAgingBucket 读取时动态计算 0-30/31-60/61-90/90+，只依赖 today/dueDate/balance，属 Projection，不每天更新数据库）

  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  revisions AccountsReceivableRevision[]
  snapshots AccountsReceivableSnapshot[]
  receiptAllocations ReceiptAllocation[] // 4E-2：核销事实（M:N Receipt ↔ AR）
  writeOffAllocations WriteOffAllocation[] // 4E-2：写销明细（WriteOff → AR）
  invoiceAdjustments InvoiceAdjustment[] // 4E-3：调整事实（InvoiceAdjustment.accountsReceivableId 方向）

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
}

/// 应收修订（余额变更留痕；系统生成，禁止手工编辑）
model AccountsReceivableRevision {
  id           String   @id @default(cuid())
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Cascade)
  revisionNo   Int
  changeReason String
  snapshotData Json?    // 当前余额状态快照（金额 Decimal 字符串，禁止 toNumber）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([accountsReceivableId, revisionNo])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}

/// 应收快照（关键节点固化；金额 Decimal 字符串；含 snapshotSource 来源类型——CTO 必改②）
model AccountsReceivableSnapshot {
  id           String   @id @default(cuid())
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Cascade)
  snapshotType AccountsReceivableSnapshotType
  snapshotSource AccountsReceivableSnapshotSource // CTO 必改②：来源枚举（ISSUE/PAYMENT/WRITE_OFF/ADJUSTMENT/MANUAL）
  revisionNo   Int
  snapshotData Json?    // 完整快照（Header + 四金额输入 + balanceAmount + customerId/currency/dueDate；Decimal 字符串）
  generatedById String?
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([accountsReceivableId, snapshotType])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}

// ============================================================
// Sprint 4E-2：Receipt & Payment Allocation（收款与核销领域）
// CTO Design Review 2026-08-08 97/100 APPROVED WITH CHANGES 拍板：
// ① 创建与核销分离（POST /api/receipts 只记录金额；allocate 显式动作且一次请求原子化）
// ② VOID 仅未核销；已核销逆向走 Allocation/Receipt Reversal 留痕；CN 属 4E-3 发票调整域不承担收款冲销
// ③ WriteOff = WriteOff + WriteOffAllocation（不做 Revision/Snapshot 三件套；审批历史 Workflow、审计 AuditLog）
// ④ Receipt/WriteOff 编号 DocumentSequence 创建即取号（REC-/WO-2026-xxxx，与 Invoice DRAFT 不占号语义不同）
// ⑤ unallocatedAmount 受控投影保留（预收/暂未指定发票场景）
// 硬规则：同 Customer + 同 Currency 才允许 Allocation（409；第一版禁止跨币种核销）
// 锁序（CTO 指定）：Lock Receipt → Lock AR rows(id ASC) → 校验客户/币种 → 校验 unallocated → 校验 ≤ AR.balanceAmount
//   → Create ReceiptAllocation → 回写 AR → 回写 Invoice 投影 → 回写 Receipt 投影 → AR 状态投影 → Snapshot/Audit → Events
// ============================================================

/// 收款状态（受控投影——拍板②：只能由 allocation/reversal/void 事务更新，禁止 PATCH；前三个可由金额动态推导）
enum ReceiptStatus {
  UNALLOCATED          // 未核销（unallocatedAmount = amount）
  PARTIALLY_ALLOCATED  // 部分核销（0 < allocatedAmount < amount）
  FULLY_ALLOCATED      // 全部核销（unallocatedAmount = 0）
  VOIDED               // 已作废（仅未核销可 VOID）
}

/// 收款方式
enum PaymentMethod {
  BANK_TRANSFER           // 银行转账
  CHEQUE                  // 支票
  CASH                    // 现金
  CARD                    // 刷卡
  OTHER                   // 其他
  BANK_ACCEPTANCE_BILL    // 银行承兑汇票（中国审计 P1，ADR-0046）
  COMMERCIAL_ACCEPTANCE_BILL // 商业承兑汇票（中国审计 P1，ADR-0046）
  TT_ELECTRONIC_TRANSFER  // 电汇 T/T（中国审计 P1，ADR-0046）
}

/// 收款快照类型（仅固化节点生成，只读）
enum ReceiptSnapshotType {
  CREATED  // 创建时固化
  ALLOCATED // 核销节点固化（部分/全额核销均触发）
  VOIDED   // 作废时固化
  REVERSED // Allocation/Receipt Reversal 时固化
}

/// 收款（收款事实源；Payment 不单独建表——CTO 拍板：避免两个重复入账事实）
/// 核心金额关系：amount = allocatedAmount + unallocatedAmount（后两者受控投影，禁止 PATCH）
/// 拍板④：code DocumentSequence 创建即取号（Receipt 是实际收款凭证，创建即财务事实）
model Receipt {
  id           String   @id @default(cuid())
  code         String   @unique // 收款单编号（REC-2026-xxxx，DocumentSequence 创建即取号）
  customerId   String   // 收款客户（核销目标 AR.customerId 必须一致——硬规则）
  customer     BusinessPartner @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 币种（核销目标 AR.currency 必须一致——硬规则，第一版禁止跨币种核销）
  amount       Decimal  @db.Decimal(18, 4) // 实收金额（收款事实）
  allocatedAmount   Decimal @default(0) @db.Decimal(18, 4) // 受控投影 = Σ ReceiptAllocation.allocatedAmount（非反向核销）
  unallocatedAmount Decimal @default(0) @db.Decimal(18, 4) // 受控投影 = amount - allocatedAmount（拍板⑤：预收/暂未指定发票）
  receiptDate  DateTime @db.Timestamptz(3) // 收款日期
  paymentMethod PaymentMethod // 收款方式
  referenceNo  String?  // 银行流水号/备注
  status       ReceiptStatus @default(UNALLOCATED) // 受控投影（事务更新，禁止 PATCH）
  voidedAt     DateTime? @db.Timestamptz(3)
  voidedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  allocations ReceiptAllocation[]
  revisions   ReceiptRevision[]
  snapshots   ReceiptSnapshot[]

  @@index([customerId])
  @@index([status])
  @@index([receiptDate])
  @@index([deletedAt])
}

/// 核销事实（M:N：一个 Receipt → 多 AR；一个 AR → 多 Receipt——CTO 锁定）
/// 允许同一 (receipt, AR) 多行：Reversal 后可重新分配（每行是一次核销/冲销事件，Σ 校验防超核销）
/// Allocation Reversal 留痕：reversedAt/reversedBy 非空即已冲销（4E-2 边界，CN 不承担收款冲销）
model ReceiptAllocation {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal @db.Decimal(18, 4) // 本次核销金额
  allocatedAt   DateTime @default(now()) @db.Timestamptz(3)
  allocatedBy   String?
  // Allocation Reversal 留痕（CTO Design Review 新锁定边界）
  reversedAt    DateTime? @db.Timestamptz(3)
  reversedBy    String?
  reverseReason String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([receiptId])
  @@index([accountsReceivableId])
  @@index([reversedAt])
  @@index([deletedAt])
}

/// 收款修订（头信息变更留痕；系统生成，禁止手工编辑）
model ReceiptRevision {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  revisionNo   Int
  changeReason String
  snapshotData Json?    // 头信息快照（金额 Decimal 字符串，禁止 toNumber）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([receiptId, revisionNo])
  @@index([receiptId])
  @@index([deletedAt])
}

/// 收款快照（关键节点固化：CREATED/ALLOCATED/VOIDED/REVERSED；金额 Decimal 字符串）
model ReceiptSnapshot {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  snapshotType ReceiptSnapshotType
  revisionNo   Int
  snapshotData Json?    // 完整快照（Header + amount/allocatedAmount/unallocatedAmount/status；Decimal 字符串）
  generatedById String?
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([receiptId])
  @@index([deletedAt])
}

/// 写销状态（审批边界：WriteOff 按 ApprovalPolicy 条件审批；审批完成前禁止改 AR.writeOffAmount）
enum WriteOffStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  APPLIED
}

/// 坏账/折让写销（独立事实实体——拍板③：不 PATCH AR.writeOffAmount，APPLIED 才回写）
/// 不做 Revision/Snapshot 三件套（拍板③：审批历史由 Workflow、审计由 AuditLog，避免模型膨胀）
/// 审批：approvalPolicyId 可空；有值 → 按 ApprovalPolicy 触发 Workflow（复用，不建 WriteOffApproval 表）
model WriteOff {
  id           String   @id @default(cuid())
  code         String   @unique // 写销单编号（WO-2026-xxxx，DocumentSequence 创建即取号）
  amount       Decimal  @db.Decimal(18, 4) // 写销总额（= Σ WriteOffAllocation.amount）
  reason       String   // 原因：坏账/折让/其他
  writeOffDate DateTime @db.Timestamptz(3)
  status       WriteOffStatus @default(DRAFT)
  approvalPolicyId String? // 条件审批（可空）
  // 审批投影（Workflow 唯一审批事实源；不建 WriteOffApproval 表）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  appliedAt     DateTime? @db.Timestamptz(3) // APPLIED 时才回写 AR（审批完成前禁止提前修改）
  appliedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  allocations WriteOffAllocation[]

  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 写销明细（WriteOff → AR；APPLIED 时按明细回写 AR.writeOffAmount + balanceAmount）
model WriteOffAllocation {
  id           String   @id @default(cuid())
  writeOffId   String
  writeOff     WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(18, 4)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([writeOffId, accountsReceivableId])
  @@index([writeOffId])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}

// ============================================================
// Sprint 4E-3：Credit Note / Debit Note（发票调整与应收调整领域）
// CTO Design Review 98/100 APPROVED WITH CHANGES（2026-08-08）：
// ① 单票制（sourceInvoiceId 必填且唯一；跨票 Consolidated Adjustment 延后）
// ② 负 AR 方案 A：允许 balanceAmount < 0（=Customer Credit/可退可抵）；**不新增数据库状态**
//    （AccountsReceivableStatus 不加 CREDIT；读取投影 isCreditBalance/creditAmount/effectiveBalanceType）
// ③ 条件审批：复用 ApprovalPolicy(module=CREDIT_DEBIT_NOTE)，不建 Approval 表
// ④ 部分行调整支持，但必须累计防超调（remainingAdjustableQty = original - cumulativeAppliedCreditQty）
// ⑤ 第一版禁止 DN 超原 Invoice 金额（行级 ceiling = 原行金额；未来 ADDITIONAL_CHARGE 单独 ADR）
// 符号口径（CTO 拍板）：CN → adjustmentAmount < 0；DN → adjustmentAmount > 0（signed Decimal，全系统唯一）
// 事实链：Invoice → CreditDebitNote → CreditDebitNoteLine → InvoiceAdjustment → AR.adjustedAmount → AR.balanceAmount
// 边界：不修改原 Invoice 金额事实（invoiceTotal/行快照/InvoiceSnapshot 不动）；不承担 Receipt/Allocation Reversal；
//       AR.adjustedAmount 聚合结果禁 PATCH（唯一入口 InvoiceAdjustment Apply）；APPROVED ≠ APPLIED
// 编号：DocumentSequence 创建即取号（CN-/DN-2026-xxxx；docType=CREDIT_NOTE/DEBIT_NOTE 已有）
// onDelete：CreditDebitNote→Invoice/Customer Restrict；CreditDebitNoteLine→Note Cascade、→InvoiceLine Restrict；
//           InvoiceAdjustment→Note/Line/Invoice/AR Restrict、→InvoiceLine SetNull（可空整票调整）
// ============================================================

/// 发票调整单类型（CTO 98/100 拍板：全系统唯一符号口径——CREDIT 负向、DEBIT 正向）
enum CreditDebitNoteType {
  CREDIT // 贷项通知单（负向调整 AR：adjustmentAmount < 0）
  DEBIT  // 借项通知单（正向调整 AR：adjustmentAmount > 0）
}

/// 发票调整单状态（单据生命周期；审批状态走 approvalStatus 投影复用 ApprovalStatus——不膨胀）
enum CreditDebitNoteStatus {
  DRAFT     // 草稿（可编辑行）
  SUBMITTED // 已提交（命中策略 → Workflow 审批 PENDING；未命中 → 可直接进入可 Apply 状态）
  APPLIED   // 已生效（唯一回写 AR.adjustedAmount 的入口；APPROVED ≠ APPLIED）
  CANCELLED // 已取消（未生效前可取消）
}

/// 发票调整单头（CN/DN；4E-3 发票调整域；不修改原 Invoice 金额事实）
model CreditDebitNote {
  id           String   @id @default(cuid())
  code         String   @unique // 调整单编号（CN-/DN-2026-xxxx，DocumentSequence 创建即取号）
  noteType     CreditDebitNoteType // CREDIT 负向 / DEBIT 正向
  sourceInvoiceId String // 单票制（CTO 拍板①：必填且唯一；跨票 Consolidated 延后）
  sourceInvoice Invoice @relation(fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  customerId   String   // 客户（继承 sourceInvoice.customerId）
  customer     BusinessPartner @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 币种（继承 sourceInvoice.currency）
  reason       String   // 调整原因（折让/退货/价差/更正/其他）
  adjustmentTotal Decimal @db.Decimal(18, 4) // 调整总额（= Σ lines；服务端计算，禁止直传头金额）
  status       CreditDebitNoteStatus @default(DRAFT)
  // 条件审批（CTO 拍板③：复用 ApprovalPolicy module=CREDIT_DEBIT_NOTE，不建 Approval 表）
  approvalPolicyId String?
  // 审批投影（Workflow 唯一审批事实源；复用 ApprovalStatus——不膨胀）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  appliedAt     DateTime? @db.Timestamptz(3) // APPLIED 才回写 AR（审批完成前禁止提前修改）
  appliedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines      CreditDebitNoteLine[]
  adjustments InvoiceAdjustment[]

  @@index([noteType])
  @@index([sourceInvoiceId])
  @@index([customerId])
  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 发票调整单明细（逐行溯源 sourceInvoiceLineId；金额快照直接复制 InvoiceLine——不重算、不调用 Pricing Engine）
model CreditDebitNoteLine {
  id           String   @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  sourceInvoiceLineId String // 溯源发票行（必填可追溯——CTO 锁死）
  sourceInvoiceLine InvoiceLine @relation(fields: [sourceInvoiceLineId], references: [id], onDelete: Restrict)
  lineNo       Int      @default(10) // 行号（10/20/30/40 步进）
  itemId       String?  // 物料（继承 InvoiceLine.itemId，可空）
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description  String   // 描述（快照复制）
  quantity     Decimal  @db.Decimal(18, 4) // 调整数量（>0；部分行数量调整——CTO 拍板④，累计防超调）
  uomId        String?  // 单位（继承 InvoiceLine.uomId）
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  // 金额快照（直接复制 InvoiceLine 快照，不重算）
  unitPrice    Decimal  @db.Decimal(18, 4) // 单价快照（复制）
  discountRate Decimal  @default(0) @db.Decimal(18, 4) // 折扣率快照（复制）
  lineAmount   Decimal  @db.Decimal(18, 4) // 行未税金额（复制计算值）
  taxAmount    Decimal  @db.Decimal(18, 4) // 行税额（复制）
  totalAmount  Decimal  @db.Decimal(18, 4) // 行含税金额（复制）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  adjustments InvoiceAdjustment[]

  @@unique([creditDebitNoteId, lineNo])
  @@index([creditDebitNoteId])
  @@index([sourceInvoiceLineId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 发票调整事实中间层（4E-3 最核心事实层——真正影响 AR.adjustedAmount 的唯一入口）
/// 类比：ReceiptAllocation（收款↔AR 中间层）/ WriteOffAllocation（写销↔AR 明细）
/// CTO 98/100：adjustmentAmount 必须采用有符号 Decimal（CN<0、DN>0）；全系统唯一符号口径
/// 双溯源：sourceNoteId/sourceNoteLineId（单据侧）+ invoiceId/invoiceLineId（发票侧）+ accountsReceivableId（AR 侧）
model InvoiceAdjustment {
  id           String   @id @default(cuid())
  sourceNoteId String
  sourceNote   CreditDebitNote @relation(fields: [sourceNoteId], references: [id], onDelete: Restrict)
  sourceNoteLineId String
  sourceNoteLine CreditDebitNoteLine @relation(fields: [sourceNoteLineId], references: [id], onDelete: Restrict)
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceLineId String? // 可空：整票调整（invoiceLineId 为空）
  invoiceLine  InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  customerId   String // 冗余（Apply 事务校验与 AR 一致）
  customer     BusinessPartner @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY")
  adjustmentType CreditDebitNoteType // CREDIT 负向 / DEBIT 正向
  quantity     Decimal  @db.Decimal(18, 4) // 调整数量（累计防超调用）
  adjustmentAmount Decimal @db.Decimal(18, 4) // **有符号调整金额：CN<0 / DN>0（CTO 98/100，全系统唯一符号口径）**
  appliedAt    DateTime? @db.Timestamptz(3) // Apply 回写时间（null = 未生效）
  appliedById  String?
  // reversal 预留（CTO：4E-3 首版不实现 reversal，字段预留）
  reversedAt   DateTime? @db.Timestamptz(3)
  reversedById String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([sourceNoteId, invoiceId, invoiceLineId]) // 防重复调整行（同一调整单对同一发票/行只一条事实）
  @@index([sourceNoteId])
  @@index([sourceNoteLineId])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 5A - Purchase Requisition & Purchase Order Foundation（采购域，CTO Design Review 97/100 APPROVED WITH CHANGES 2026-08-09）
// ============================================================================

/// 采购申请状态（PR 生命周期；审批状态走 approvalStatus 投影复用 ApprovalStatus——不膨胀）
enum PurchaseRequisitionStatus {
  DRAFT              // 草稿（创建后初始态，可编辑行）
  SUBMITTED          // 已提交审批（命中策略触发 Workflow）
  APPROVED           // 审批通过（投影；PR APPROVED 才能转 PO）
  CONVERTED          // 已转 PO（PR → PO 转单后投影，不改 PR 数量/金额事实）
  CANCELLED          // 已取消（DRAFT/SUBMITTED 可取消）
}

/// 采购订单状态（CTO 拍板调整③锁死：APPROVED ≠ CONFIRMED；只有 Confirmed PO 才是 5B GR 来源）
enum PurchaseOrderStatus {
  DRAFT              // 草稿（创建后初始态，可编辑行）
  SUBMITTED          // 已提交审批
  APPROVED           // 审批通过（内部批准投影）
  CONFIRMED          // 正式下单给供应商（确认动作；APPROVED → CONFIRMED）
  PARTIALLY_RECEIVED // 部分收货（5B GR 聚合投影）
  RECEIVED           // 已全部收货（5B GR 聚合投影）
  CANCELLED          // 已取消（DRAFT 可取消）
}

/// PO 快照类型（仅固化节点生成；含 CONFIRMED 定稿快照）
enum PurchaseOrderSnapshotType {
  CREATED
  SUBMITTED
  APPROVED
  CONFIRMED
  RECEIVED
  CANCELLED
}

/// PO 创建来源（CTO 拍板②：Direct Purchase 显式可审计）
enum PurchaseOrderSourceType {
  REQUISITION        // PR Convert（line 保留 sourcePurchaseRequisitionLineId）
  DIRECT             // 直接采购（来源字段为空；不能绕过 PO Approval）
}

/// PO 行价格来源（CTO 拍板③：双通道；MANUAL 必须记录 priceReason/priceSetById/priceSetAt）
enum PurchaseOrderPriceSource {
  SUPPLIER_PRICE_SNAPSHOT // Supplier 价格快照（PartnerPrice priceSource=SUPPLIER）复制，优先
  MANUAL                   // 授权手工录入（审计留痕）
}

/// 采购申请头（PR = 需求事实源：表达"需要什么、多少、何时要"，非供应商交互单据；**不带任何金额事实**——CTO 拍板⑤）
model PurchaseRequisition {
  id           String   @id @default(cuid())
  code         String   @unique // 单据编号（DocumentSequence docType=PURCHASE_REQUISITION，如 PR-2026-0001）
  requesterId  String?  // 申请人
  requester    User?    @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  departmentId String?  // 申请部门
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status       PurchaseRequisitionStatus @default(DRAFT)
  needDate     DateTime? @db.Timestamptz(3) // 期望需求日期
  remark       String?
  // 审批投影（Workflow 唯一事实源，仅查询投影）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines     PurchaseRequisitionLine[]
  revisions PurchaseRequisitionRevision[]
  purchaseOrders PurchaseOrder[] // 5A：PO（PurchaseOrder.requisitionId 方向；可空=Direct）

  @@index([code])
  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 采购申请行（纯需求；**无任何金额事实字段**——CTO 拍板⑤；suggestedUnitPrice 不带入）
model PurchaseRequisitionLine {
  id           String   @id @default(cuid())
  purchaseRequisitionId String
  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  lineNo       Int      @default(10) // 行号（10/20/30/40 步进）
  itemId       String?
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description  String   // 需求描述
  quantity     Decimal  @db.Decimal(18, 4) // 需求数量（正数；防超转由 5A convert 校验）
  uomId        String?
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  needDate     DateTime? @db.Timestamptz(3) // 行级需求日期
  remark       String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  purchaseOrderLines PurchaseOrderLine[] // 5A：PO 行溯源（sourcePurchaseRequisitionLineId；Direct 为空）

  @@unique([purchaseRequisitionId, lineNo])
  @@index([purchaseRequisitionId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 采购申请修订（PR 仅 Revision，**无 Snapshot**——CTO 拍板⑥；PR 无财务事实，快照价值低）
model PurchaseRequisitionRevision {
  id           String   @id @default(cuid())
  purchaseRequisitionId String
  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  revisionNo   Int      // 版本号（1,2,3...）
  changeReason String   // 变更原因
  snapshotData Json?    // 变更前快照（Header + Lines 集合）
  createdById  String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([purchaseRequisitionId, revisionNo])
  @@index([purchaseRequisitionId])
  @@index([deletedAt])
}

/// 采购订单头（PO = 采购承诺事实源；**sourceType=REQUISITION|DIRECT**（拍板②）；金额事实=服务端 Σ 行快照；**APPROVED ≠ CONFIRMED**）
model PurchaseOrder {
  id           String   @id @default(cuid())
  code         String   @unique // 单据编号（DocumentSequence docType=PURCHASE_ORDER，如 PO-2026-0001）
  sourceType   PurchaseOrderSourceType // REQUISITION | DIRECT（CTO 拍板②：Direct 显式可审计）
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaserId  String? // 采购员（CTO Phase 4B 指令：PO Header 落地，Direct 无 PR 时无法从 requester 推导）
  purchaser    User?    @relation(fields: [purchaserId], references: [id], onDelete: SetNull)
  departmentId String? // 采购部门（CTO Phase 4B 指令：PO Header 落地）
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  requisitionId String? // 溯源（REQUISITION 必填 / DIRECT 为空）
  requisition  PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime @default(now()) @db.Timestamptz(3) // 下单日期
  expectedDeliveryDate DateTime? @db.Timestamptz(3) // 期望交期
  currency     String   @default("CNY")
  paymentTerm  String?  // 付款条款（NET30/TT/LC...）
  subtotal     Decimal  @default(0) @db.Decimal(18, 4) // 未税合计（服务端 Σ 行，禁客户端直传）
  taxAmount    Decimal  @default(0) @db.Decimal(18, 4) // 税额
  totalAmount  Decimal  @default(0) @db.Decimal(18, 4) // 含税合计（服务端聚合）
  remark       String?
  // 审批投影（Workflow 唯一事实源）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  // CONFIRMED 投影（拍板③：APPROVED ≠ CONFIRMED；只有 Confirmed PO 才是 5B GR 来源）
  confirmedAt   DateTime? @db.Timestamptz(3)
  confirmedById String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines     PurchaseOrderLine[]
  revisions PurchaseOrderRevision[]
  snapshots PurchaseOrderSnapshot[]
  purchaseReceipts PurchaseReceipt[] // 5B：收货单（PurchaseReceipt.purchaseOrderId 方向）
  purchaseReturns PurchaseReturn[] // 5B：退货单（PurchaseReturn.purchaseOrderId 方向）

  @@index([code])
  @@index([supplierId])
  @@index([purchaserId])
  @@index([departmentId])
  @@index([requisitionId])
  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 采购订单行（价格双通道快照；PR Convert line 保留 sourcePurchaseRequisitionLineId；receivedQty/remainingReceiveQty 预留 5B 回写）
model PurchaseOrderLine {
  id           String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sourcePurchaseRequisitionLineId String? // PR 转 PO 保留；Direct 为空（CTO 拍板②）
  sourcePurchaseRequisitionLine PurchaseRequisitionLine? @relation(fields: [sourcePurchaseRequisitionLineId], references: [id], onDelete: SetNull)
  lineNo       Int      @default(10) // 行号（10/20/30/40 步进）
  itemId       String?
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description  String   // 描述（快照）
  quantity     Decimal  @db.Decimal(18, 4) // 采购数量
  uomId        String?
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  priceSource  PurchaseOrderPriceSource @default(SUPPLIER_PRICE_SNAPSHOT) // 双通道（CTO 拍板③）
  sourcePartnerPriceId String? // SUPPLIER_PRICE_SNAPSHOT 时引用供应商价格（可追溯）
  sourcePartnerPrice PartnerPrice? @relation(fields: [sourcePartnerPriceId], references: [id], onDelete: SetNull)
  unitPrice    Decimal  @db.Decimal(18, 4) // 单价快照（不重算、不调 Pricing Engine）
  // MANUAL 审计留痕（CTO 拍板③：Manual 必须记录 priceReason / actor / audit）
  priceReason  String?
  priceSetById String?
  priceSetAt   DateTime? @db.Timestamptz(3)
  discountRate Decimal  @default(0) @db.Decimal(18, 4)
  taxRate      Decimal  @db.Decimal(18, 4) // 税率快照（拍板④：税档变化不影响已 APPROVED PO）
  lineAmount   Decimal  @db.Decimal(18, 4) // 行未税金额
  taxAmount    Decimal  @db.Decimal(18, 4) // 行税额
  totalAmount  Decimal  @db.Decimal(18, 4) // 行含税金额
  // 收货投影（5B GR 聚合回写，只读；**5A 禁止客户端修改，5B 才是唯一回写方**——拍板调整③）
  receivedQty  Decimal  @default(0) @db.Decimal(18, 4) // 已收货量（5B 累计）
  remainingReceiveQty Decimal @db.Decimal(18, 4) // 剩余可收量 = quantity - receivedQty（创建时服务端初始化=quantity）
  // 履约类型（P4 Final：PO Line 预先声明；Confirm PO 时明确入仓还是直送）
  fulfillmentType PurchaseOrderFulfillmentType @default(WAREHOUSE)
  projectId String? // 直送项目（DIRECT_PROJECT 必填，预声明）
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // 超收容差 override（P2 Final：System Default = 0%；PO Line 可配置；null = 按 Supplier/Item/System 配置回退）
  overReceiptToleranceRate Decimal? @db.Decimal(8, 6) // Minor ①：0.050000 = 5%（rate 单位，非百分数整数；Schema/API/OpenAPI/QA 唯一单位定义）
  purchaseReceiptLines PurchaseReceiptLine[] // 5B：收货行（PurchaseReceiptLine.purchaseOrderLineId 方向）
  supplierInvoiceLines SupplierInvoiceLine[] // 5C-1：供应商发票行（SupplierInvoiceLine.purchaseOrderLineId 方向，RECEIPT_BASED 溯源）
  supplierInvoiceMatchLines SupplierInvoiceMatchLine[] // 5C-1：匹配 Run 行（SupplierInvoiceMatchLine.purchaseOrderLineId 方向）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
  @@index([sourcePurchaseRequisitionLineId])
  @@index([itemId])
  @@index([sourcePartnerPriceId])
  @@index([projectId])
  @@index([deletedAt])
}

/// 采购订单修订（系统生成，不开放自由编辑；财务/承诺字段变更触发重审——拍板⑦）
model PurchaseOrderRevision {
  id           String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  revisionNo   Int      // 版本号（1,2,3...）
  revisionStatus String  @default("DRAFT") // DRAFT/SUBMITTED/APPROVED/SUPERSEDED（简化：String，不建专属枚举）
  changeReason String   // 变更原因
  snapshotData Json?    // 变更前快照（Header + Lines 集合）
  createdById  String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([purchaseOrderId, revisionNo])
  @@index([purchaseOrderId])
  @@index([deletedAt])
}

/// 采购订单快照（仅固化节点生成，只读；金额统一 Decimal 字符串保存，禁止 toNumber()）
model PurchaseOrderSnapshot {
  id           String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  snapshotType PurchaseOrderSnapshotType
  revisionNo   Int      // 快照对应的修订号
  snapshotData Json?    // 完整快照（Header + Lines + 价格来源 priceSource/sourcePartnerPriceId）
  generatedById String?
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([purchaseOrderId, snapshotType, revisionNo])
  @@index([purchaseOrderId])
  @@index([deletedAt])
}

// ============================================================
// Sprint 5B：采购收货与入库（Goods Receipt Inbound）
// 事实链：PO CONFIRMED → PurchaseReceipt（到货/收货现场事实）→ Inspection（QC 唯一事实源）
//        → WarehouseReceipt（采购入库事实）→ 6A InventoryMovement(IN)（库存唯一事实源）
// 红线：5B 永不直接写库存余额；Stock/InventoryMovement/InventoryBalance 属 6A；
//       Supplier Invoice/AP/三单匹配 属 5C；直送（DIRECT_PROJECT）不入库、无 InventoryMovement(IN)
// 设计依据：ADR-0024（Approved with Changes）、Sprint5B Field Matrix / Gate / Pending Decisions（P1-P10 Final）
// ============================================================

/// 履约类型（P4 Final：PO Line 预先声明；Confirm PO 时明确入仓还是直送）
enum PurchaseOrderFulfillmentType {
  WAREHOUSE // 采购入仓
  DIRECT_PROJECT // 供应商直送项目现场（不入库、无 InventoryMovement(IN)）
}

/// 收货单状态（P1b Final：普通收货是事实记录，不走审批；超收/特殊退货才走 Workflow）
enum PurchaseReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

/// 检验模式（P3 Final：SKIP/SPOT/FULL；免检 = SKIP + QUALIFIED，不绕过 Inspection）
enum InspectionMode {
  SKIP
  SPOT
  FULL
}

/// 检验结论（P3 Final）
enum InspectionResult {
  QUALIFIED
  PARTIAL
  REJECTED
  PENDING // 待检 = 未获得入库资格
}

/// 入库单状态（D10：Created ≠ Posted；只有 POSTED 才触发 6A InventoryMovement(IN)）
enum WarehouseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// 退货类型（P5 Final）
enum PurchaseReturnType {
  REJECTED_ON_RECEIPT // 收货拒收
  RETURN_AFTER_STOCK_IN // 入库后退货
  QUALITY_ISSUE // 质量问题
}

/// 退货单状态（P1b Final：普通退货不审批；特殊退货走 Workflow）
enum PurchaseReturnStatus {
  DRAFT
  RETURNED
  CANCELLED
}

/// 退货来源引用类型（P5 Final：必须有来源）
enum PurchaseReturnSourceType {
  RECEIPT_LINE
  WAREHOUSE_RECEIPT_LINE
  INSPECTION
}

/// 退货履约处置（P5 Final / Blocking ②：防止 PO/退货/AP 互相打架）
enum PurchaseReturnDisposition {
  REPLACE_REQUIRED // 供应商仍欠货，重新增加履约剩余待交数量
  CREDIT_ONLY // 采购数量最终减少/财务冲减，PO 不一定重新待收
}

/// 仓库（5B 建最小主数据，P8 Final；库存能力扩展属 6A）
model Warehouse {
  id       String   @id @default(cuid())
  code     String   @unique // 仓库编码
  name     String // 仓库名称
  type     String? // 仓库类型
  address  String?
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  locations WarehouseLocation[]
  purchaseReceipts PurchaseReceipt[] // 到货地点方向（PurchaseReceipt.warehouseId）
  warehouseReceipts WarehouseReceipt[] // 入库仓库方向（WarehouseReceipt.warehouseId）
  productionInbounds ProductionInbound[] // 生产入库仓库方向（ProductionInbound.warehouseId）
  inventoryMovements InventoryMovement[] // 6A：库存流水（InventoryMovement.warehouse 方向）
  stockProjections StockProjection[] // 6A：库存投影（StockProjection.warehouse 方向）
  transferSources InventoryTransfer[] @relation("TransferSourceWarehouse") // 6B：调拨单源仓（InventoryTransfer.sourceWarehouse 方向）
  transferDestinations InventoryTransfer[] @relation("TransferDestinationWarehouse") // 6B：调拨单目标仓（InventoryTransfer.destinationWarehouse 方向）
  stockCountLines StockCountLine[] // 6B：盘点行（StockCountLine.warehouse 方向）
  adjustmentLines InventoryAdjustmentLine[] // 6B：调整行（InventoryAdjustmentLine.warehouse 方向）
  conversionLines InventoryConversionLine[] // 6B：转换行（InventoryConversionLine.warehouse 方向）

  @@index([code])
  @@index([deletedAt])
}

/// 库位（5B 建最小主数据，P8 Final）
model WarehouseLocation {
  id         String   @id @default(cuid())
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code       String // 库位编码
  name       String
  isActive   Boolean  @default(true)
  createdById String?
  updatedById String?
  version    Int      @default(1)
  deletedAt  DateTime?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  warehouseReceipts WarehouseReceipt[] // 入库单库位方向（WarehouseReceipt.locationId，可空）
  inventoryMovements InventoryMovement[] // 6A：库存流水（InventoryMovement.location 方向）
  stockProjections StockProjection[] // 6A：库存投影（StockProjection.location 方向）
  transferSourceLocations InventoryTransfer[] @relation("TransferSourceLocation") // 6B：调拨单源库位（InventoryTransfer.sourceLocation 方向）
  transferDestinationLocations InventoryTransfer[] @relation("TransferDestinationLocation") // 6B：调拨单目标库位（InventoryTransfer.destinationLocation 方向）
  stockCountLines StockCountLine[] // 6B：盘点行（StockCountLine.location 方向）
  adjustmentLines InventoryAdjustmentLine[] // 6B：调整行（InventoryAdjustmentLine.location 方向）
  conversionLines InventoryConversionLine[] // 6B：转换行（InventoryConversionLine.location 方向）

  @@unique([warehouseId, code])
  @@unique([id, warehouseId]) // 支持 WarehouseReceipt 组合 FK（Minor ②：location 必须属于同一 warehouse）
  @@index([warehouseId])
  @@index([deletedAt])
}

/// 收货单（到货/收货现场事实；Blocking ③：只保留现场事实，不承载 QC）
model PurchaseReceipt {
  id       String   @id @default(cuid())
  code     String   @unique // 收货单号（DocumentSequence docType=PURCHASE_RECEIPT，前缀 REC/GRN-）
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierId String // 供应商快照自 PO（不单独校验）
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId String? // 公司仓库到货地点，仅 WAREHOUSE 收货场景使用（Blocking ①：DIRECT_PROJECT 直送不使用 warehouse）
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  status   PurchaseReceiptStatus @default(DRAFT)
  receivedAt DateTime? @db.Timestamptz(3)
  receivedById String?
  receivedBy User? @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines PurchaseReceiptLine[]
  warehouseReceipts WarehouseReceipt[]

  @@index([code])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([deletedAt])
}

/// 收货行（Blocking ③：只保留收货现场事实；质量判定统一归 Inspection）
model PurchaseReceiptLine {
  id       String   @id @default(cuid())
  purchaseReceiptId String
  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String // 行级溯源
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  lineNo   Int      @default(10)
  itemId   String?
  item     Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Decimal  @db.Decimal(18, 4) // 物理到货数量（arrivedQty；可 <、=、> PO 订购量，超收见容差）
  uomId    String?
  uom      UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  visibleDamageQty Decimal @default(0) @db.Decimal(18, 4) // 收货现场可见损坏
  rejectedOnReceiptQty Decimal @default(0) @db.Decimal(18, 4) // 现场即拒收（不计入 PO receivedQty）
  // 直送执行补充（P4 Final：PO Line 已声明 DIRECT_PROJECT；此处只记录实际执行结果）
  deliveryAddress String? // 直送地址 / site
  receiver String? // 现场接收人
  proof    String? // 签收证明 / attachment reference
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  inspections Inspection[]
  warehouseReceiptLines WarehouseReceiptLine[]
  purchaseReturnLines PurchaseReturnLine[] // 反向：退货行来源（Blocking ③）

  @@unique([purchaseReceiptId, lineNo])
  @@index([purchaseReceiptId])
  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 检验（QC 唯一事实源，Blocking ③ / P3 Final；免检 = SKIP + QUALIFIED，不绕过 Inspection）
model Inspection {
  id       String   @id @default(cuid())
  purchaseReceiptLineId String @unique // CTO #7115 Blocking：一个 PurchaseReceiptLine 只有一个最终 Inspection（业务不变量落数据库，并发 Create 由 DB unique 拒绝）
  purchaseReceiptLine PurchaseReceiptLine @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: Cascade)
  inspectionMode InspectionMode // SKIP/SPOT/FULL
  result   InspectionResult @default(PENDING)
  qualifiedQty Decimal @default(0) @db.Decimal(18, 4) // 合格数量（合格入库 ceiling）
  rejectedQty Decimal @default(0) @db.Decimal(18, 4) // 拒收数量（→ PurchaseReturn）
  inspectedById String?
  inspectedBy User? @relation(fields: [inspectedById], references: [id], onDelete: SetNull)
  inspectedAt DateTime? @db.Timestamptz(3)
  remark   String?
  warehouseReceiptLines WarehouseReceiptLine[] // 反向：入库行引用（Blocking ②）
  purchaseReturnLines PurchaseReturnLine[] // 反向：退货行来源（Blocking ③）
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, purchaseReceiptLineId]) // Schema Integrity B①：支持 WarehouseReceiptLine 组合 FK（Inspection 必须属于同一收货行）
  @@index([purchaseReceiptLineId])
  @@index([inspectedById])
  @@index([deletedAt])
}

/// 入库单（采购入库事实；D10：Created ≠ Posted，只有 POSTED 才触发 6A InventoryMovement(IN)）
model WarehouseReceipt {
  id       String   @id @default(cuid())
  code     String   @unique // 入库单号（DocumentSequence docType=WAREHOUSE_RECEIPT，前缀 IN/WHR-）
  purchaseReceiptId String
  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  warehouseId String // 入库仓库（必填）
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId String? // 库位（可空；Minor ②：组合 FK 保证 location 属于同一 warehouse）
  location  WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // Schema Integrity B②：组合 FK 用 Restrict（SET NULL 会尝试置空 NOT NULL warehouseId）
  status   WarehouseReceiptStatus @default(DRAFT)
  postedAt DateTime? @db.Timestamptz(3) // 过账时间（D10：Created ≠ Posted，只有 POSTED 触发 InventoryMovement(IN)）
  postedById String?
  postedBy User? @relation("WarehouseReceiptPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines WarehouseReceiptLine[]

  @@index([code])
  @@index([purchaseReceiptId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([status])
  @@index([deletedAt])
}

/// 入库行（P6 Final：批次/序列号/效期 canonical capture point = 入库层采集）
model WarehouseReceiptLine {
  id       String   @id @default(cuid())
  warehouseReceiptId String
  warehouseReceipt WarehouseReceipt @relation(fields: [warehouseReceiptId], references: [id], onDelete: Cascade)
  purchaseReceiptLineId String // 溯源收货行
  purchaseReceiptLine PurchaseReceiptLine @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: Restrict)
  inspectionId String // 质量结论引用（Blocking ②：入库必须来自已完成、具有合格数量的 Inspection；累计 posted qty ≤ qualifiedQty；Schema Integrity B①：组合 FK 保证 Inspection 属于同一收货行）
  inspection Inspection @relation(fields: [inspectionId, purchaseReceiptLineId], references: [id, purchaseReceiptLineId], onDelete: Restrict)
  itemId   String?
  item     Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Decimal  @db.Decimal(18, 4) // 入库数量（≤ 合格数量，逐层 ceiling）
  uomId    String?
  uom      UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  batchNo  String? // 批次号（P6 Final）
  serialNos String[] @default([]) // 序列号列表（P6 Final）
  mfgDate  DateTime? @db.Date // 生产日期（P6 Final）
  expDate  DateTime? @db.Date // 有效期至（P6 Final）
  remark   String?
  purchaseReturnLines PurchaseReturnLine[] // 反向：退货行来源（Blocking ③）
  supplierInvoiceLines SupplierInvoiceLine[] // 5C-1：供应商发票行（SupplierInvoiceLine.warehouseReceiptLineId 方向，POSTED WHR 溯源）
  supplierInvoiceMatchLines SupplierInvoiceMatchLine[] // 5C-1：匹配 Run 行（SupplierInvoiceMatchLine.warehouseReceiptLineId 方向）
  grirAccruals GrirRecord[] // 5C-1：GRIR accrual 源（WHR Posted → ACCRUAL）
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([warehouseReceiptId])
  @@index([purchaseReceiptLineId])
  @@index([inspectionId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 退货单（采购退货独立事实，P5 Final：非负 GR；必须有来源 + disposition）
model PurchaseReturn {
  id       String   @id @default(cuid())
  code     String   @unique // 退货单号（DocumentSequence docType=PURCHASE_RETURN，前缀 PRT-）
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierId String // 供应商快照自 PO
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  returnType PurchaseReturnType // REJECTED_ON_RECEIPT / RETURN_AFTER_STOCK_IN / QUALITY_ISSUE
  status   PurchaseReturnStatus @default(DRAFT)
  returnedAt DateTime? @db.Timestamptz(3)
  returnedById String?
  returnedBy User? @relation(fields: [returnedById], references: [id], onDelete: SetNull)
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines PurchaseReturnLine[]

  @@index([code])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([deletedAt])
}

/// 退货行（P5 Final：必须有来源——三个真实 FK 之一非空且与 sourceRefType 匹配，exactly-one 由 API+QA 强制；disposition 必填）
model PurchaseReturnLine {
  id       String   @id @default(cuid())
  purchaseReturnId String
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  sourceRefType PurchaseReturnSourceType // RECEIPT_LINE / WAREHOUSE_RECEIPT_LINE / INSPECTION（业务类型，与 exactly-one FK 匹配）
  sourcePurchaseReceiptLineId String? // Blocking ③：三个真实 FK 之一，exactly-one 非空且与 sourceRefType 匹配（API+QA 强制）
  sourcePurchaseReceiptLine PurchaseReceiptLine? @relation(fields: [sourcePurchaseReceiptLineId], references: [id], onDelete: Restrict) // Schema Integrity B②：来源已成为退货事实则不得物理删除
  sourceWarehouseReceiptLineId String?
  sourceWarehouseReceiptLine WarehouseReceiptLine? @relation(fields: [sourceWarehouseReceiptLineId], references: [id], onDelete: Restrict)
  grirReversals GrirRecord[] // 5C-1：GRIR reversal 源（WHR-based PurchaseReturned → REVERSAL）
  sourceInspectionId String?
  sourceInspection Inspection? @relation(fields: [sourceInspectionId], references: [id], onDelete: Restrict)
  itemId   String?
  item     Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Decimal  @db.Decimal(18, 4) // 退货数量（> 0，≤ 可退数量防超退）
  uomId    String?
  uom      UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  batchNo  String? // 批次（已入库退货追溯，可空）
  serialNos String[] @default([]) // 序列号（已入库退货追溯，可空）
  disposition PurchaseReturnDisposition // REPLACE_REQUIRED / CREDIT_ONLY（必填）
  returnReason String // 退货原因（必填）
  remark   String?
  isActive Boolean  @default(true)
  createdById String?
  updatedById String?
  version  Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([purchaseReturnId])
  @@index([sourcePurchaseReceiptLineId])
  @@index([sourceWarehouseReceiptLineId])
  @@index([sourceInspectionId])
  @@index([itemId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 6A — Inventory Ledger（库存数量唯一事实源，CTO 6A Gate Re-review 97/100 APPROVED FOR SCHEMA DESIGN #7446）
// 红线：InventoryMovement = 库存数量唯一业务事实；Stock/OnHandQty 只能投影；业务模块不得直接创建 Movement
// （必须走 Inventory Ledger command 层，sourceType+sourceId+sourceLineId+movementRole+movementAtomKey 五元幂等键）
// P1-P10 Final：Outbox / 创建即 COMMITTED / ReservedQty 不进 / Costing 不进（无 costSnapshot）/
// 只建 Ledger+Projection+Outbox（Transfer/Conversion/Count 只锁规则）/ 禁负库存 / 物化同事务+reconciliation /
// 平台级持久 Outbox / 精确 OUT / InventoryMovementCommitted 保留
// ============================================================================

/// 库存流水状态（P2 Final：创建即 COMMITTED；6A 第一版无 PENDING——需要暂存的是业务单据，不是 Ledger）
enum InventoryMovementStatus {
  COMMITTED
}

/// 业务来源类型（5B 两个来源 + 纠错身份；新增来源须 CTO 批准 + ALTER TYPE ADD VALUE）
enum InventoryMovementSourceType {
  WAREHOUSE_RECEIPT_POSTED // WarehouseReceiptPosted（status=POSTED）→ IN
  PURCHASE_RETURN_RETURNED // PurchaseReturned（仅 WAREHOUSE_RECEIPT_LINE 来源行）→ OUT；未入库退货无 Movement
  TRANSFER // 6B：调拨（SOURCE_OUT + DESTINATION_IN 双边，同一 movementGroupId，同步共享 Ledger Command）
  ADJUSTMENT // 6B：库存调整（Count 差异 / Manual，经共享 Ledger Command；Count 经 sourceStockCountLineId 追溯，不新增 STOCK_COUNT sourceType）
  CONVERSION // 6B：同 item Repack / UOM Conversion（CONSUME + PRODUCE，同一 movementGroupId）
  REVERSAL // 纠错：冲销（拥有自己的 source/action identity，不与原 Movement 共用幂等身份）
  CORRECTION // 纠错：修正（同上）
}

/// 来源行内角色（CTO #7458 Blocking ①：一个 source line 可合法产生多笔 Movement，用 movementRole 区分）
enum InventoryMovementRole {
  IN
  OUT
  SOURCE_OUT // Transfer 成对：SOURCE OUT（未来）
  DESTINATION_IN // Transfer 成对：DESTINATION IN（未来）
  CONSUME // Conversion Consume（未来）
  PRODUCE // Conversion Produce（未来）
  ADJUSTMENT // Stock Count 盘盈/盘亏 / 调整（未来）
  REVERSAL
  CORRECTION
}

/// 库存增减方向
enum InventoryMovementDirection {
  IN
  OUT
}

/// 库存流水细分类型
enum InventoryMovementType {
  INBOUND
  OUTBOUND
  TRANSFER_OUT // 未来
  TRANSFER_IN // 未来
  CONSUME // 未来
  PRODUCE // 未来
  ADJUSTMENT // 未来
  REVERSAL
  CORRECTION
}

/// Outbox 状态（P8 Final：语义 = 库存消费成功才确认完成；不混"投递/消费/投影"）
enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

/// Sprint 6B：调拨单状态（P2 Final：DRAFT→SUBMITTED→APPROVED→EXECUTED/CANCELLED；EXECUTED 才触发双边 Movement）
enum InventoryTransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  EXECUTED
  CANCELLED
}

/// Sprint 6B：调拨类型（P3 Final：跨仓/同仓库位移动统一模型，transferType 区分）
enum InventoryTransferType {
  INTER_WAREHOUSE
  INTRA_WAREHOUSE
}

/// Sprint 6B：盘点单状态（Count 是实盘事实——不直接产生 Movement；差异经 Adjustment Command）
enum StockCountStatus {
  DRAFT
  COUNTING
  COMPLETED
  ADJUSTED // 差异已生成 Adjustment
  CANCELLED
}

/// Sprint 6B：盘点冻结策略（P6 Final：动态盘点——per-line atomic snapshot，不冻结维度）
enum StockCountFreezeStrategy {
  DYNAMIC
}

/// Sprint 6B：库存调整单状态（P9 Final：maker-checker——创建人与批准/Apply 人不得相同；APPLIED 只有 Ledger 成功后）
enum InventoryAdjustmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  APPLIED
  CANCELLED
}

/// Sprint 6B：库存转换单状态（同 item Repack / UOM Conversion）
enum InventoryConversionStatus {
  DRAFT
  SUBMITTED
  EXECUTED
  CANCELLED
}

/// Sprint 6B：转换行角色（CONSUME 消耗输入 / PRODUCE 产出输出）
enum InventoryConversionLineRole {
  CONSUME
  PRODUCE
}

/// 库存数量唯一事实源（单层原子事实；**一行 = 一个不可变库存原子事实**，无 Header/Line 两层——CTO #7458）
/// 历史不可变（D5）：COMMITTED 后禁止 UPDATE / DELETE（数据库层约束 + API 层无此能力）；纠错只能追加 Reversal/Correction
/// P7 Final：Movement 与 StockProjection 同事务更新；Reconciliation 对账 SUM(COMMITTED Movement) vs onHandQty
/// CTO #7469 Schema Review Blocking ①：幂等 identity = sourceType+sourceId+sourceLineId+movementRole+**movementAtomKey**
/// （一个 source line 可合法产生多笔原子 Movement——serial-managed 每 serial 一条；movementAtomKey 非 serial = "BULK"、serial = serialNo）
model InventoryMovement {
  id             String   @id @default(cuid())
  movementNo     String   @unique // 流水号（DocumentSequence docType=INVENTORY_MOVEMENT，前缀 MV-）
  sourceType     InventoryMovementSourceType
  sourceId       String // 来源单据 id（如 WarehouseReceipt.id / PurchaseReturn.id）
  sourceLineId   String // 来源行 id（如 WarehouseReceiptLine.id / PurchaseReturnLine.id）
  movementRole   InventoryMovementRole // CTO #7458：幂等键组成部分
  movementAtomKey String @default("BULK") // CTO #7469 Blocking ①：原子子键（非 serial = "BULK"；serial = serialNo；未来 Transfer/Conversion 多原子同 role 区分）
  // DB invariant（CTO #7495 Final Re-check）：serialNo 非空 ⇒ movementAtomKey 必须 = serialNo（CHECK "InventoryMovement_serial_atom_key_check"）
  // 不做“serialNo IS NULL → movementAtomKey = BULK”——未来非 serial 的 Transfer/Conversion 可能需要多个 atom key
  movementGroupId String? // 编组（Transfer/Conversion 多笔 Movement，可选；替代 Header/Line 两层）
  direction      InventoryMovementDirection
  status         InventoryMovementStatus @default(COMMITTED) // P2 Final：创建即 COMMITTED
  movementType   InventoryMovementType
  reversalOfMovementId String? @unique // Minor ②：一笔 Movement 最多被完整冲销一次（单次 Reversal 语义，CTO #7469）
  reversalOf     InventoryMovement? @relation("MovementReversal", fields: [reversalOfMovementId], references: [id], onDelete: Restrict)
  reversedBy     InventoryMovement[] @relation("MovementReversal")
  correctionOfMovementId String?
  correctionOf   InventoryMovement? @relation("MovementCorrection", fields: [correctionOfMovementId], references: [id], onDelete: Restrict)
  correctedBy    InventoryMovement[] @relation("MovementCorrection")
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId     String?
  location       WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于同一 warehouse
  itemId         String
  item           Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchNo        String? // 继承 5B WarehouseReceipt（P6 Final），不重建
  serialNo       String? // 单值（serial-managed 原子化：每 serial 独立 Movement、quantity=1；CTO #7458 Blocking ②）
  mfgDate        DateTime? @db.Timestamptz(3) // 继承 5B
  expDate        DateTime? @db.Timestamptz(3) // 继承 5B
  quantity       Decimal  @db.Decimal(18, 4) // IN/OUT 均为正数（方向承载正负语义）；serial-managed 必须 = 1（CHECK）
  uomId          String?
  uom            UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)
  referenceNo    String? // 业务单据号（冗余可读）
  remark         String?
  committedAt    DateTime @default(now()) @db.Timestamptz(3) // Minor ①：创建即 COMMITTED，NOT NULL（生效点必有时间戳）
  committedById  String?
  committedBy    User? @relation("InventoryMovementCommittedBy", fields: [committedById], references: [id], onDelete: SetNull)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // 五元幂等唯一（CTO #7458 + #7469）：sourceType+sourceId+sourceLineId+movementRole+movementAtomKey
  // Reversal/Correction 拥有自己的 source/action identity（sourceType=REVERSAL/CORRECTION），不与原 Movement 共用
  @@unique([sourceType, sourceId, sourceLineId, movementRole, movementAtomKey])
  @@index([movementGroupId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([itemId])
  @@index([batchNo])
  @@index([serialNo])
  @@index([committedAt])
  @@index([correctionOfMovementId])
}

/// 物化库存投影（**不是事实**；P7 Final：与 Movement 同事务 UPSERT + reconciliation）
/// P3 Final：无 availableQty / reservedQty（ReservedQty 不进入 6A）
/// P6 Final：禁止负库存——command 层锁本行后判断 onHandQty >= outQty（DB 层 CHECK onHandQty >= 0 兜底，CTO #7469 Blocking ③）
/// CTO #7469 Blocking ②：库存维度唯一性**由数据库直接表达**（PG 16 `UNIQUE NULLS NOT DISTINCT` 五维约束，见 Migration 0025）——
/// dimensionKey 仅作查询/锁键，**不承担唯一防线**（禁止空字符串与 NULL 混淆，CHECK dimensionKey <> ''）
model StockProjection {
  id           String   @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId   String?
  location     WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK 同属
  itemId       String
  item         Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchNo      String?
  serialNo     String?
  dimensionKey String // 查询/锁键（command 层生成，NULL 归一为占位符）；**非唯一防线**（CTO #7469 Blocking ②）
  onHandQty    Decimal  @default(0) @db.Decimal(18, 4) // = Σ IN - Σ OUT（COMMITTED Movement 聚合；与 Movement 同事务 UPSERT）
  lastMovementAt DateTime? @db.Timestamptz(3)
  version      Int      @default(1) // 乐观锁（command 层锁行判断负库存）
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([warehouseId])
  @@index([itemId])
  @@index([serialNo])
  @@index([dimensionKey])
}

/// 平台级持久 Transactional Outbox（P1/P8 Final：业务事实 + Outbox 同事务落库 → Inventory consumer 幂等消费）
/// P8 Final：PENDING → PROCESSING → PROCESSED；失败 PROCESSING → PENDING(retry) 或超阈值 → DEAD_LETTER；
/// 带 lease/retry 元数据；**处理成功不删除（保留审计记录）**
model OutboxMessage {
  id            String    @id @default(cuid())
  eventType     String // WarehouseReceiptPosted / PurchaseReturned / InventoryMovementCommitted / 未来各业务事件
  aggregateType String? // 如 WarehouseReceipt / PurchaseReturn
  aggregateId   String
  payload       Json? // 事件载荷（对齐 EVENTS.md；不含库存余额）
  idempotencyKey String  @unique // = sourceType|sourceId|sourceLineId|movementRole|movementAtomKey（与 Movement 五元幂等键一致，CTO #7469）
  status        OutboxStatus @default(PENDING)
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  lockedAt      DateTime? @db.Timestamptz(3) // lease
  lockedBy      String? // lease
  lastError     String?
  processedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt]) // 消费扫描 + retry 调度
  @@index([createdAt])
}

// ============================================================================
// Sprint 6B：Inventory Operations 业务事实层（Schema Design，CTO #8014 APPROVED FOR SCHEMA DESIGN）
// 红线：Operations 业务事实层只承载"业务单据事实"；库存账仍只以 InventoryMovement 呈现（6A SSOT）
// 业务 API 不得直接 INSERT InventoryMovement / UPDATE StockProjection——必须经共享 Ledger Command（同步）或 Outbox + Consumer（异步）
// 6B 实现前置（P12 Final）：抽取共享 InventoryLedgerCommand core，6A Consumer 与 6B 同步 Operations 共用同一底层
// ============================================================================

/// Sprint 6B：调拨单头（业务事实——双边 Movement 在 EXECUTE 时生成；DRAFT/SUBMITTED/APPROVED 不落账）
/// CTO Schema 问题①：movementGroupId 不在 DRAFT 创建时生成——只在 EXECUTE 时生成并冻结；Schema 可空，执行后必有
/// CTO Schema 问题②：防自调拨——跨仓 sourceWarehouseId 与 destinationWarehouseId 不同；同仓必须 location 不同（Schema CHECK + service invariant 锁死五维）
model InventoryTransfer {
  id            String   @id @default(cuid())
  transferNo    String   @unique // 调拨单号（DocumentSequence docType=INVENTORY_TRANSFER，前缀 TRF）
  status        InventoryTransferStatus @default(DRAFT)
  transferType  InventoryTransferType @default(INTER_WAREHOUSE) // P3 Final：跨仓/同仓统一模型，transferType 区分
  sourceWarehouseId String
  sourceWarehouse   Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  sourceLocationId  String?
  sourceLocation    WarehouseLocation? @relation("TransferSourceLocation", fields: [sourceLocationId, sourceWarehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于 source warehouse
  destinationWarehouseId String
  destinationWarehouse   Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  destinationLocationId  String?
  destinationLocation    WarehouseLocation? @relation("TransferDestinationLocation", fields: [destinationLocationId, destinationWarehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于 destination warehouse
  movementGroupId String? // CTO Schema 问题①：EXECUTE 时生成并冻结（双边 SOURCE_OUT + DESTINATION_IN 共享）；DRAFT 可空
  approvedById  String?
  approvedBy    User? @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  executedAt    DateTime? @db.Timestamptz(3) // CTO Schema 问题⑥：Ledger 双边成功后写入（EXECUTED 才有）
  executedById  String?
  executedBy    User? @relation("TransferExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  lines InventoryTransferLine[]

  @@index([transferNo])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([movementGroupId])
  @@index([deletedAt])
}

/// Sprint 6B：调拨单行（每行 → SOURCE_OUT + DESTINATION_IN 一对 Movement，同一 movementGroupId）
model InventoryTransferLine {
  id            String   @id @default(cuid())
  transferHeaderId String
  transferHeader   InventoryTransfer @relation(fields: [transferHeaderId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  uomId         String?
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  quantity      Decimal  @db.Decimal(18, 4) // 双边 quantity 相等（守恒）
  batchNo       String? // P5 Final：batch 精确继承
  serialNos     String[] @default([]) // serial-managed：每 serial 一对 Movement（serial 精确继承不重生成）
  mfgDate       DateTime? @db.Date
  expDate       DateTime? @db.Date
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([transferHeaderId])
  @@index([itemId])
  @@index([deletedAt])
}

/// Sprint 6B：盘点单头（实盘事实——本身不产生 Movement；差异经 Adjustment Command → InventoryMovement(ADJUSTMENT)）
/// 严禁 StockCount → UPDATE StockProjection（跳过 Movement 的直接改投影）
model StockCount {
  id            String   @id @default(cuid())
  countNo       String   @unique // 盘点单号（DocumentSequence docType=STOCK_COUNT，前缀 CNT）
  status        StockCountStatus @default(DRAFT)
  freezeStrategy StockCountFreezeStrategy @default(DYNAMIC) // P6 Final：动态盘点（不冻结维度）
  countedById   String?
  countedBy     User? @relation("StockCountCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  completedAt   DateTime? @db.Timestamptz(3)
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  lines StockCountLine[]
  adjustments InventoryAdjustment[] // 6B：来源盘点单方向（InventoryAdjustment.sourceStockCountId，可空——Manual 调整无盘点来源）

  @@index([countNo])
  @@index([status])
  @@index([deletedAt])
}

/// Sprint 6B：盘点明细行（per-line atomic snapshot——CTO #7975 Blocking ①）
/// CTO Schema 问题③：同一五维在一个 Count 内必须唯一（防同一盘点单对同一库存维度重复盘两行）——DB UNIQUE NULLS NOT DISTINCT
/// 录入 countedQty 时同事务读取五维 StockProjection → bookQtyAtCount / countedAt / ledgerWatermark（仅审计）
model StockCountLine {
  id            String   @id @default(cuid())
  countHeaderId String
  countHeader   StockCount @relation(fields: [countHeaderId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId    String?
  location      WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于同一 warehouse
  itemId        String
  item          Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchNo       String?
  serialNo      String? // 单值（serial-managed 逐 serial 盘点）
  countedQty    Decimal  @db.Decimal(18, 4) // 实盘数（录入）
  bookQtyAtCount Decimal @db.Decimal(18, 4) // 录入时同事务读取五维 StockProjection.onHandQty（per-line atomic snapshot）
  countedAt     DateTime @db.Timestamptz(3) // 录入时点
  ledgerWatermark String? // 仅审计/重放证据（movementNo 不作并发时序主键，CTO #7975 Blocking ②）
  varianceQty   Decimal? @db.Decimal(18, 4) // 服务端计算：countedQty - bookQtyAtCount
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  adjustments   InventoryAdjustmentLine[] // 反向：差异生成的调整行

  @@index([countHeaderId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([deletedAt])
}

/// Sprint 6B：库存调整单头（受控库存账事实——只能经共享 Ledger Command 追加 Movement）
/// CTO Schema 问题④ maker-checker：createdById（创建人）与 approvedById/appliedById（批准/Apply 人）结构承载，service 强制不同人；
/// CTO 6B Schema Re-review Integrity ②：createdById NOT NULL——可空会让 maker-checker CHECK 三值逻辑失效，系统自动创建的 Count Adjustment 也必须有明确 system actor
/// CTO Schema 问题⑥：状态只有在 Ledger 成功后才进入 APPLIED——不允许"业务单据终态已写、Movement 失败"
/// reasonCode（P8 Final）：系统保留码 + 可扩展字典（不写死 enum）
/// CTO 6B Schema Re-review Integrity ①：DB CHECK 保证 status=APPLIED 时 approvedById/appliedById/appliedAt 全部非空（终态必须有执行证据）
model InventoryAdjustment {
  id            String   @id @default(cuid())
  adjustmentNo  String   @unique // 调整单号（DocumentSequence docType=INVENTORY_ADJUSTMENT，前缀 ADJ）
  status        InventoryAdjustmentStatus @default(DRAFT)
  reasonCode    String   // P8 Final：系统保留码（COUNT_VARIANCE/DAMAGE/LOSS/GIFT/SYSTEM_CORRECTION/MANUAL）+ 可扩展字典
  // CTO 6B Schema Re-review Blocking ①：direction 下沉到 InventoryAdjustmentLine——同一 Adjustment 可原子承载盘盈+盘亏差异行（一次 Stock Count 的 +5/-3 属于同一盘点事实）；Header 不再有单一方向
  sourceStockCountId String? // 来源盘点单（可空——Manual 调整无盘点来源）
  sourceStockCount   StockCount? @relation(fields: [sourceStockCountId], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User? @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  appliedById   String?
  appliedBy     User? @relation("AdjustmentAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  appliedAt     DateTime? @db.Timestamptz(3) // CTO Schema 问题⑥：Ledger 成功后写入（APPLIED 才有）
  remark        String?
  isActive      Boolean @default(true)
  createdById   String // CTO 6B Schema Re-review Integrity ②：NOT NULL——maker-checker 闭环（createdById 可空会让 CHECK 三值逻辑失效）；系统自动创建的 Count Adjustment 也必须带明确 system actor
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  lines InventoryAdjustmentLine[]

  @@index([adjustmentNo])
  @@index([status])
  @@index([reasonCode])
  @@index([deletedAt])
}

/// Sprint 6B：库存调整行（每行 → 一笔 ADJUSTMENT Movement；Count 通过 sourceStockCountLineId 追溯，不新增 STOCK_COUNT sourceType）
model InventoryAdjustmentLine {
  id            String   @id @default(cuid())
  adjustmentHeaderId String
  adjustmentHeader   InventoryAdjustment @relation(fields: [adjustmentHeaderId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId    String?
  location      WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于同一 warehouse
  itemId        String
  item          Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchNo       String?
  serialNo      String? // 单值（serial-managed 逐 serial 原子化）
  direction     InventoryMovementDirection // IN / OUT（CTO 6B Schema Re-review Blocking ①：方向下沉到行——同一 Adjustment 可同时承载盘盈/盘亏；quantity 恒正数）
  quantity      Decimal  @db.Decimal(18, 4) // 恒正数（方向在行）
  uomId         String?
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  sourceStockCountLineId String? @unique // 盘点行追溯（CTO 6B Schema Re-review Blocking ②：一个 StockCountLine 最多对应一个正式 AdjustmentLine——防双重入账；PG 普通 UNIQUE 允许多个 NULL，Manual 不受影响；未来纠错走 Reversal/Correction）
  sourceStockCountLine   StockCountLine? @relation(fields: [sourceStockCountLineId], references: [id], onDelete: SetNull)
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([adjustmentHeaderId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([deletedAt]) // sourceStockCountLineId 由 @unique 覆盖（Blocking ②）
}

/// Sprint 6B：库存转换单头（收窄为同 item Repack / UOM Conversion——CTO #7975 Blocking ③）
/// CTO Schema 问题⑤：Base UOM canonicalization 与现有 Item/UOM 模型对齐——baseUomId 引用现有 UnitOfMeasure（不发明第二套 UOM master）
/// CTO Schema 问题⑥：状态只有在 Ledger 成功后才进入 EXECUTED
model InventoryConversion {
  id            String   @id @default(cuid())
  conversionNo  String   @unique // 转换单号（DocumentSequence docType=INVENTORY_CONVERSION，前缀 CVT）
  status        InventoryConversionStatus @default(DRAFT)
  itemId        String // 同一 itemId（6B 收窄：同 item Repack/UOM Conversion）
  item          Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  baseUomId     String // Inventory Base UOM（引用现有 UnitOfMeasure；P11 Final——service Gate 验证 baseUomId == 该 Item 的 inventory/stock UOM，不允许调用方任意选 UOM 冒充库存基准）
  baseUom       UnitOfMeasure? @relation("ConversionBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  // CTO 6B Schema Re-review Blocking ④：header 单一 conversionRate 已删除——换算 snapshot 下沉到 Line（uomToBaseRate/baseQuantity），Ledger canonicalization 只认 line 级 baseQuantity
  movementGroupId String? // CTO Schema 问题①：EXECUTE 时生成并冻结（CONSUME + PRODUCE 共享）；DRAFT 可空
  executedAt    DateTime? @db.Timestamptz(3) // CTO Schema 问题⑥：Ledger 成功后写入（EXECUTED 才有）
  executedById  String?
  executedBy    User? @relation("ConversionExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  lines InventoryConversionLine[]

  @@index([conversionNo])
  @@index([itemId])
  @@index([status])
  @@index([movementGroupId])
  @@index([deletedAt])
}

/// Sprint 6B：库存转换行（lineRole=CONSUME / PRODUCE；换算到 base UOM 后 ΣCONSUME 与 ΣPRODUCE 相等，P11 Final）
model InventoryConversionLine {
  id            String   @id @default(cuid())
  conversionHeaderId String
  conversionHeader   InventoryConversion @relation(fields: [conversionHeaderId], references: [id], onDelete: Cascade)
  lineRole      InventoryConversionLineRole // CONSUME / PRODUCE（CTO 6B Schema Re-review Blocking ③：UNIQUE(conversionHeaderId, lineRole)——每张 Conversion 最多 1 CONSUME + 1 PRODUCE，P10 单输入单输出）
  quantity      Decimal  @db.Decimal(18, 4) // 业务 UOM 数量
  uomId         String?
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  uomToBaseRate Decimal  @db.Decimal(18, 6) // 行级换算率 snapshot（业务 UOM → base UOM；Blocking ④——header 单一 rate 无法无歧义描述两方向各自换算；DB CHECK uomToBaseRate > 0）
  baseQuantity  Decimal  @db.Decimal(18, 4) // canonical 数量 = quantity × uomToBaseRate（P11 Final：Ledger/Projection 只记 base UOM canonical 数量；service EXECUTE 前验证 CONSUME.baseQuantity == PRODUCE.baseQuantity；DB CHECK baseQuantity > 0）
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId    String?
  location      WarehouseLocation? @relation(fields: [locationId, warehouseId], references: [id, warehouseId], onDelete: Restrict) // 组合 FK：location 必须属于同一 warehouse
  batchNo       String? // P5 Final：batch 默认精确继承
  remark        String?
  isActive      Boolean @default(true)
  createdById   String?
  updatedById   String?
  version       Int     @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([conversionHeaderId])
  @@unique([conversionHeaderId, lineRole]) // Blocking ③：单输入单输出（最多 1 CONSUME + 1 PRODUCE）
  @@index([warehouseId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 5C-1：Supplier Invoice / MatchRun / GRIR / AP Liability-OpenItem Foundation
//（CTO 5C Gate Final Re-review #8925 99/100 FINAL APPROVED——4 Blocking 全 CLOSED，
//  P1-P12 FINAL，Migration 0027 HOLD 正式解除（仅 5C-1）；暂不开始 API）
// 事实链：PO Commitment → Receipt Fact → Warehouse/Inventory Fact → Supplier Invoice
//        → 3-Way Match → AP Liability → Payment（Payment 属 5C-2）
// 8 个 Schema 不变量（CTO #8925）：
// ① 首版只能 RECEIPT_BASED：PO Line + POSTED WarehouseReceiptLine 双溯源（Line 双必填 FK）
// ② 供应商发票号重复录入 DB 最终防线：UNIQUE(supplierId, supplierInvoiceNo)（不全局误锁）
// ③ MatchRun revision DB 唯一识别：UNIQUE(supplierInvoiceId, revision)；MatchRun/MatchLine
//    具备 DB immutable trigger（Migration 0027 落，对齐 0025 Movement 不可变）
// ④ approvedMatchRunId/revision 必须属于当前 SupplierInvoice（组合 FK：
//    SupplierInvoice(approvedMatchRunId, id) → MatchRun(id, supplierInvoiceId)，
//    对齐 5B Inspection 组合 FK 先例——DB 层禁止引用另一张发票的 MatchRun）
// ⑤ GRIR accrual / return reversal / invoice consume 三类源 identity 分别 DB 幂等唯一
// ⑥ AP Liability = Fact（POSTED 生成、不可变），OpenItem = Projection（openAmount 只读投影）
// ⑦ vatRecoverable=false ⇒ nonRecoverableTaxAmount = taxAmount（DB CHECK）；
//    recoverable=true ⇒ nonRecoverableTaxAmount = 0（同一税额不双计）
// ⑧ POSTED 终态 evidence：postedAt + postedById + approvedMatchRunId/revision 全非空
//    （DB CHECK）；APPROVED ≠ POSTED（状态机枚举分离）
// 红线：不建 GL / 不写库存成本层（Costing HOLD）/ 无 CN-DN / 无 Payment / 无 5C-2
// ============================================================================

/// 供应商发票单据状态（P3 Final 两维之一：documentStatus 截止 POSTED/CANCELLED）
enum SupplierInvoiceDocumentStatus {
  DRAFT
  SUBMITTED
  MATCHED
  APPROVED
  POSTED // 终态：生成 AP Liability Fact + consume GRIR；APPROVED ≠ POSTED（不变量⑧）
  CANCELLED
}

/// 结算状态（P3 Final 两维之二：独立维度，由 Payment Allocation 驱动——5C-2；不污染 documentStatus）
enum SupplierInvoiceSettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// 三单匹配行级结果（当前投影；历史走 immutable MatchRun）
enum SupplierInvoiceMatchResult {
  MATCHED
  VARIANCE
  PENDING
}

/// 匹配差异处置（触发 Workflow 审批条件）
enum SupplierInvoiceMatchDisposition {
  ACCEPT
  REJECT
  HOLD
  CREATE_CN_DN // 5C-2 实现
}

/// GRIR 生命周期类型（Blocking ①：Accrual / Reversal / Consume 三类源身份各自幂等）
enum GrirType {
  ACCRUAL // 来源：WarehouseReceiptLine（WHR Posted 时按 PO 快照单价 × 入库量）
  REVERSAL // 来源：WarehouseReceipt-based PurchaseReturnLine（只有已 POSTED WHR 来源退货才冲减）
  CONSUME // 来源：SupplierInvoiceLine（POSTED 时 consume remaining GRIR + 生成 AP Liability Fact）
}

/// 供应商发票（5C-1 核心事实：PO + WarehouseReceipt-based stock procurement，RECEIPT_BASED 首版唯一）
model SupplierInvoice {
  id       String   @id @default(cuid())
  invoiceNo String  @unique // 发票单号（DocumentSequence docType=SUPPLIER_INVOICE，前缀 SINV；创建即取号 P1 Final，缺失 fail closed）
  supplierInvoiceNo String // 供应商发票号（供应商侧唯一标识；不变量②：与 supplierId 组合唯一——不全局误锁不同供应商相同号码）
  supplierId String
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceDate DateTime @db.Date
  receivedDate DateTime @db.Date
  currency  String   @default("CNY") // 币种（对齐现有模型模式：无 Currency 主数据表，用 String ISO 码）
  exchangeRate Decimal @default(1) @db.Decimal(18, 6) // 创建时快照 FX（P2 Final）；人工覆盖需受限权限 + audit
  // 两维状态（P3 Final）
  documentStatus SupplierInvoiceDocumentStatus @default(DRAFT)
  settlementStatus SupplierInvoiceSettlementStatus @default(UNPAID)
  // 金额（服务端 Decimal 聚合，禁客户端直传头金额；对齐 5A PO 金额事实）
  grossAmount Decimal @db.Decimal(18, 2) // 含税总额 = Σ 行
  netAmount   Decimal @db.Decimal(18, 2) // 不含税总额 = Σ 行净额
  taxAmount   Decimal @db.Decimal(18, 2) // 税额合计 = gross - net
  // 匹配（当前投影 + 审批引用；不变量③④）
  currentMatchRunId String? // 当前匹配 Run 引用（当前投影，历史走 immutable MatchRun）
  currentMatchRun SupplierInvoiceMatchRun? @relation("SupplierInvoiceCurrentMatchRun", fields: [currentMatchRunId, id], references: [id, supplierInvoiceId], onDelete: Restrict) // Hardening ①：current run 引用完整性 + 必须属于本 invoice（组合 FK）
  approvedMatchRunId String? // 审批引用 immutable MatchRun（Approval references MatchRun，不 mutates MatchRun——#8901）
  approvedMatchRevision Int? // 审批引用 revision（Blocking ①：三列 FK 绑定——approvedRunId+revision+invoice 必须同属一个 immutable snapshot）
  approvedMatchRun SupplierInvoiceMatchRun? @relation("SupplierInvoiceApprovedMatchRun", fields: [approvedMatchRunId, id, approvedMatchRevision], references: [id, supplierInvoiceId, revision], onDelete: Restrict) // Blocking ①：三列 FK → MatchRun(id, supplierInvoiceId, revision) 同 snapshot 一致性
  // POSTED 终态证据（不变量⑧：POSTED ⇒ 全非空；APPROVED ≠ POSTED）
  postedAt DateTime? @db.Timestamptz(3)
  postedById String?
  postedBy  User? @relation("SupplierInvoicePostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  paymentDueDate DateTime? @db.Date // 账期（对齐 4E-1 dueDate，方向相反）
  // 增值税发票管理（ADR-0043：POSTED 时必填+冻结；三号区分：invoiceNo ≠ supplierInvoiceNo ≠ taxInvoiceNo）
  invoiceType     InvoiceInvoiceType? // 进项发票类型（POSTED 必填 fail-closed）
  taxInvoiceCode  String? // 税务发票代码（进项专/普票 12 位；数电票 NULL）
  taxInvoiceNo    String? // 税务发票号码（进项专/普票 8 位；数电票 20 位；表内组合唯一）
  redLetter       Boolean  @default(false) // 供应商红字（负数进项票）
  redInvoiceRefId String?  // 自引用原蓝字 SupplierInvoice
  redInvoiceRef   SupplierInvoice? @relation("SupplierInvoiceRedRef", fields: [redInvoiceRefId], references: [id], onDelete: Restrict)
  remark    String?
  isActive  Boolean @default(true)
  createdById String?
  updatedById String?
  version   Int     @default(1) // CAS 乐观锁
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines SupplierInvoiceLine[]
  matchRuns SupplierInvoiceMatchRun[] @relation("SupplierInvoiceMatchRuns") // 反向：本发票的 MatchRun（immutable snapshot 集合）
  grirRecords GrirRecord[]
  apLiabilityFact ApLiabilityFact?
  creditDebitNotes SupplierCreditDebitNote[] // 5C-2：供应商贷/借项（SupplierCreditDebitNote.sourceSupplierInvoiceId 方向，单票兼容）
  creditDebitNoteInvoices SupplierCreditDebitNoteInvoice[] // 5C-2 跨票：供应商贷/借项关联（M:N，SupplierCreditDebitNoteInvoice.supplierInvoiceId 方向）
  redInvoices SupplierInvoice[] @relation("SupplierInvoiceRedRef") // 红字进项发票集合（ADR-0043）

  @@unique([supplierId, supplierInvoiceNo]) // 不变量②：供应商发票号唯一（组合，不全局误锁）
  @@unique([taxInvoiceCode, taxInvoiceNo]) // I2：税务发票号码组合唯一（NULL 不参与）
  @@index([invoiceNo])
  @@index([supplierId])
  @@index([documentStatus])
  @@index([deletedAt])
}

/// 供应商发票行（RECEIPT_BASED 首版唯一——不变量①：PO Line + POSTED WHR Line 双溯源必填）
model SupplierInvoiceLine {
  id       String   @id @default(cuid())
  supplierInvoiceId String
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String // 溯源 PO Line（承诺；必填——不变量①）
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  warehouseReceiptLineId String // 溯源入库行（数量匹配基准；必填且必须来自已 POSTED WHR——不变量①）
  warehouseReceiptLine WarehouseReceiptLine @relation(fields: [warehouseReceiptLineId], references: [id], onDelete: Restrict)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lineNo    Int      @default(10)
  quantity  Decimal  @db.Decimal(18, 4) // 开票数量（> 0）
  unitPrice Decimal  @db.Decimal(18, 6) // 单价（与 PO 快照单价比对）
  netAmount Decimal  @db.Decimal(18, 2) // 行净额 = quantity × unitPrice（服务端）
  taxRate   Decimal  @db.Decimal(18, 4) // 税率快照（开票时点冻结）
  taxAmount Decimal  @db.Decimal(18, 2) // 行税额 = netAmount × taxRate（服务端）
  // P9 Final（CTO #8901）：不可抵扣税 = 财务事实（不写库存成本层，Costing HOLD）
  vatRecoverable Boolean @default(true) // recoverable=true → 税额进 Input VAT component
  nonRecoverableTaxAmount Decimal @default(0) @db.Decimal(18, 2) // recoverable=false → = taxAmount（expense-or-capitalizable component 财务事实）
  // 匹配（当前投影；历史走 immutable MatchRun——不变量③）
  currentMatchStatus SupplierInvoiceMatchResult @default(PENDING)
  currentMatchRunId String?
  matchedQty Decimal @default(0) @db.Decimal(18, 4) // = min(invoiceQty, 可用入库量)；超过已收数量部分不可入 AP（红线）
  varianceQty Decimal @default(0) @db.Decimal(18, 4)
  variancePrice Decimal @default(0) @db.Decimal(18, 6)
  varianceTax Decimal @default(0) @db.Decimal(18, 2)
  remark    String?
  isActive  Boolean @default(true)
  createdById String?
  updatedById String?
  version   Int     @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  matchLines SupplierInvoiceMatchLine[]
  grirRecords GrirRecord[]
  currentMatchRun SupplierInvoiceMatchRun? @relation("SupplierInvoiceLineCurrentMatchRun", fields: [currentMatchRunId], references: [id], onDelete: Restrict) // Hardening ①：行级 current run 引用完整性
  creditDebitNoteLines SupplierCreditDebitNoteLine[] // 5C-2：供应商贷/借项行（SupplierCreditDebitNoteLine.sourceSupplierInvoiceLineId 方向）

  @@unique([supplierInvoiceId, lineNo])
  @@index([supplierInvoiceId])
  @@index([purchaseOrderLineId])
  @@index([warehouseReceiptLineId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 供应商贷项/借项调整类型（5C-2，AP 侧；方向与 4E-3 相反——CN 冲减 AP，DN 增加 AP）
enum SupplierCnDnType {
  CREDIT
  DEBIT
}

/// 供应商贷项/借项状态机（5C-2：DRAFT → SUBMITTED → APPROVED → APPLIED / CANCELLED）
enum SupplierCnDnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  APPLIED
  CANCELLED
}

/// 供应商贷项/借项通知单（5C-2，AP 侧独立事实；ADR-0027 D6：APPLIED 时调整 ApOpenItem 投影，不修改已 POSTED Invoice）
model SupplierCreditDebitNote {
  id            String   @id @default(cuid())
  code          String   @unique // SCN-/SDN-2026-xxxx（DocumentSequence docType=SUPPLIER_CREDIT_NOTE/SUPPLIER_DEBIT_NOTE 创建即取号，缺失 fail closed）
  noteType      SupplierCnDnType
  sourceSupplierInvoiceId String? // 单票兼容（历史数据）；跨票 Consolidated 走 invoices 关联表（Migration 0032）
  sourceSupplierInvoice SupplierInvoice? @relation(fields: [sourceSupplierInvoiceId], references: [id], onDelete: Restrict)
  supplierId    String // 继承 sourceInvoice.supplierId（硬规则）
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency      String   @default("CNY") // 继承 sourceInvoice.currency
  reason        String   // 调整原因（折扣/退货/价差/更正/其他）
  adjustmentTotal Decimal @db.Decimal(18, 4) // = Σ lines（服务端计算，禁止直传头金额）；CREDIT 负向 / DEBIT 正向 signed
  status        SupplierCnDnStatus @default(DRAFT)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  appliedAt     DateTime? @db.Timestamptz(3) // APPLIED 才回写 AP Open Item 投影（maker-checker）
  appliedById   String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines SupplierCreditDebitNoteLine[]
  invoices SupplierCreditDebitNoteInvoice[] // 5C-2 跨票：关联发票集合（M:N）

  @@index([supplierId])
  @@index([status])
  @@index([sourceSupplierInvoiceId])
  @@index([deletedAt])
}

/// 供应商贷/借项行（来源发票行快照；金额服务端计算）
model SupplierCreditDebitNoteLine {
  id           String   @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote SupplierCreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  sourceSupplierInvoiceLineId String // 来源发票行（必填可追溯）
  sourceSupplierInvoiceLine SupplierInvoiceLine @relation(fields: [sourceSupplierInvoiceLineId], references: [id], onDelete: Restrict)
  lineNo       Int      @default(10)
  itemId       String?
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description  String
  quantity     Decimal  @db.Decimal(18, 4) // 调整数量 > 0；部分行数量调整（累计防超调）
  unitPrice    Decimal  @db.Decimal(18, 6) // 单价快照（复制，不重算）
  taxRate      Decimal  @db.Decimal(18, 4) // 税率快照
  amount       Decimal  @db.Decimal(18, 4) // 调整行金额 = quantity × unitPrice（服务端计算）
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([creditDebitNoteId])
  @@index([sourceSupplierInvoiceLineId])
}

/// 供应商贷/借项 ↔ 供应商发票 关联（5C-2 跨票 Consolidated 调整；Migration 0032）
/// 一张 CN/DN 可调整多张 POSTED 发票（同供应商同币种硬规则）；金额按行归属分摊各发票 Open Item
model SupplierCreditDebitNoteInvoice {
  id           String   @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote SupplierCreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  supplierInvoiceId String
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([creditDebitNoteId, supplierInvoiceId])
  @@index([creditDebitNoteId])
  @@index([supplierInvoiceId])
}
/// 付款状态（5C-2 Settlement Fact 受控投影，事务更新禁止 PATCH——对齐 4E-2 ReceiptStatus）
enum SupplierPaymentStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  ALLOCATED
}

/// 供应商付款单（5C-2，ADR-0027 D7：Payment 独立事实，Created ≠ Applied，Apply 唯一回写 Settlement Fact）
model SupplierPayment {
  id           String   @id @default(cuid())
  code         String   @unique // PAY-2026-xxxx（DocumentSequence docType=PAYMENT_VOUCHER 创建即取号 fail closed）
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 同供应商同币种（核销目标硬规则）
  amount       Decimal  @db.Decimal(18, 4) // 实付金额（付款事实）
  allocatedAmount   Decimal @default(0) @db.Decimal(18, 4) // 受控投影 = Σ allocations（非反向核销）
  unallocatedAmount Decimal @default(0) @db.Decimal(18, 4)
  paymentDate  DateTime @db.Timestamptz(3)
  paymentMethod PaymentMethod // 复用 4E-2 枚举
  referenceNo  String? // 银行流水号/备注
  status       SupplierPaymentStatus @default(UNALLOCATED) // 受控投影（事务更新，禁止 PATCH）
  voidedAt     DateTime? @db.Timestamptz(3)
  voidedById   String?
  // 整体冲销（Red Reversal，5C-2：已核销付款单的纠错——反转全部未反转 allocations + 回滚投影）
  reversedAt     DateTime? @db.Timestamptz(3)
  reversedById   String?
  reverseReason  String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([status])
  @@index([deletedAt])
}

/// 付款核销行（5C-2 Settlement Fact；纠错 → 追加 reversal，不手改 openAmount——Blocking ③ 纪律延续）
model SupplierPaymentAllocation {
  id           String   @id @default(cuid())
  paymentId    String
  payment      SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  apOpenItemId String
  apOpenItem   ApOpenItem @relation(fields: [apOpenItemId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal @db.Decimal(18, 4) // 本次核销金额
  allocatedAt   DateTime @default(now()) @db.Timestamptz(3)
  allocatedBy   String?
  reversedAt    DateTime? @db.Timestamptz(3)
  reversedBy    String?
  reverseReason String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([paymentId])
  @@index([apOpenItemId])
  @@index([reversedAt])
}
/// 匹配 Run 头（immutable Match Snapshot——Blocking ②：自创建后禁止业务字段 UPDATE/DELETE；
/// 审批事实引用此 Run（approvedMatchRunId/revision 存 SupplierInvoice），不 mutates MatchRun）
model SupplierInvoiceMatchRun {
  id       String   @id @default(cuid())
  supplierInvoiceId String
  supplierInvoice SupplierInvoice @relation("SupplierInvoiceMatchRuns", fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  runNo     Int      @default(1) // 每发票递增 1,2,3…
  revision  Int      @default(1) // 不可变快照标识（审批引用；重新匹配 → 追加新 Run revision+1）
  runAt     DateTime @default(now()) @db.Timestamptz(3)
  runById   String?
  runBy     User?    @relation(fields: [runById], references: [id], onDelete: SetNull)
  result    SupplierInvoiceMatchResult // 头级结果 MATCHED / VARIANCE
  disposition SupplierInvoiceMatchDisposition @default(HOLD) // 触发 Workflow 审批条件
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  lines SupplierInvoiceMatchLine[]
  currentForInvoices SupplierInvoice[] @relation("SupplierInvoiceCurrentMatchRun") // Hardening ①：SupplierInvoice.currentMatchRun 反向
  approvedForInvoices SupplierInvoice[] @relation("SupplierInvoiceApprovedMatchRun") // Blocking ①：SupplierInvoice.approvedMatchRun 反向
  currentForLines SupplierInvoiceLine[] @relation("SupplierInvoiceLineCurrentMatchRun") // Hardening ①：SupplierInvoiceLine.currentMatchRun 反向

  @@unique([supplierInvoiceId, revision]) // 不变量③：invoice + revision 唯一识别
  @@unique([id, supplierInvoiceId]) // 不变量④：支持 SupplierInvoice(currentMatchRunId, id) 组合 FK 引用（current run 必须属于同一发票）
  @@unique([id, supplierInvoiceId, revision]) // Blocking ①：支持 SupplierInvoice(approvedMatchRunId, id, approvedMatchRevision) 三列 FK 引用（同 snapshot）
  @@index([supplierInvoiceId])
}

/// 匹配 Run 行（immutable Match Snapshot 行；审批引用 Run 级，行级不可变）
model SupplierInvoiceMatchLine {
  id       String   @id @default(cuid())
  matchRunId String
  matchRun  SupplierInvoiceMatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  supplierInvoiceLineId String
  supplierInvoiceLine SupplierInvoiceLine @relation(fields: [supplierInvoiceLineId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String // 快照引用（匹配时点 PO Line）
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  warehouseReceiptLineId String // 快照引用（匹配时点 WHR Line）
  warehouseReceiptLine WarehouseReceiptLine @relation(fields: [warehouseReceiptLineId], references: [id], onDelete: Restrict)
  poQty     Decimal  @db.Decimal(18, 4)
  receiptQty Decimal @db.Decimal(18, 4)
  invoiceQty Decimal @db.Decimal(18, 4)
  poUnitPrice Decimal @db.Decimal(18, 6)
  invoiceUnitPrice Decimal @db.Decimal(18, 6)
  qtyVariance Decimal @db.Decimal(18, 4)
  priceVariance Decimal @db.Decimal(18, 6)
  taxVariance Decimal @db.Decimal(18, 2)
  result    SupplierInvoiceMatchResult
  disposition SupplierInvoiceMatchDisposition
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([matchRunId])
  @@index([supplierInvoiceLineId])
  @@unique([matchRunId, supplierInvoiceLineId]) // 一行发票行每次匹配一条 Run 行
}

/// GRIR（暂估应付事实——Blocking ① 完整生命周期：Accrual / Reversal / Consume）
/// 不变量⑤：三类源 identity 分别 DB 幂等唯一（防重复冲回，对齐 6A 五元幂等纪律）
model GrirRecord {
  id       String   @id @default(cuid())
  grirType GrirType
  supplierInvoiceId String? // consume 时关联发票（可空：accrual/reversal 时无发票）
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  supplierInvoiceLineId String? // consume 源（POSTED 时）
  supplierInvoiceLine SupplierInvoiceLine? @relation(fields: [supplierInvoiceLineId], references: [id], onDelete: Restrict)
  warehouseReceiptLineId String? // accrual 源（WHR Posted 时）
  warehouseReceiptLine WarehouseReceiptLine? @relation(fields: [warehouseReceiptLineId], references: [id], onDelete: Restrict)
  purchaseReturnLineId String? // reversal 源（WHR-based PurchaseReturned 时；未入库退货不产生 reversal）
  purchaseReturnLine PurchaseReturnLine? @relation(fields: [purchaseReturnLineId], references: [id], onDelete: Restrict)
  baseAmount Decimal @db.Decimal(18, 2) // 不含税暂估净额（P9 Final：GRIR baseAmount = 不含税；进项税只在合规发票进入时确认）
  quantity  Decimal  @db.Decimal(18, 4) // 暂估数量
  unitPrice Decimal  @db.Decimal(18, 6) // PO 快照单价（暂估基准）
  taxRate   Decimal  @db.Decimal(18, 4) // 税率快照（normalize 用）
  // 源幂等身份（不变量⑤：accrual/reversal/consume 各自唯一，防重复冲回）
  sourceKey String // 服务端生成的幂等键："{grirType}:{sourceType}:{sourceLineId}"
  remark    String?
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([sourceKey]) // 不变量⑤ DB 幂等最终防线（accrual/reversal/consume 三类源身份唯一）
  @@index([grirType])
  @@index([supplierInvoiceId])
  @@index([warehouseReceiptLineId])
  @@index([purchaseReturnLineId])
  @@index([supplierInvoiceLineId])
}

/// AP Liability Fact（应付债务事实——Blocking ③：POSTED 生成、不可变；OpenItem 是投影）
model ApLiabilityFact {
  id       String   @id @default(cuid())
  supplierInvoiceId String @unique // 一票一 Liability Fact（POSTED 时生成）
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  supplierId String
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currency  String   @default("CNY") // 币种（对齐现有模型模式：无 Currency 主数据表，用 String ISO 码）
  // 金额事实（不变量⑥：Liability 是事实，OpenItem 是投影——本表无 openAmount 可改字段）
  grossAmount Decimal @db.Decimal(18, 2) // AP 总债务 = net + total tax（不因 recoverability 改变）
  netAmount   Decimal @db.Decimal(18, 2)
  inputVatAmount Decimal @db.Decimal(18, 2) // recoverable=true 部分（Input VAT component）
  nonRecoverableTaxAmount Decimal @db.Decimal(18, 2) // recoverable=false 部分（expense-or-capitalizable component 财务事实；不写库存成本层）
  dueDate   DateTime? @db.Date
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  openItem ApOpenItem?

  @@index([supplierId])
  @@index([currency])
}

/// AP Open Item（materialized projection / read model——Blocking ③：openAmount 不是财务事实源；
/// Reconciliation：openAmount = Liability + CN/DN - Allocations（5C-2 才有 CN/DN/Allocation）
/// 本表只读投影，金额由服务端 reconciliation 计算，禁止直接 UPDATE openAmount）
model ApOpenItem {
  id       String   @id @default(cuid())
  apLiabilityFactId String @unique
  apLiabilityFact ApLiabilityFact @relation(fields: [apLiabilityFactId], references: [id], onDelete: Cascade)
  supplierId String
  currency  String   @default("CNY") // 币种
  // 投影字段（服务端计算，不手改——不变量⑥）
  openAmount Decimal @db.Decimal(18, 2) // = Liability + CN/DN - Allocations（5C-1 阶段 = grossAmount 初始投影）
  settlementStatus SupplierInvoiceSettlementStatus @default(UNPAID)
  dueDate   DateTime? @db.Date
  version   Int      @default(1) // 投影刷新 CAS（reconciliation 服务端更新）
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  paymentAllocations SupplierPaymentAllocation[] // 5C-2：付款核销行（SupplierPaymentAllocation.apOpenItemId 方向）

  @@index([supplierId])
  @@index([settlementStatus])
}
/// 会计科目（Sprint 7 GL 过账首块，Migration 0033；ADR-0033）
/// 标准中国会计科目最小集（seed 初始化）；code 唯一；只读主数据（禁止业务侧 PATCH 科目余额/方向）
enum GlAccountCategory {
  ASSET // 资产
  LIABILITY // 负债
  EQUITY // 权益
  REVENUE // 收入
  EXPENSE // 费用
}

/// 科目余额方向（中国科目惯例：资产/费用 = 借方向；负债/权益/收入 = 贷方向）
enum GlAccountDirection {
  DEBIT
  CREDIT
}

model GlAccount {
  id        String   @id @default(cuid())
  code      String   @unique // 科目编码（如 1002 银行存款 / 1403 原材料 / 2202 应付账款 / 222101 进项税 / 6111 采购调整）
  name      String   // 科目名称（中文）
  category  GlAccountCategory
  direction GlAccountDirection
  isActive  Boolean  @default(true)
  remark    String?
  createdById String?
  updatedById String?
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  journalEntryLines GlJournalEntryLine[]

  @@index([category])
  @@index([deletedAt])
}

/// 会计期间状态（ADR-0044：OPEN 可过账/可结转；CLOSED 已结转可重开；LOCKED 人为锁定终态）
enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

/// 凭证字（中国《会计基础工作规范》惯例：记/收/付/转；ADR-0044）
enum GlVoucherType {
  GENERAL   // 记
  RECEIPT   // 收
  PAYMENT   // 付
  TRANSFER  // 转
}

/// 会计期间（自然月，中国市场；Sprint 7，Migration 0038，ADR-0044）
/// periodKey "YYYYMM" 与 GlPeriodClose.periodKey "YYYY-MM" 经转换函数兼容；close/reopen 同事务联动 status
model AccountingPeriod {
  id            String   @id @default(cuid())
  periodKey     String   @unique // "YYYYMM"（如 202608）
  fiscalYear    Int      // 会计年度（= 自然年；跨年结转逻辑后续）
  startDate     DateTime @db.Date // 当月 1 日（Asia/Shanghai 业务日）
  endDate       DateTime @db.Date // 当月最后一日（含）
  status        AccountingPeriodStatus @default(OPEN)
  periodCloseId String?  @unique // status=CLOSED 时指向 GlPeriodClose.id（期末结转引用）
  periodClose   GlPeriodClose? @relation(fields: [periodCloseId], references: [id])
  closedById    String?
  closedAt      DateTime? @db.Timestamptz(3)
  createdById   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([fiscalYear])
  @@index([status])
}

/// 记账凭证头（Sprint 7 GL，Migration 0033；ADR-0033）
/// POSTED 一次性终态不可变；sourceType+sourceId 幂等（防重复过账）；纠错 → 追加红字冲销凭证
model GlJournalEntry {
  id         String   @id @default(cuid())
  voucherNo  String?  @unique // 凭证号（自动过账：创建即取号；手工凭证：DRAFT 不占号，POSTED 时取号——4D 教训，ADR-0035）
  postingDate DateTime @db.Timestamptz(3) // 过账日期
  status     String   @default("POSTED") // 自动过账 POSTED；手工凭证 DRAFT→SUBMITTED→APPROVED→POSTED/REJECTED（ADR-0035）
  voucherType     GlVoucherType @default(GENERAL) // 凭证字：记/收/付/转（ADR-0044；自动过账=记，结转/冲销=转）
  attachmentCount Int           @default(0) // 附件张数（ADR-0044；>= 0，DB CHECK）
  sourceType String   // 来源类型（SupplierInvoicePosted / SupplierPaymentApplied / SupplierCreditDebitNoteApplied / SupplierPaymentReversed / MANUAL）
  sourceId   String   // 来源业务事实 id（发票 id / 核销行 id / CN-DN id；手工凭证 = cuid）
  summary    String?  // 摘要
  createdById String? // 触发人（consumer 过账 = 触发 consume 的 actor；手工凭证 = 创建人）
  approvedById String? // 手工凭证审核人（approver ≠ creator——maker-checker，ADR-0035）
  approvedAt  DateTime? @db.Timestamptz(3)
  postedById  String?
  postedAt    DateTime? @db.Timestamptz(3)
  version    Int      @default(1)
  deletedAt  DateTime?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  lines GlJournalEntryLine[]
  periodClose GlPeriodClose? // 期末结转记录（sourceType=PERIOD_CLOSE 凭证的结转引用，ADR-0036）

  @@unique([sourceType, sourceId]) // 幂等：同一来源只允许一张凭证（防重复过账）
  @@index([postingDate])
  @@index([sourceType])
  @@index([deletedAt])
}

/// 记账凭证行（Sprint 7 GL，Migration 0033；ADR-0033）
/// 每行恰一侧 > 0（debit 或 credit），另一侧为 0；Σdebit = Σcredit（服务端过账校验）
model GlJournalEntryLine {
  id        String   @id @default(cuid())
  entryId   String
  entry     GlJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   GlAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Decimal  @default(0) @db.Decimal(18, 2) // 借方金额（> 0 时 credit 必须为 0）
  credit    Decimal  @default(0) @db.Decimal(18, 2) // 贷方金额（> 0 时 debit 必须为 0）
  summary   String?  // 行摘要（科目说明）
  sourceRef String?  // 来源引用（如发票行 id，便于 GL 追溯）
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entryId])
  @@index([accountId])
}

/// 库存成本余额（移动加权平均；D9 HOLD 解除，Migration 0036，ADR-0038）
/// item 级移动平均成本层：avg' = (totalCost + baseAmount) / (onHandQty + qty)；成本层独立，不写 Movement/StockProjection（6A 红线）
model InventoryCostBalance {
  id        String   @id @default(cuid())
  itemId    String   @unique
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  onHandQty Decimal  @default(0) @db.Decimal(18, 4) // 在库数量（成本层镜像，跟随入库更新）
  totalCost Decimal  @default(0) @db.Decimal(18, 4) // 库存总成本（未税采购成本口径）
  avgUnitCost Decimal @default(0) @db.Decimal(18, 4) // 移动加权平均单位成本
  version   Int      @default(1) // CAS 乐观锁
  createdById String?
  updatedById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([itemId])
}


/// 生产入库单（P-1/ProductionInbound，ADR：基于利尼尔生产入库表设计）
/// 承载「半成品 → 产成品」生产入库事实；POSTED 时同事务产生库存效应（半成品 OUT + 产成品 IN）。
model ProductionInbound {
  id           String   @id @default(cuid())
  inboundNo    String   @unique // 生产入库单号（按生产日期或流水）
  inboundDate  DateTime // 生产日期
  warehouseId  String // 入库仓库
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  batchNo      String? // 生产批次
  totalQty     Decimal  @default(0) @db.Decimal(14, 3) // 入库总数量（Σ toQty）
  totalAmount  Decimal  @default(0) @db.Decimal(14, 2) // 入库总金额（Σ amount）
  status       ProductionInboundStatus @default(DRAFT)
  remark       String?
  createdById  String?
  updatedById  String?
  postedById   String? // 过账人（POSTED 时记录）
  postedAt     DateTime?
  version      Int      @default(1) // CAS 乐观锁
  deletedAt    DateTime?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  lines ProductionInboundLine[]

  @@index([inboundDate])
  @@index([warehouseId])
  @@index([status])
  @@index([deletedAt])
}

/// 生产入库行：半成品（fromItem）消耗 → 产成品（toItem）入库
model ProductionInboundLine {
  id        String   @id @default(cuid())
  inboundId String
  inbound   ProductionInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  fromItemId String // 半成品（消耗源）
  fromItem  Item     @relation("ProdFromItem", fields: [fromItemId], references: [id])
  fromQty   Decimal  @db.Decimal(14, 3) // 半成品消耗数量
  toItemId  String // 产成品（入库目标）
  toItem    Item     @relation("ProdToItem", fields: [toItemId], references: [id])
  toQty     Decimal  @db.Decimal(14, 3) // 产成品入库数量
  unitCost  Decimal  @db.Decimal(14, 4) // 单位成本（standardCost 或移动加权）
  amount    Decimal  @db.Decimal(14, 2) // 金额 = unitCost × toQty
  remark    String?
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([inboundId])
  @@index([fromItemId])
  @@index([toItemId])
}
/// 库存成本幂等源（ADR-0038）：sourceKey @unique 防重复累计成本（与 GRIR ACCRUAL 同事务）
model InventoryCostSource {
  id        String   @id @default(cuid())
  sourceKey String   @unique // COST:WAREHOUSE_RECEIPT_LINE:{lineId}
  itemId    String
  quantity  Decimal  @db.Decimal(18, 4)
  baseAmount Decimal @db.Decimal(18, 4)
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([itemId])
}

/// 期末结转记录（Sprint 7 GL，Migration 0035；ADR-0036）
/// periodKey @unique 防重复月结；journalEntryId 引用结转凭证（sourceType=PERIOD_CLOSE）
model GlPeriodClose {
  id        String   @id @default(cuid())
  periodKey String   @unique // "YYYY-MM"（如 2026-08）
  journalEntryId String @unique // 结转凭证（借 REVENUE / 借本年利润 贷 EXPENSE，本年利润=差额）
  journalEntry GlJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod? // 反向：AccountingPeriod.periodCloseId 引用（ADR-0044，1:1）
  closedById String? // 执行人
  closedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([periodKey])
}

