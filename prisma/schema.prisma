// Linier CRM Management System - Sprint 2 China Industrial Master Data schema (v2)
// CTO directive: unified Item model + BusinessPartner model for Chinese industrial enterprise.
// Master data foundation: Item / LinearGuideSpecification / BusinessPartner / PriceList /
// TechnicalStandard / ItemStandard / UnitOfMeasure / CommercialTerm / DocumentSequence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 物料分类：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物
/// 物料分类（CTO #2075：10 类，未来只加枚举值不加字段）
enum ItemType {
  FINISHED_GOOD // 成品
  RAW_MATERIAL // 原材料
  SEMI_FINISHED // 半成品
  PURCHASED_PART // 外购件
  ACCESSORY // 辅料/配件
  SERVICE // 服务
  CONSUMABLE // 消耗品
  ASSET // 资产
  TOOLING // 工装/模具
  PACKAGING // 包装材料
}

/// 审核状态：草稿 / 待审核 / 已审核 / 已驳回
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// 往来单位类型：客户 / 供应商 / 客户兼供应商
enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

/// 价格类型（采购价/销售价/VIP/代理/工程/战略客户/区域价/客户专属价/历史价）
enum PriceType {
  PURCHASE // 采购价
  SALES // 销售价
  VIP // VIP 价
  AGENT // 代理价
  ENGINEERING // 工程价
  STRATEGIC // 战略客户价
  REGIONAL // 区域价
  CUSTOMER // 客户专属价
  HISTORICAL // 历史价
}

/// 物料生命周期（CTO #2075：产品生命周期，与 ItemStatus 系统状态分离）
enum ItemLifecycle {
  DESIGN // 设计
  TRIAL // 试产
  MASS_PRODUCTION // 量产
  DISCONTINUED // 停产
  OBSOLETE // 淘汰
}

/// 物料系统状态（CTO #2075：是否允许使用，与 Lifecycle 分离）
enum ItemStatus {
  ACTIVE // 可用
  INACTIVE // 停用
  LOCKED // 锁定（不允许变更）
  ARCHIVED // 归档（只读）
}

/// 物料成本类型（CTO #2075：只建接口不写算法，Finance 引用）
enum ItemCostType {
  STANDARD // 标准成本
  LAST_PURCHASE // 最近采购价
  AVERAGE // 移动平均
  CURRENT // 现行成本
}

/// 附件类型（CTO #2075：统一放 File Center，Project/Supplier/Customer/Quotation 共用）
enum AttachmentType {
  DRAWING // 图纸
  CERTIFICATE // 证书
  PHOTO // 照片
  MANUAL // 手册
  MODEL_3D // 3D 模型
  VIDEO // 视频
  INSPECTION_REPORT // 检验报告
}

/// 单据类型（报价/SO/PO/PI/CI/DO/GRN/GI/发票/贷项/借项/付款/收款/费用/日记账/合同/项目）
enum DocumentType {
  QUOTATION // 报价单
  SALES_ORDER // 销售订单 SO
  PURCHASE_ORDER // 采购订单 PO
  PROFORMA_INVOICE // 形式发票 PI
  COMMERCIAL_INVOICE // 商业发票 CI
  DELIVERY_ORDER // 送货单 DO
  GOODS_RECEIPT_NOTE // 收货单 GRN
  GOODS_ISSUE // 出库单 GI
  INVOICE // 发票
  CREDIT_NOTE // 贷项通知单
  DEBIT_NOTE // 借项通知单
  PAYMENT_VOUCHER // 付款凭证
  RECEIPT // 收款收据
  EXPENSE // 费用报销
  JOURNAL // 日记账
  CONTRACT // 合同
  PROJECT // 项目
}

/// Platform user account. Identity and credential record.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  isActive     Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([email])
  @@index([departmentId])
}

/// Organizational unit users belong to.
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

/// Named role that bundles permissions (e.g. ADMIN, MANAGER, MEMBER, VIEWER).
model Role {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       UserRole[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([code])
}

/// Atomic capability, grouped by module (e.g. user:read, item:write).
model Permission {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  module      String
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([module, code])
}

/// Explicit many-to-many link between User and Role.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Immutable trail of security-sensitive and destructive actions.
/// 审计结果
enum AuditResult {
  SUCCESS
  FAILURE
  PARTIAL
}

/// 审计日志（Sprint 3B 升级：ObjectType/ObjectId/Before/AfterData/RequestId/TraceId/IP/Device/Browser/Duration/Result）
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String // ObjectType（如 workflow-definition）
  entityId   String? // ObjectId
  beforeData Json? // 操作前数据快照
  afterData  Json? // 操作后数据快照
  requestId  String? // 请求 ID（链路追踪）
  traceId    String? // 追踪 ID（全链路）
  meta       Json?
  ipAddress  String? // IP
  device     String? // 设备（mobile/desktop）
  browser    String? // 浏览器 UA 摘要
  duration   Int? // 耗时（毫秒）
  result     AuditResult @default(SUCCESS) // 操作结果
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([traceId])
  @@index([result])
  @@index([createdAt])
}

/// 计量单位主数据（如：kg、m、件、套）
model UnitOfMeasure {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  symbol        String?
  isActive      Boolean  @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int      @default(1)
  deletedAt     DateTime?
  items         Item[]          @relation("ItemUnit")
  stockItems    Item[]          @relation("ItemStockUom")
  purchaseItems Item[]          @relation("ItemPurchaseUom")
  salesItems    Item[]          @relation("ItemSalesUom")
  fromConversions UomConversion[] @relation("UomConversionFrom")
  toConversions   UomConversion[] @relation("UomConversionTo")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 统一物料主表：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物。
/// 名称、型号、规格、计量单位统一维护；品类差异通过扩展模型承载（如直线导轨规格）。
model Item {
  id            String          @id @default(cuid())
  code          String          @unique // InternalCode 内部编码（唯一）
  mnemonic      String? // 助记码
  name          String // 中文名称
  itemType      ItemType        @default(FINISHED_GOOD) // 分类枚举（CTO #2075：10 类）
  // 五级层级（CTO #2075）：Level1 Category → Level2 SubCategory → Level3 Series → Level4 Model → Level5 Variant
  categoryId    String? // Level2 SubCategory（ItemCategory 树叶子）
  category      ItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series        String? // Level3 系列（如 SM）
  model         String? // Level4 型号（如 SMH45A）
  variant       String? // Level5 变型（如 SMH45A-R1515-Z0）
  spec          String? // 规格描述（简要）
  brand         String? // 品牌
  manufacturer  String? // 制造商
  // Identification（CTO #2075）：CustomerCode/SupplierCode 由 SupplierItem（+Sprint 4 CustomerItem）承载
  oemCode       String? // OEM 编码
  barcode       String? // 条码
  qrCode        String? // 二维码内容
  drawingNo     String? // 图号（关联 File Center attachmentType=DRAWING）
  drawingVersion String? // 图纸版本
  revision      String? // 技术版本标识（如 A/B/1.0）
  // 生命周期与系统状态（CTO #2075：两者分离）
  lifecycle     ItemLifecycle? // 产品生命周期（DESIGN/TRIAL/MASS_PRODUCTION/DISCONTINUED/OBSOLETE）
  status        ItemStatus      @default(ACTIVE) // 系统状态（ACTIVE/INACTIVE/LOCKED/ARCHIVED）
  obsolete      Boolean         @default(false) // 停产标记（兼容）
  replacementItemId String? // 替代料
  replacementItem Item?          @relation("ItemReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  replacedBy    Item[]          @relation("ItemReplacement")
  minPackQty    Decimal?        @db.Decimal(14, 2) // 最小包装
  procurementLeadTime Int? // 采购周期（天）
  moq           Decimal?        @db.Decimal(14, 2) // MOQ
  safetyStock   Decimal?        @db.Decimal(14, 2) // 安全库存
  // 多 UOM（CTO #2075：Stock/Purchase/Sales + Conversion）
  unitId        String? // 兼容默认单位
  unit          UnitOfMeasure?  @relation("ItemUnit", fields: [unitId], references: [id], onDelete: SetNull)
  stockUomId    String? // 库存单位
  stockUom      UnitOfMeasure?  @relation("ItemStockUom", fields: [stockUomId], references: [id], onDelete: SetNull)
  purchaseUomId String? // 采购单位
  purchaseUom   UnitOfMeasure?  @relation("ItemPurchaseUom", fields: [purchaseUomId], references: [id], onDelete: SetNull)
  salesUomId    String? // 销售单位
  salesUom      UnitOfMeasure?  @relation("ItemSalesUom", fields: [salesUomId], references: [id], onDelete: SetNull)
  // 业务开关
  isSalable       Boolean @default(true) // 可销售
  isPurchasable   Boolean @default(true) // 可采购
  isManufacturable Boolean @default(false) // 可生产
  description   String?
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  linearGuide   LinearGuideSpecification?
  standards     ItemStandard[]
  priceListItems PriceListItem[]
  projectProducts ProjectProduct[]
  specifications ItemSpecification[]
  uomConversions UomConversion[]
  costs          ItemCost[]
  supplierItems  SupplierItem[]
  revisions      ItemRevision[]
  tags           ItemTag[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([model])
  @@index([mnemonic])
  @@index([itemType])
  @@index([categoryId])
  @@index([replacementItemId])
  @@index([deletedAt])
}

/// 直线导轨专用扩展规格（关联 Item，1:1）。
model LinearGuideSpecification {
  id                 String   @id @default(cuid())
  itemId             String   @unique
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  series             String? // 系列（SG/SM/SR/SV）
  slideBlockType     String? // 滑块型式
  railType           String? // 导轨型式
  interchangeability String? // 互换性
  precisionGrade     String? // 精度等级
  preload            String? // 预压力
  railLength         Decimal? @db.Decimal(12, 2) // 导轨长度 mm
  ratedDynamicLoad   Decimal? @db.Decimal(12, 2) // 额定动负荷 kN
  ratedStaticLoad    Decimal? @db.Decimal(12, 2) // 额定静负荷 kN
  ratedMoment        Json? // 额定力矩（MR/MP/MY）
  lubrication        String? // 润滑
  dustProtection     String? // 防尘
  material           String? // 材质
  hardness           String? // 硬度
  mountingType       String? // 安装方式
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

/// 技术标准主数据（如 GB/T、ISO）
model TechnicalStandard {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int            @default(1)
  deletedAt   DateTime?
  items       ItemStandard[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// Item 与 TechnicalStandard 的多对多关联
model ItemStandard {
  id         String            @id @default(cuid())
  itemId     String
  item       Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  standardId String
  standard   TechnicalStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([itemId, standardId])
  @@index([standardId])
}

/// 统一往来单位：客户 / 供应商 / 客户兼供应商。
model BusinessPartner {
  id                  String         @id @default(cuid())
  code                String         @unique // 内部编码
  mnemonic            String? // 助记码
  name                String // 中文名称
  type                PartnerType    @default(SUPPLIER)
  uscc                String?        @unique // 统一社会信用代码
  taxpayerType        String? // 纳税人类型（一般纳税人/小规模纳税人）
  legalRepresentative String? // 法定代表人
  registeredAddress   String? // 注册地址
  invoiceInfo         Json? // 开票信息
  bankName            String? // 开户银行
  bankAccount         String? // 银行账号
  settlementTerms     String? // 结算条款
  shortName            String? // 客户简称
  fullName             String? // 客户全称
  groupName            String? // 集团名称
  region               String? // 所属区域
  industry             String? // 所属行业
  companySize          String? // 企业规模
  creditRating         String? // 信用等级
  sourceChannel        String? // 来源渠道
  foundedDate          DateTime? // 成立日期
  registeredCapital    Decimal?      @db.Decimal(14, 2) // 注册资本（万元）
  employeeCount        Int? // 员工人数
  website              String? // 官网
  wechatOfficialAccount String? // 微信公众号
  tags                 Json? // 企业标签
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  isActive            Boolean        @default(true)
  createdById         String?
  updatedById         String?
  approvedById        String?
  approvalStatus      ApprovalStatus @default(DRAFT)
  version             Int            @default(1)
  deletedAt           DateTime?
  opportunities       ProjectOpportunity[]
  projects            Project[]
  customers           Customer[]
  roles               BusinessPartnerRole[]
  partnerContacts     PartnerContact[]
  partnerAddresses    PartnerAddress[]
  partnerTags         PartnerTag[]
  partnerBankAccounts PartnerBankAccount[]
  partnerCredit       PartnerCredit?
  suppliers           Supplier[]
  supplierItems       SupplierItem[]
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([mnemonic])
  @@index([type])
  @@index([deletedAt])
}

/// 价格表主数据。币种默认 CNY；税率默认由配置（DEFAULT_TAX_RATE）提供，不在代码写死。
model PriceList {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  priceType       PriceType       @default(SALES) // 价格类型
  currency        String          @default("CNY")
  validFrom       DateTime? // 报价有效期起
  validTo         DateTime? // 报价有效期止
  freightIncluded Boolean         @default(false) // 是否含运费
  isActive        Boolean         @default(true)
  createdById     String?
  updatedById     String?
  approvedById    String?
  approvalStatus  ApprovalStatus  @default(DRAFT)
  version         Int             @default(1)
  deletedAt       DateTime?
  items           PriceListItem[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 价格表明细：未税价 / 税率 / 税额 / 含税价 / 最小起订量 / 阶梯价
model PriceListItem {
  id               String        @id @default(cuid())
  priceListId      String
  priceList        PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPriceExclTax Decimal       @db.Decimal(14, 4) // 未税价
  taxRate          Decimal       @db.Decimal(5, 2) // 税率 %（默认值来自配置）
  taxAmount        Decimal       @db.Decimal(14, 4) // 税额
  unitPriceInclTax Decimal       @db.Decimal(14, 4) // 含税价
  minOrderQty      Decimal?      @db.Decimal(14, 2) // 最小起订量
  tieredPricing    Json? // 阶梯价（如 [{qty, price}])
  isActive         Boolean       @default(true)
  createdById      String?
  updatedById      String?
  approvedById     String?
  approvalStatus   ApprovalStatus @default(DRAFT)
  version          Int           @default(1)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([priceListId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 商业条款主数据（如 EXW/FOB/CIF/月结30天）
model CommercialTerm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 单据序列主数据（销售订单/采购订单/报价单等编号规则）
model DocumentSequence {
  id          String   @id @default(cuid())
  code        String   @unique // 单据类型编码
  name        String
  docType     DocumentType // 单据类型（枚举）
  prefix      String?
  nextNo      Int      @default(1)
  padLength   Int      @default(4)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

// ============================================================
// Sprint 2B：项目机会与项目执行领域（中国工业项目制业务）
// 阶段：线索 → 准入 → 方案 → 报价 → 试样 → 测试 → 小批量 → 批量供货 → 暂停/失败/结项
// ============================================================

/// 项目阶段：线索 / 准入 / 方案 / 报价 / 试样 / 测试 / 小批量 / 批量供货 / 暂停 / 失败 / 结项
enum ProjectStage {
  LEAD // 线索
  QUALIFIED // 准入
  SOLUTION // 方案
  QUOTATION // 报价
  SAMPLING // 试样
  TESTING // 测试
  SMALL_BATCH // 小批量
  MASS_SUPPLY // 批量供货
  PAUSED // 暂停
  FAILED // 失败
  CLOSED // 结项
}

/// 项目关系人角色：需求人 / 技术人 / 采购人 / 决策人 / 使用人
enum StakeholderRole {
  REQUESTER // 需求人
  TECHNICAL // 技术人
  PURCHASER // 采购人
  DECISION_MAKER // 决策人
  END_USER // 使用人
}

/// 回款状态：未回款 / 部分回款 / 已回款 / 逾期
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

/// 里程碑状态：计划中 / 进行中 / 已完成 / 已延期
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

/// 任务状态：待办 / 进行中 / 已完成 / 已取消
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// 风险状态：开启 / 应对中 / 已关闭
enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

/// 走访/沟通类型：走访 / 电话 / 视频 / 会议 / 其他
enum VisitType {
  VISIT
  PHONE
  VIDEO
  MEETING
  OTHER
}

/// 验收结果：通过 / 有条件通过 / 不通过 / 待验收
enum AcceptanceResult {
  PASSED
  CONDITIONAL_PASS
  FAILED
  PENDING
}

/// 项目机会（线索/准入/方案/报价阶段）。
/// 承载客户投入、预计营收/成本/毛利、费用预算、销售目标、回款状态、竞争对手、成功概率。
model ProjectOpportunity {
  id                 String           @id @default(cuid())
  code               String           @unique // 机会编号（用 DocumentSequence 生成）
  name               String // 机会名称
  customerId         String
  customer           BusinessPartner  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage     @default(LEAD)
  customerInvestment Decimal?         @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?         @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?         @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?         @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?         @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?         @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus    @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手（[{name, note}]）
  successProbability Decimal?         @db.Decimal(5, 2) // 成功概率 %
  ownerId            String? // 负责人
  description        String?
  project            Project?
  isActive           Boolean          @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus   @default(DRAFT)
  version            Int              @default(1)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目（试样/测试/小批量/批量供货/暂停/失败/结项阶段）。
model Project {
  id                 String              @id @default(cuid())
  code               String              @unique // 项目编号（用 DocumentSequence 生成）
  name               String // 项目名称
  opportunityId      String?           @unique // 关联的项目机会（可空，1:1）
  opportunity        ProjectOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerId         String
  customer           BusinessPartner     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage        @default(SAMPLING)
  customerInvestment Decimal?            @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?            @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?            @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?            @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?            @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?            @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus       @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手
  successProbability Decimal?            @db.Decimal(5, 2) // 成功概率 %
  expectedContractAmount Decimal?        @db.Decimal(14, 2) // 预计合同金额
  expectedProfit Decimal?                 @db.Decimal(14, 2) // 预计利润
  expectedGrossMarginRate Decimal?        @db.Decimal(5, 2) // 预计毛利率 %
  receivedAmount Decimal?                 @db.Decimal(14, 2) // 回款金额
  invoicedAmount Decimal?                  @db.Decimal(14, 2) // 已开发票金额
  uninvoicedAmount Decimal?                @db.Decimal(14, 2) // 未开发票金额
  receivableBalance Decimal?               @db.Decimal(14, 2) // 应收余额
  projectRating String? // 项目评级
  failureReason String? // 失败原因
  ownerId            String? // 项目负责人
  description        String?
  stakeholders       ProjectStakeholder[]
  members            ProjectMember[]
  milestones         ProjectMilestone[]
  tasks              ProjectTask[]
  budgets            ProjectBudget[]
  expenses           ProjectExpense[]
  products           ProjectProduct[]
  risks              ProjectRisk[]
  visits             ProjectVisit[]
  progresses         ProjectProgress[]
  acceptances        ProjectAcceptance[]
  closure            ProjectClosure?
  isActive           Boolean             @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus      @default(DRAFT)
  version            Int                 @default(1)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目关系人：需求人 / 技术人 / 采购人 / 决策人 / 使用人。
model ProjectStakeholder {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        StakeholderRole
  name        String // 姓名
  title       String? // 职务
  department  String?
  phone       String?
  email       String?
  note        String?
  isActive    Boolean         @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([role])
  @@index([deletedAt])
}

/// 项目成员（内部团队）。
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String? // 关联系统用户（可空，允许未建账号成员）
  name        String // 姓名
  roleInProject String? // 项目内角色（如：项目经理/技术负责/销售）
  joinedAt    DateTime?
  leftAt      DateTime?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目里程碑（含交付成果与延期原因）。
model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String // 里程碑名称
  plannedDate   DateTime? // 计划日期
  actualDate    DateTime? // 实际日期
  status        MilestoneStatus @default(PLANNED)
  deliverable   String? // 交付成果
  delayReason   String? // 延期原因
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目任务。
model ProjectTask {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String? // 关联里程碑（可空）
  name        String // 任务名称
  assigneeId  String? // 负责人
  dueDate     DateTime?
  status      TaskStatus  @default(TODO)
  priority    String? // 高/中/低
  description String?
  isActive    Boolean     @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([milestoneId])
  @@index([deletedAt])
}

/// 项目预算（按科目）。
model ProjectBudget {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String // 预算科目（如：差旅/招待/测试/试样）
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("CNY")
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目费用（实际支出）。
model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String // 费用科目
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("CNY")
  incurredAt  DateTime?
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目产品（项目涉及的产品/物料，关联 Item 主数据）。
model ProjectProduct {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Decimal? @db.Decimal(14, 2) // 数量
  unitPrice   Decimal? @db.Decimal(14, 4) // 单价
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 项目风险（含应对方案、责任人、关闭状态）。
model ProjectRisk {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String // 风险描述
  impact      String? // 影响
  probability String? // 概率（高/中/低）
  mitigation  String? // 应对方案
  ownerId     String? // 责任人
  status      RiskStatus @default(OPEN)
  closedAt    DateTime?
  isActive    Boolean    @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int        @default(1)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 客户走访与沟通记录（支持下次行动与提醒）。
model ProjectVisit {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitType   VisitType @default(VISIT)
  visitedAt   DateTime  @default(now())
  visitorId   String? // 走访人
  contactName String? // 客户联系人
  summary     String // 沟通纪要
  nextAction  String? // 下次行动
  reminderAt  DateTime? // 提醒时间
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目进展记录。
model ProjectProgress {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedAt      DateTime @default(now())
  progressPercent Decimal  @db.Decimal(5, 2) // 进度百分比
  summary         String // 进展说明
  isActive        Boolean  @default(true)
  createdById     String?
  updatedById     String?
  approvedById    String?
  approvalStatus  ApprovalStatus @default(DRAFT)
  version         Int      @default(1)
  deletedAt       DateTime?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目验收（含验收结果）。
model ProjectAcceptance {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // 验收项
  expectedDate DateTime?
  actualDate  DateTime?
  result      AcceptanceResult @default(PENDING)
  resultNote  String? // 验收结果说明
  isActive    Boolean          @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int              @default(1)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目结项（1:1）。
model ProjectClosure {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedAt    DateTime @default(now())
  reason      String // 结项原因
  summary     String? // 结项总结
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Workflow Foundation（工作流底座）
// CTO directive: Workflow（定义流程）与 Approval（执行审批）解耦；统一审计字段；
// 所有引用关系明确 onDelete；枚举集中管理。
// ============================================================================

/// 工作流状态：草稿 / 已启用 / 已归档
enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// 审批方式：串签 / 会签 / 或签 / 会签(多人全签)
enum ApprovalMode {
  SEQUENTIAL // 串签
  PARALLEL // 会签（多人并行，全部通过）
  ANY_ONE // 或签（任一通过）
  COUNTERSIGN // 会签（指定人数）
}

/// 审批人类型：用户 / 角色 / 部门 / 审批组
enum ApproverType {
  USER
  ROLE
  DEPARTMENT
  APPROVER_GROUP
}

/// 工作流动作：统一动作，业务模块不各自实现
enum WorkflowActionType {
  SUBMIT // 提交
  APPROVE // 审批通过
  REJECT // 驳回
  RETURN // 退回
  TRANSFER // 转交
  DELEGATE // 委托
  WITHDRAW // 撤销
  TERMINATE // 终止
  COMMENT // 评论
}

/// 条件操作符（与业务字段组合，如 amount > 100000）
enum ConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  CONTAINS
}

/// 工作流实例状态：运行中 / 已完成 / 已驳回 / 已终止 / 已撤销
enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  REJECTED
  TERMINATED
  WITHDRAWN
}

/// 审批人处理状态
enum ApproverStatus {
  PENDING // 待处理
  APPROVED // 已通过
  REJECTED // 已驳回
  DELEGATED // 已委托
  SKIPPED // 已跳过
}

/// 工作流定义（流程模板）。所有业务模块（报价/合同/采购/付款/费用）引用这里，禁止写死流程。
model WorkflowDefinition {
  id          String         @id @default(cuid())
  code        String         @unique // 工作流编码（如 QUOTATION_APPROVAL）
  name        String // 工作流名称
  module      String // 所属模块（quotation/contract/purchase/payment/expense/custom）
  version     Int            @default(1) // 流程版本
  status      WorkflowStatus @default(DRAFT)
  description String?
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([module])
  @@index([status])
  @@index([deletedAt])
}

/// 工作流步骤（节点）。
model WorkflowStep {
  id            String         @id @default(cuid())
  definitionId  String
  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  stepNo        Int // 步骤序号
  stepName      String // 步骤名称
  approverType  ApproverType   @default(USER) // 审批人类型
  approverValue String? // 审批人值（用户ID/角色编码/部门ID/审批组ID）
  approvalMode  ApprovalMode   @default(SEQUENTIAL) // 审批方式
  timeoutHours  Int? // 超时时间（小时）
  allowReject   Boolean        @default(true) // 允许驳回
  allowTransfer Boolean        @default(false) // 允许转交
  allowDelegate Boolean        @default(false) // 允许委托
  allowWithdraw Boolean        @default(false) // 允许撤销
  conditions    WorkflowCondition[]
  isActive      Boolean        @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int            @default(1)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([definitionId, stepNo])
  @@index([definitionId])
  @@index([deletedAt])
}

/// 工作流条件（结构化，不存 JSON）：field + operator + value
model WorkflowCondition {
  id          String          @id @default(cuid())
  stepId      String
  step        WorkflowStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  expression  String? // 组合表达式（如 A AND B）
  field       String // 字段名（amount/department/currency 等）
  operator    ConditionOperator // 操作符
  value       String // 比较值（如 100000/Sales/CNY）
  isActive    Boolean         @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([stepId])
  @@index([deletedAt])
}

/// 工作流实例（真正业务实例，如某张报价单的审批流）。
model WorkflowInstance {
  id           String          @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  businessType String // 业务类型（quotation/sales-order/purchase-order/expense 等）
  businessId   String // 业务单据 ID
  currentStepNo Int? // 当前步骤
  startedBy    String // 发起人
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  status       WorkflowInstanceStatus @default(RUNNING) // 实例状态
  actions      WorkflowAction[]
  history      WorkflowHistory[]
  approvers    Approver[]
  escalations  ApprovalEscalation[]
  timeouts     ApprovalTimeout[]
  reminders    ApprovalReminder[]
  isActive     Boolean         @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version      Int             @default(1)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([businessType, businessId])
  @@index([definitionId])
  @@index([startedBy])
  @@index([status])
  @@index([deletedAt])
}

/// 工作流动作（统一动作记录）。
model WorkflowAction {
  id          String            @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actionType  WorkflowActionType // 动作类型
  actorId     String // 操作人
  targetUserId String? // 转交/委托目标
  stepNo      Int? // 所属步骤
  comment     String? // 备注
  isActive    Boolean           @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int               @default(1)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([actorId])
  @@index([deletedAt])
}

/// 工作流历史（一次做到位，与 Audit 共用字段）。
model WorkflowHistory {
  id           String            @id @default(cuid())
  instanceId   String
  instance     WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo       Int?
  actionType   WorkflowActionType
  beforeStatus String? // 前状态
  afterStatus  String? // 后状态
  actorId      String? // 操作人
  ip           String? // IP
  device       String? // 设备
  browser      String? // 浏览器
  remark       String? // 备注
  attachment   String? // 附件
  duration     Int? // 耗时（秒）
  isActive     Boolean           @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version      Int               @default(1)
  deletedAt    DateTime?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([actorId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Approval Engine（审批执行，与 Workflow 解耦）
// Workflow 定义流程；Approval 执行审批。两个领域。
// ============================================================================

/// 审批人（实例级：每个审批步骤的实际处理人）
model Approver {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int // 步骤
  userId      String // 审批人
  status      ApproverStatus  @default(PENDING) // 处理状态
  delegatedFrom String? // 委托来源
  decidedAt   DateTime?
  comment     String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([userId])
  @@index([deletedAt])
}

/// 审批组（可复用审批人集合，如"销售总监组"）
model ApproverGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  members     ApproverGroupMember[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 审批组成员
model ApproverGroupMember {
  id          String   @id @default(cuid())
  groupId     String
  group       ApproverGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([deletedAt])
}

/// 委托规则（用户→用户）
model ApprovalDelegate {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([deletedAt])
}

/// 升级规则（超时/未处理 → 升级到上级）
model ApprovalEscalation {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  thresholdHours Int // 超时阈值（小时）
  escalateToUserId String? // 升级到
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

/// 超时规则（实例级）
model ApprovalTimeout {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  timeoutHours Int
  actionOnTimeout WorkflowActionType @default(TERMINATE) // 超时动作
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

/// 提醒规则（催办）
model ApprovalReminder {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  intervalHours Int // 提醒间隔（小时）
  maxTimes    Int      @default(3)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Notification（统一事件中心）
// ============================================================================

/// 通知渠道类型
enum NotificationChannelType {
  SYSTEM
  EMAIL
  TELEGRAM
  WEBHOOK
  WECHAT // 预留
  DINGTALK // 预留
}

/// 通知状态
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

/// 通知模板
model NotificationTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  channel     NotificationChannelType @default(SYSTEM)
  subject     String? // 标题
  content     String // 内容（支持变量占位）
  messages    NotificationMessage[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 通知消息
model NotificationMessage {
  id          String   @id @default(cuid())
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientUserId String? // 收件人
  channel     NotificationChannelType @default(SYSTEM)
  subject     String?
  content     String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  readAt      DateTime?
  error       String?
  logs        NotificationLog[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([recipientUserId])
  @@index([status])
  @@index([deletedAt])
}

/// 通知渠道配置（预留 webhook/企业微信/钉钉）
model NotificationChannel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  channelType NotificationChannelType @default(SYSTEM)
  config      Json? // 渠道配置（webhook url/token 等）
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 通知发送日志
model NotificationLog {
  id          String   @id @default(cuid())
  messageId   String?
  message     NotificationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  channel     NotificationChannelType
  status      NotificationStatus
  payload     Json?
  error       String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([messageId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Dictionary（字典管理）
// ============================================================================

/// 字典类型
model DictionaryType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String? // 分类
  language    String   @default("zh-CN") // 语言
  sort        Int      @default(0)
  icon        String? // 图标
  color       String? // 颜色
  enabled     Boolean  @default(true)
  items       DictionaryItem[]
