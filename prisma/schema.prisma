/// 信用（Partner 级共享：AR/AP 统一）
model PartnerCredit {
  id          String              @id @default(cuid())
  partnerId   String              @unique
  partner     BusinessPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  creditLimit Decimal?            @db.Decimal(18, 2) // 信用额度
  usedCredit  Decimal             @default(0) @db.Decimal(18, 2) // 已用额度
  rating      CustomerCreditRating @default(B)
  status      CustomerCreditStatus @default(NORMAL)
  reviewDate  DateTime? // 复核日期
  isActive    Boolean             @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus   @default(DRAFT)
  version     Int                 @default(1)
  deletedAt   DateTime?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 供应商（BusinessPartner 角色扩展，partnerId 必填 type=SUPPLIER/BOTH）
model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique // 供应商编码
  name          String
  partnerId     String   @unique
  partner       BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  status        SupplierStatus @default(POTENTIAL)
  rating        Int? // 1-5 星
  defaultLeadTime Int? // 默认交期（天）
  minOrderQty   Decimal? @db.Decimal(18, 2) // 最小起订量
  currency      String   @default("CNY")
  isPreferred   Boolean  @default(false)
  qualifications SupplierQualification[]
  certificates  SupplierCertificate[]
  settlements   SupplierSettlement[]
  purchaseOrders PurchaseOrder[] // 5A：采购订单（PurchaseOrder.supplierId 方向）
  purchaseReceipts PurchaseReceipt[] // 5B：收货单（PurchaseReceipt.supplierId 方向，快照自 PO）
  purchaseReturns PurchaseReturn[] // 5B：退货单（PurchaseReturn.supplierId 方向，快照自 PO）
  supplierInvoices SupplierInvoice[] // 5C-1：供应商发票（SupplierInvoice.supplierId 方向）
  apLiabilityFacts ApLiabilityFact[] // 5C-1：AP 应付债务事实（ApLiabilityFact.supplierId 方向）
  creditDebitNotes SupplierCreditDebitNote[] // 5C-2：供应商贷/借项（SupplierCreditDebitNote.supplierId 方向）
  payments SupplierPayment[] // 5C-2：供应商付款（SupplierPayment.supplierId 方向）
  isActive      Boolean  @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int      @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([code])
  @@index([status])
  @@index([deletedAt])
}

/// 供应商资质（认证/资质，含附件 FileId）
model SupplierQualification {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qualType    QualificationType
  qualName    String
  certNo      String?
  issueDate   DateTime?
  expireDate  DateTime?
  status      String   @default("VALID") // VALID/EXPIRING/EXPIRED
  attachment  String? // FileId（File Center）
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([supplierId])
  @@index([deletedAt])
}

/// 供应商证书
model SupplierCertificate {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  certType    String
  certName    String
  certNo      String?
  issueDate   DateTime?
  expireDate  DateTime?
  attachment  String? // FileId
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([supplierId])
  @@index([deletedAt])
}

/// 供应商结算（付款条款）
model SupplierSettlement {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  paymentTerms  String? // 付款条款（如 NET30）
  creditDays    Int? // 账期
  paymentMethod String? // TT/LC/DP/DA
  currency      String   @default("CNY")
