// ============ Sprint 3C-2 Supplier Foundation（BusinessPartner 唯一主体 + 共享模型）============

enum PartnerRoleType {
  CUSTOMER
  SUPPLIER
  BOTH
  LOGISTICS
  OUTSOURCING
}

enum SupplierStatus {
  POTENTIAL
  QUALIFIED
  PREFERRED
  SUSPENDED
  BLACKLISTED
}

enum QualificationType {
  BUSINESS_LICENSE
  ISO9001
  ISO14001
  IATF16949
  CE
  ROHS
  OTHER
}

enum PartnerAddressType {
  REGISTERED
  BILLING
  SHIPPING
  WAREHOUSE
  FACTORY
  INVOICING
  CONTACT
}

/// 往来单位角色（BusinessPartner 唯一主体，角色可无限扩展）
model BusinessPartnerRole {
