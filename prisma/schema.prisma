  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  salesOrderLines SalesOrderLine[]

  @@unique([quotationId, lineNo])
  @@index([quotationId])
  @@index([itemId])
  @@index([priceSnapshotId])
  @@index([deletedAt])
}

/// 报价修订（统一版本载体，删除 QuotationVersion）
