  industryId   String? // 所属行业
  industry     Industry?      @relation(fields: [industryId], references: [id], onDelete: SetNull)
  region       String? // 所属区域
  sourceChannel String? // 来源渠道
  companySize  String? // 企业规模
  foundedDate  DateTime? // 成立日期
  website      String? // 官网
  contacts     CustomerContact[]
  addresses    CustomerAddress[]
  tags         CustomerTag[]
  credit       CustomerCredit?
  isActive     Boolean         @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
