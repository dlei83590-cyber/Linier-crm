// Linier CRM Management System - Sprint 2 China Industrial Master Data schema (v2)
// CTO directive: unified Item model + BusinessPartner model for Chinese industrial enterprise.
// Master data foundation: Item / LinearGuideSpecification / BusinessPartner / PriceList /
// TechnicalStandard / ItemStandard / UnitOfMeasure / CommercialTerm / DocumentSequence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 物料分类：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物
/// 物料分类（CTO #2075：10 类，未来只加枚举值不加字段）
enum ItemType {
  FINISHED_GOOD // 成品
  RAW_MATERIAL // 原材料
  SEMI_FINISHED // 半成品
  PURCHASED_PART // 外购件
  ACCESSORY // 辅料/配件
  SERVICE // 服务
  CONSUMABLE // 消耗品
  ASSET // 资产
  TOOLING // 工装/模具
  PACKAGING // 包装材料
}

/// 生产入库单状态：草稿 / 已提交 / 已过账（产生库存效应）/ 已取消
enum ProductionInboundStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

/// 审核状态：草稿 / 待审核 / 已审核 / 已驳回
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// 往来单位类型：客户 / 供应商 / 客户兼供应商
enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

/// 价格类型（采购价/销售价/VIP/代理/工程/战略客户/区域价/客户专属价/历史价）
enum PriceType {
  PURCHASE // 采购价
  SALES // 销售价
  VIP // VIP 价
  AGENT // 代理价
  ENGINEERING // 工程价
  STRATEGIC // 战略客户价
  REGIONAL // 区域价
  CUSTOMER // 客户专属价
  HISTORICAL // 历史价
}

/// 价格策略类型（CTO #2204/#2225：独立建模，不写死在 PriceList）
enum PricePolicyType {
  STANDARD   // 标准价
  VIP        // VIP 价
  PROJECT    // 项目价
  DEALER     // 经销商价
  REGIONAL   // 区域价
  PROMOTION  // 促销价
}

/// 价目表版本状态（CTO #2204：Draft/Published/Archived，报价可追溯）
enum PriceListStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 税率类型（CTO #2204/#2225：0%/6%/13%/免税/自定义；9% = 中国审计 P2，ADR-0043）
enum TaxRateType {
  ZERO      // 0%
  SIX       // 6%
  THIRTEEN  // 13%
  EXEMPT    // 免税
  CUSTOM    // 自定义
  NINE      // 9%（交通运输/建筑/不动产租赁/农产品）
}

/// 增值税发票类型（中国市场；中国审计 P1，ADR-0043）
enum InvoiceInvoiceType {
  SPECIAL_VAT    // 增值税专用发票（一般纳税人开具；购买方可抵扣进项）
  ORDINARY_VAT   // 增值税普通发票（购买方不可抵扣进项）
  ELECTRONIC_VAT // 数电票（全电发票；20 位号码，无 12 位代码）
  EXPORT         // 出口发票（零税率/免税场景）
  OTHER          // 其他（非增值税单据：内部凭证/形式凭证）
}

/// 纳税人类型（中国市场；替代 BusinessPartner.taxpayerType 自由文本，ADR-0043）
enum InvoiceTaxpayerType {
  GENERAL_VAT_PAYER // 一般纳税人
  SMALL_SCALE       // 小规模纳税人
}

/// 开票资料（税务发票要素；1:1 挂 BusinessPartner；中国审计 P1-4/P1-5，ADR-0043）
model BusinessPartnerInvoiceInfo {
  id             String   @id @default(cuid())
  partnerId      String   @unique
  partner        BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title          String   // 发票抬头（MUST = 营业执照企业全称）
  uscc           String   // 统一社会信用代码（MUST 18 位，GB 32100-2015）
  taxpayerType   InvoiceTaxpayerType @default(GENERAL_VAT_PAYER)
  registeredAddress String? // 注册地址（税务发票要素）
  registeredPhone  String? // 注册电话（税务发票要素）
  bankName         String? // 开户银行（税务发票要素；开票账户 ≠ 收款账户）
  bankAccountNo    String? // 银行账号（税务发票要素）
  // 审计字段（对齐既有模式）
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT) // 变更走 maker-checker（复用 BusinessPartner 审批投影）
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([partnerId])
}

/// 价格来源（CTO #2225：BI 分析价格来源）
enum PriceSource {
  MANUAL    // 手工
  IMPORT    // 导入
  FORMULA   // 公式计算
  PROMOTION // 促销
  SUPPLIER  // 供应商
  MARKET    // 市场行情
}

/// 价格匹配策略（CTO #2249：priority 不够，需策略）
enum PriceMatchStrategy {
  FIRST_MATCH      // 第一条命中即停止
  BEST_PRICE       // 最优价（业务定义）
  LOWEST_PRICE     // 最低价
  HIGHEST_PRIORITY // 最高优先级
  COMBINE          // 多规则叠加
}

/// 促销类型（CTO #2225：PromotionRule 独立模型）
enum PromotionType {
  PERCENT // 折扣百分比
  AMOUNT  // 固定金额
}

/// 汇率类型（CTO #2345：央行/ERP/人工可区分）
enum ExchangeRateType {
  CENTRAL_BANK // 央行
  BANK         // 银行
  MANUAL       // 人工
}

/// 价格规则类型（CTO #2345：PriceRule 独立，Pricing Engine 直接执行）
enum PriceRuleType {
  CUSTOMER_LEVEL // 客户等级
  REGION         // 区域
  QUANTITY_BREAK // 数量阶梯
  BRAND          // 品牌
  PROJECT_TYPE   // 项目类型
  CURRENCY       // 币种
  CHANNEL        // 渠道
}

/// 物料生命周期（CTO #2075：产品生命周期，与 ItemStatus 系统状态分离）
enum ItemLifecycle {
  DESIGN // 设计
  TRIAL // 试产
  MASS_PRODUCTION // 量产
  DISCONTINUED // 停产
  OBSOLETE // 淘汰
}

/// 物料系统状态（CTO #2075：是否允许使用，与 Lifecycle 分离）
enum ItemStatus {
  ACTIVE // 可用
  INACTIVE // 停用
  LOCKED // 锁定（不允许变更）
  ARCHIVED // 归档（只读）
}

/// 物料成本类型（CTO #2075：只建接口不写算法，Finance 引用）
enum ItemCostType {
  STANDARD // 标准成本
  LAST_PURCHASE // 最近采购价
  AVERAGE // 移动平均
  CURRENT // 现行成本
}

/// 附件类型（CTO #2075：统一放 File Center，Project/Supplier/Customer/Quotation 共用）
enum AttachmentType {
  DRAWING // 图纸
  CERTIFICATE // 证书
  PHOTO // 照片
  MANUAL // 手册
  MODEL_3D // 3D 模型
  VIDEO // 视频
  INSPECTION_REPORT // 检验报告
}

/// 单据类型（报价/SO/PO/PI/CI/DO/GRN/GI/发票/贷项/借项/付款/收款/费用/日记账/合同/项目）
enum DocumentType {
  QUOTATION // 报价单
  SALES_ORDER // 销售订单 SO
  PURCHASE_ORDER // 采购订单 PO
  PURCHASE_REQUISITION // 采购申请 PR（Sprint 5A 新增）
  PROFORMA_INVOICE // 形式发票 PI
  COMMERCIAL_INVOICE // 商业发票 CI
  DELIVERY_ORDER // 送货单 DO
  GOODS_RECEIPT_NOTE // 收货单 GRN
  GOODS_ISSUE // 出库单 GI
  INVOICE // 发票
  CREDIT_NOTE // 贷项通知单
  DEBIT_NOTE // 借项通知单
  PAYMENT_VOUCHER // 付款凭证
  RECEIPT // 收款收据
  WRITE_OFF // 坏账/折让写销（Sprint 4E-2）
  EXPENSE // 费用报销
  JOURNAL // 日记账
  CONTRACT // 合同
  PROJECT // 项目
  PURCHASE_RECEIPT // 采购收货单 REC（Sprint 5B 新增）
  WAREHOUSE_RECEIPT // 采购入库单 WHR（Sprint 5B 新增）
  PURCHASE_RETURN // 采购退货单 PRT（Sprint 5B 新增）
  INVENTORY_MOVEMENT // 库存流水 MV（Sprint 6A 新增）
  INVENTORY_TRANSFER // 调拨单 TRF（Sprint 6B 新增）
  STOCK_COUNT // 盘点单 CNT（Sprint 6B 新增）
  INVENTORY_ADJUSTMENT // 库存调整单 ADJ（Sprint 6B 新增）
  INVENTORY_CONVERSION // 库存转换单 CVT（Sprint 6B 新增，同 item Repack / UOM Conversion）
  SUPPLIER_INVOICE // 供应商发票 SINV（Sprint 5C-1 新增；DocumentSequence docType=SUPPLIER_INVOICE，创建即取号 P1 Final，缺失 fail closed）
  SUPPLIER_CREDIT_NOTE // 供应商贷项通知单 SCN（Sprint 5C-2 新增；AP 侧冲减，5C-2 创建即取号）
  SUPPLIER_DEBIT_NOTE // 供应商借项通知单 SDN（Sprint 5C-2 新增；AP 侧增加，5C-2 创建即取号）
}

/// Platform user account. Identity and credential record.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  isActive     Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  auditLogs    AuditLog[]
  purchaseRequisitions PurchaseRequisition[] // 5A：采购申请（requesterId 方向）
  purchaseOrders PurchaseOrder[] // 5A：采购订单（purchaserId 方向，采购员；CTO Phase 4B 指令）
  receivedPurchaseReceipts PurchaseReceipt[] // 5B：收货单（receivedById 方向，收货员）
  inspectedInspections Inspection[] // 5B：检验（inspectedById 方向，质检员）
  postedWarehouseReceipts WarehouseReceipt[] @relation("WarehouseReceiptPostedBy") // 5B：入库单（postedById 方向，过账人 D10）
  returnedPurchaseReturns PurchaseReturn[] // 5B：退货单（returnedById 方向，经办人）
  committedInventoryMovements InventoryMovement[] @relation("InventoryMovementCommittedBy") // 6A：库存流水（committedById 方向）
  approvedTransfers InventoryTransfer[] @relation("TransferApprovedBy") // 6B：调拨单审批人（InventoryTransfer.approvedById 方向）
  executedTransfers InventoryTransfer[] @relation("TransferExecutedBy") // 6B：调拨单执行人（InventoryTransfer.executedById 方向）
  countedStockCounts StockCount[] @relation("StockCountCountedBy") // 6B：盘点单盘点人（StockCount.countedById 方向）
  approvedAdjustments InventoryAdjustment[] @relation("AdjustmentApprovedBy") // 6B：调整单审批人（InventoryAdjustment.approvedById 方向）
  appliedAdjustments InventoryAdjustment[] @relation("AdjustmentAppliedBy") // 6B：调整单 Apply 人（InventoryAdjustment.appliedById 方向）
  executedConversions InventoryConversion[] @relation("ConversionExecutedBy") // 6B：转换单执行人（InventoryConversion.executedById 方向）
  postedSupplierInvoices SupplierInvoice[] @relation("SupplierInvoicePostedBy") // 5C-1：供应商发票过账人（SupplierInvoice.postedById 方向）
  ranMatchRuns SupplierInvoiceMatchRun[] // 5C-1：匹配 Run 执行人（SupplierInvoiceMatchRun.runById 方向）
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([email])
  @@index([departmentId])
}

/// Organizational unit users belong to.
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  users     User[]
  purchaseRequisitions PurchaseRequisition[] // 5A：采购申请（departmentId 方向）
  purchaseOrders PurchaseOrder[] // 5A：采购订单（departmentId 方向，采购部门；CTO Phase 4B 指令）
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

/// Named role that bundles permissions (e.g. ADMIN, MANAGER, MEMBER, VIEWER).
model Role {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       UserRole[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([code])
}

/// Atomic capability, grouped by module (e.g. user:read, item:write).
model Permission {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  module      String
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([module, code])
}

/// Explicit many-to-many link between User and Role.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Immutable trail of security-sensitive and destructive actions.
/// 审计结果
enum AuditResult {
  SUCCESS
  FAILURE
  PARTIAL
}

/// 审计日志（Sprint 3B 升级：ObjectType/ObjectId/Before/AfterData/RequestId/TraceId/IP/Device/Browser/Duration/Result）
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String // ObjectType（如 workflow-definition）
  entityId   String? // ObjectId
  beforeData Json? // 操作前数据快照
  afterData  Json? // 操作后数据快照
  requestId  String? // 请求 ID（链路追踪）
  traceId    String? // 追踪 ID（全链路）
  meta       Json?
  ipAddress  String? // IP
  device     String? // 设备（mobile/desktop）
  browser    String? // 浏览器 UA 摘要
  duration   Int? // 耗时（毫秒）
  result     AuditResult @default(SUCCESS) // 操作结果
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([traceId])
  @@index([result])
  @@index([createdAt])
}

/// 计量单位主数据（如：kg、m、件、套）
model UnitOfMeasure {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  symbol        String?
  isActive      Boolean  @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int      @default(1)
  deletedAt     DateTime?
  items         Item[]          @relation("ItemUnit")
  stockItems    Item[]          @relation("ItemStockUom")
  purchaseItems Item[]          @relation("ItemPurchaseUom")
  salesItems    Item[]          @relation("ItemSalesUom")
  fromConversions UomConversion[] @relation("UomConversionFrom")
  toConversions   UomConversion[] @relation("UomConversionTo")
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  deliveryLines   DeliveryLine[]
  invoiceLines    InvoiceLine[]
  creditDebitNoteLines CreditDebitNoteLine[] // 4E-3：调整单明细（CreditDebitNoteLine.uom 方向）
  purchaseRequisitionLines PurchaseRequisitionLine[] // 5A：采购申请行（PurchaseRequisitionLine.uom 方向）
  purchaseOrderLines PurchaseOrderLine[] // 5A：采购订单行（PurchaseOrderLine.uom 方向）
  purchaseReceiptLines PurchaseReceiptLine[] // 5B：收货行（PurchaseReceiptLine.uom 方向）
  warehouseReceiptLines WarehouseReceiptLine[] // 5B：入库行（WarehouseReceiptLine.uom 方向）
  purchaseReturnLines PurchaseReturnLine[] // 5B：退货行（PurchaseReturnLine.uom 方向）
  inventoryMovements InventoryMovement[] // 6A：库存流水（InventoryMovement.uom 方向）
  transferLines InventoryTransferLine[] // 6B：调拨行（InventoryTransferLine.uom 方向）
  adjustmentLines InventoryAdjustmentLine[] // 6B：调整行（InventoryAdjustmentLine.uom 方向）
  conversionLines InventoryConversionLine[] // 6B：转换行（InventoryConversionLine.uom 方向）
  conversionBaseUoms InventoryConversion[] @relation("ConversionBaseUom") // 6B：转换单 base UOM（InventoryConversion.baseUom 方向）
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 统一物料主表：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物。
/// 名称、型号、规格、计量单位统一维护；品类差异通过扩展模型承载（如直线导轨规格）。
model Item {
  id            String          @id @default(cuid())
  code          String          @unique // InternalCode 内部编码（唯一）
  mnemonic      String? // 助记码
  name          String // 中文名称
  itemType      ItemType        @default(FINISHED_GOOD) // 分类枚举（CTO #2075：10 类）
  // 五级层级（CTO #2075）：Level1 Category → Level2 SubCategory → Level3 Series → Level4 Model → Level5 Variant
  categoryId    String? // Level2 SubCategory（ItemCategory 树叶子）
  category      ItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series        String? // Level3 系列（如 SM）
  model         String? // Level4 型号（如 SMH45A）
  variant       String? // Level5 变型（如 SMH45A-R1515-Z0）
  spec          String? // 规格描述（简要）
  brand         String? // 品牌
  manufacturer  String? // 制造商
  // Identification（CTO #2075）：CustomerCode/SupplierCode 由 SupplierItem（+Sprint 4 CustomerItem）承载
  oemCode       String? // OEM 编码
  barcode       String? // 条码
  qrCode        String? // 二维码内容
  drawingNo     String? // 图号（关联 File Center attachmentType=DRAWING）
  drawingVersion String? // 图纸版本
  revision      String? // 技术版本标识（如 A/B/1.0）
  // 生命周期与系统状态（CTO #2075：两者分离）
  lifecycle     ItemLifecycle? // 产品生命周期（DESIGN/TRIAL/MASS_PRODUCTION/DISCONTINUED/OBSOLETE）
  status        ItemStatus      @default(ACTIVE) // 系统状态（ACTIVE/INACTIVE/LOCKED/ARCHIVED）
  obsolete      Boolean         @default(false) // 停产标记（兼容）
  replacementItemId String? // 替代料
  replacementItem Item?          @relation("ItemReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  replacedBy    Item[]          @relation("ItemReplacement")
  minPackQty    Decimal?        @db.Decimal(14, 2) // 最小包装
  procurementLeadTime Int? // 采购周期（天）
  moq           Decimal?        @db.Decimal(14, 2) // MOQ
  safetyStock   Decimal?        @db.Decimal(14, 2) // 安全库存
  // 多 UOM（CTO #2075：Stock/Purchase/Sales + Conversion）
  unitId        String? // 兼容默认单位
  unit          UnitOfMeasure?  @relation("ItemUnit", fields: [unitId], references: [id], onDelete: SetNull)
  stockUomId    String? // 库存单位
  stockUom      UnitOfMeasure?  @relation("ItemStockUom", fields: [stockUomId], references: [id], onDelete: SetNull)
  purchaseUomId String? // 采购单位
  purchaseUom   UnitOfMeasure?  @relation("ItemPurchaseUom", fields: [purchaseUomId], references: [id], onDelete: SetNull)
  salesUomId    String? // 销售单位
  salesUom      UnitOfMeasure?  @relation("ItemSalesUom", fields: [salesUomId], references: [id], onDelete: SetNull)
  // 业务开关
  isSalable       Boolean @default(true) // 可销售
  isPurchasable   Boolean @default(true) // 可采购
  isManufacturable Boolean @default(false) // 可生产
  standardCost  Decimal?       @db.Decimal(14, 4) // 标准成本（生产入库成本基数，P-1/ADR ProductionInbound）
  description   String?
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  linearGuide   LinearGuideSpecification?
  standards     ItemStandard[]
  priceListItems PriceListItem[]
  productionInboundSources ProductionInboundLine[] @relation("ProdFromItem") // 作为半成品被消耗
  productionInboundTargets ProductionInboundLine[] @relation("ProdToItem") // 作为产成品入库
  partnerPrices  PartnerPrice[]
  projectProducts ProjectProduct[]
  specifications ItemSpecification[]
  uomConversions UomConversion[]
  costs          ItemCost[]
  supplierItems  SupplierItem[]
  revisions      ItemRevision[]
  tags           ItemTag[]
  quotationLines QuotationLine[]
  salesOrderLines SalesOrderLine[]
  deliveryLines   DeliveryLine[]
  invoiceLines    InvoiceLine[]
  creditDebitNoteLines CreditDebitNoteLine[] // 4E-3：调整单明细（CreditDebitNoteLine.item 方向）
  purchaseRequisitionLines PurchaseRequisitionLine[] // 5A：采购申请行（PurchaseRequisitionLine.item 方向）
  purchaseOrderLines PurchaseOrderLine[] // 5A：采购订单行（PurchaseOrderLine.item 方向）
  purchaseReceiptLines PurchaseReceiptLine[] // 5B：收货行（PurchaseReceiptLine.item 方向）
  warehouseReceiptLines WarehouseReceiptLine[] // 5B：入库行（WarehouseReceiptLine.item 方向）
  purchaseReturnLines PurchaseReturnLine[] // 5B：退货行（PurchaseReturnLine.item 方向）
  inventoryMovements InventoryMovement[] // 6A：库存流水（InventoryMovement.item 方向）
  stockProjections StockProjection[] // 6A：库存投影（StockProjection.item 方向）
  transferLines InventoryTransferLine[] // 6B：调拨行（InventoryTransferLine.item 方向）
  stockCountLines StockCountLine[] // 6B：盘点行（StockCountLine.item 方向）
  adjustmentLines InventoryAdjustmentLine[] // 6B：调整行（InventoryAdjustmentLine.item 方向）
  conversions InventoryConversion[] // 6B：转换单（InventoryConversion.item 方向）
  supplierInvoiceLines SupplierInvoiceLine[] // 5C-1：供应商发票行（SupplierInvoiceLine.item 方向）
  costBalance InventoryCostBalance? // 成本核算（ADR-0038）：移动加权平均成本层（InventoryCostBalance.item 方向）
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([model])
  @@index([mnemonic])
  @@index([itemType])
  @@index([categoryId])
  @@index([replacementItemId])
  @@index([deletedAt])
  supplierCreditDebitNoteLines SupplierCreditDebitNoteLine[] // 5C-2：供应商贷/借项行（SupplierCreditDebitNoteLine.itemId 方向）
}

/// 直线导轨专用扩展规格（关联 Item，1:1）。
model LinearGuideSpecification {
  id                 String   @id @default(cuid())
  itemId             String   @unique
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  series             String? // 系列（SG/SM/SR/SV）
  slideBlockType     String? // 滑块型式
  railType           String? // 导轨型式
  interchangeability String? // 互换性
  precisionGrade     String? // 精度等级
  preload            String? // 预压力
  railLength         Decimal? @db.Decimal(12, 2) // 导轨长度 mm
  ratedDynamicLoad   Decimal? @db.Decimal(12, 2) // 额定动负荷 kN
  ratedStaticLoad    Decimal? @db.Decimal(12, 2) // 额定静负荷 kN
  ratedMoment        Json? // 额定力矩（MR/MP/MY）
  lubrication        String? // 润滑
