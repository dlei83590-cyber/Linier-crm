// ============================================================
// Sprint 4E-2：Receipt & Payment Allocation（收款与核销领域）
// CTO Design Review 2026-08-08 97/100 APPROVED WITH CHANGES 拍板：
// ① 创建与核销分离（POST /api/receipts 只记录金额；allocate 显式动作且一次请求原子化）
// ② VOID 仅未核销；已核销逆向走 Allocation/Receipt Reversal 留痕；CN 属 4E-3 发票调整域不承担收款冲销
// ③ WriteOff = WriteOff + WriteOffAllocation（不做 Revision/Snapshot 三件套；审批历史 Workflow、审计 AuditLog）
// ④ Receipt/WriteOff 编号 DocumentSequence 创建即取号（REC-/WO-2026-xxxx，与 Invoice DRAFT 不占号语义不同）
// ⑤ unallocatedAmount 受控投影保留（预收/暂未指定发票场景）
// 硬规则：同 Customer + 同 Currency 才允许 Allocation（409；第一版禁止跨币种核销）
// 锁序（CTO 指定）：Lock Receipt → Lock AR rows(id ASC) → 校验客户/币种 → 校验 unallocated → 校验 ≤ AR.balanceAmount
//   → Create ReceiptAllocation → 回写 AR → 回写 Invoice 投影 → 回写 Receipt 投影 → AR 状态投影 → Snapshot/Audit → Events
// ============================================================

/// 收款状态（受控投影——拍板②：只能由 allocation/reversal/void 事务更新，禁止 PATCH；前三个可由金额动态推导）
enum ReceiptStatus {
  UNALLOCATED          // 未核销（unallocatedAmount = amount）
  PARTIALLY_ALLOCATED  // 部分核销（0 < allocatedAmount < amount）
  FULLY_ALLOCATED      // 全部核销（unallocatedAmount = 0）
  VOIDED               // 已作废（仅未核销可 VOID）
}

/// 收款方式
enum PaymentMethod {
  BANK_TRANSFER  // 银行转账
  CHEQUE         // 支票
  CASH           // 现金
  CARD           // 刷卡
  OTHER          // 其他
}

/// 收款快照类型（仅固化节点生成，只读）
enum ReceiptSnapshotType {
  CREATED  // 创建时固化
  ALLOCATED // 核销节点固化（部分/全额核销均触发）
  VOIDED   // 作废时固化
  REVERSED // Allocation/Receipt Reversal 时固化
}

/// 收款（收款事实源；Payment 不单独建表——CTO 拍板：避免两个重复入账事实）
/// 核心金额关系：amount = allocatedAmount + unallocatedAmount（后两者受控投影，禁止 PATCH）
/// 拍板④：code DocumentSequence 创建即取号（Receipt 是实际收款凭证，创建即财务事实）
model Receipt {
  id           String   @id @default(cuid())
  code         String   @unique // 收款单编号（REC-2026-xxxx，DocumentSequence 创建即取号）
  customerId   String   // 收款客户（核销目标 AR.customerId 必须一致——硬规则）
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 币种（核销目标 AR.currency 必须一致——硬规则，第一版禁止跨币种核销）
  amount       Decimal  @db.Decimal(18, 4) // 实收金额（收款事实）
  allocatedAmount   Decimal @default(0) @db.Decimal(18, 4) // 受控投影 = Σ ReceiptAllocation.allocatedAmount（非反向核销）
  unallocatedAmount Decimal @default(0) @db.Decimal(18, 4) // 受控投影 = amount - allocatedAmount（拍板⑤：预收/暂未指定发票）
  receiptDate  DateTime @db.Timestamptz(3) // 收款日期
  paymentMethod PaymentMethod // 收款方式
  referenceNo  String?  // 银行流水号/备注
  status       ReceiptStatus @default(UNALLOCATED) // 受控投影（事务更新，禁止 PATCH）
  voidedAt     DateTime? @db.Timestamptz(3)
  voidedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  allocations ReceiptAllocation[]
  revisions   ReceiptRevision[]
  snapshots   ReceiptSnapshot[]

  @@index([customerId])
  @@index([status])
  @@index([receiptDate])
  @@index([deletedAt])
}

/// 核销事实（M:N：一个 Receipt → 多 AR；一个 AR → 多 Receipt——CTO 锁定）
/// 允许同一 (receipt, AR) 多行：Reversal 后可重新分配（每行是一次核销/冲销事件，Σ 校验防超核销）
/// Allocation Reversal 留痕：reversedAt/reversedBy 非空即已冲销（4E-2 边界，CN 不承担收款冲销）
model ReceiptAllocation {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal @db.Decimal(18, 4) // 本次核销金额
  allocatedAt   DateTime @default(now()) @db.Timestamptz(3)
  allocatedBy   String?
  // Allocation Reversal 留痕（CTO Design Review 新锁定边界）
  reversedAt    DateTime? @db.Timestamptz(3)
  reversedBy    String?
  reverseReason String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([receiptId])
  @@index([accountsReceivableId])
  @@index([reversedAt])
  @@index([deletedAt])
}

/// 收款修订（头信息变更留痕；系统生成，禁止手工编辑）
model ReceiptRevision {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  revisionNo   Int
  changeReason String
  snapshotData Json?    // 头信息快照（金额 Decimal 字符串，禁止 toNumber）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([receiptId, revisionNo])
  @@index([receiptId])
  @@index([deletedAt])
}

/// 收款快照（关键节点固化：CREATED/ALLOCATED/VOIDED/REVERSED；金额 Decimal 字符串）
model ReceiptSnapshot {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  snapshotType ReceiptSnapshotType
  revisionNo   Int
  snapshotData Json?    // 完整快照（Header + amount/allocatedAmount/unallocatedAmount/status；Decimal 字符串）
  generatedById String?
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([receiptId])
  @@index([deletedAt])
}

/// 写销状态（审批边界：WriteOff 按 ApprovalPolicy 条件审批；审批完成前禁止改 AR.writeOffAmount）
enum WriteOffStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  APPLIED
}

/// 坏账/折让写销（独立事实实体——拍板③：不 PATCH AR.writeOffAmount，APPLIED 才回写）
/// 不做 Revision/Snapshot 三件套（拍板③：审批历史由 Workflow、审计由 AuditLog，避免模型膨胀）
/// 审批：approvalPolicyId 可空；有值 → 按 ApprovalPolicy 触发 Workflow（复用，不建 WriteOffApproval 表）
model WriteOff {
  id           String   @id @default(cuid())
  code         String   @unique // 写销单编号（WO-2026-xxxx，DocumentSequence 创建即取号）
  amount       Decimal  @db.Decimal(18, 4) // 写销总额（= Σ WriteOffAllocation.amount）
  reason       String   // 原因：坏账/折让/其他
  writeOffDate DateTime @db.Timestamptz(3)
  status       WriteOffStatus @default(DRAFT)
  approvalPolicyId String? // 条件审批（可空）
  // 审批投影（Workflow 唯一审批事实源；不建 WriteOffApproval 表）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  appliedAt     DateTime? @db.Timestamptz(3) // APPLIED 时才回写 AR（审批完成前禁止提前修改）
  appliedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  allocations WriteOffAllocation[]

  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 写销明细（WriteOff → AR；APPLIED 时按明细回写 AR.writeOffAmount + balanceAmount）
model WriteOffAllocation {
  id           String   @id @default(cuid())
  writeOffId   String
  writeOff     WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(18, 4)
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([writeOffId, accountsReceivableId])
  @@index([writeOffId])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}

// ============================================================
// Sprint 4E-3：Credit Note / Debit Note（发票调整与应收调整领域）
// CTO Design Review 98/100 APPROVED WITH CHANGES（2026-08-08）：
// ① 单票制（sourceInvoiceId 必填且唯一；跨票 Consolidated Adjustment 延后）
// ② 负 AR 方案 A：允许 balanceAmount < 0（=Customer Credit/可退可抵）；**不新增数据库状态**
//    （AccountsReceivableStatus 不加 CREDIT；读取投影 isCreditBalance/creditAmount/effectiveBalanceType）
// ③ 条件审批：复用 ApprovalPolicy(module=CREDIT_DEBIT_NOTE)，不建 Approval 表
// ④ 部分行调整支持，但必须累计防超调（remainingAdjustableQty = original - cumulativeAppliedCreditQty）
// ⑤ 第一版禁止 DN 超原 Invoice 金额（行级 ceiling = 原行金额；未来 ADDITIONAL_CHARGE 单独 ADR）
// 符号口径（CTO 拍板）：CN → adjustmentAmount < 0；DN → adjustmentAmount > 0（signed Decimal，全系统唯一）
// 事实链：Invoice → CreditDebitNote → CreditDebitNoteLine → InvoiceAdjustment → AR.adjustedAmount → AR.balanceAmount
// 边界：不修改原 Invoice 金额事实（invoiceTotal/行快照/InvoiceSnapshot 不动）；不承担 Receipt/Allocation Reversal；
//       AR.adjustedAmount 聚合结果禁 PATCH（唯一入口 InvoiceAdjustment Apply）；APPROVED ≠ APPLIED
// 编号：DocumentSequence 创建即取号（CN-/DN-2026-xxxx；docType=CREDIT_NOTE/DEBIT_NOTE 已有）
// onDelete：CreditDebitNote→Invoice/Customer Restrict；CreditDebitNoteLine→Note Cascade、→InvoiceLine Restrict；
//           InvoiceAdjustment→Note/Line/Invoice/AR Restrict、→InvoiceLine SetNull（可空整票调整）
// ============================================================

/// 发票调整单类型（CTO 98/100 拍板：全系统唯一符号口径——CREDIT 负向、DEBIT 正向）
enum CreditDebitNoteType {
  CREDIT // 贷项通知单（负向调整 AR：adjustmentAmount < 0）
  DEBIT  // 借项通知单（正向调整 AR：adjustmentAmount > 0）
}

/// 发票调整单状态（单据生命周期；审批状态走 approvalStatus 投影复用 ApprovalStatus——不膨胀）
enum CreditDebitNoteStatus {
  DRAFT     // 草稿（可编辑行）
  SUBMITTED // 已提交（命中策略 → Workflow 审批 PENDING；未命中 → 可直接进入可 Apply 状态）
  APPLIED   // 已生效（唯一回写 AR.adjustedAmount 的入口；APPROVED ≠ APPLIED）
  CANCELLED // 已取消（未生效前可取消）
}

/// 发票调整单头（CN/DN；4E-3 发票调整域；不修改原 Invoice 金额事实）
model CreditDebitNote {
  id           String   @id @default(cuid())
  code         String   @unique // 调整单编号（CN-/DN-2026-xxxx，DocumentSequence 创建即取号）
  noteType     CreditDebitNoteType // CREDIT 负向 / DEBIT 正向
  sourceInvoiceId String // 单票制（CTO 拍板①：必填且唯一；跨票 Consolidated 延后）
  sourceInvoice Invoice @relation(fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  customerId   String   // 客户（继承 sourceInvoice.customerId）
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY") // 币种（继承 sourceInvoice.currency）
  reason       String   // 调整原因（折让/退货/价差/更正/其他）
  adjustmentTotal Decimal @db.Decimal(18, 4) // 调整总额（= Σ lines；服务端计算，禁止直传头金额）
  status       CreditDebitNoteStatus @default(DRAFT)
  // 条件审批（CTO 拍板③：复用 ApprovalPolicy module=CREDIT_DEBIT_NOTE，不建 Approval 表）
  approvalPolicyId String?
  // 审批投影（Workflow 唯一审批事实源；复用 ApprovalStatus——不膨胀）
  workflowInstanceId String?
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  approvalStatus ApprovalStatus @default(DRAFT)
  approvedAt    DateTime? @db.Timestamptz(3)
  approvedById  String?
  appliedAt     DateTime? @db.Timestamptz(3) // APPLIED 才回写 AR（审批完成前禁止提前修改）
  appliedById   String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines      CreditDebitNoteLine[]
  adjustments InvoiceAdjustment[]

  @@index([noteType])
  @@index([sourceInvoiceId])
  @@index([customerId])
  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
}

/// 发票调整单明细（逐行溯源 sourceInvoiceLineId；金额快照直接复制 InvoiceLine——不重算、不调用 Pricing Engine）
model CreditDebitNoteLine {
  id           String   @id @default(cuid())
  creditDebitNoteId String
  creditDebitNote CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)
  sourceInvoiceLineId String // 溯源发票行（必填可追溯——CTO 锁死）
  sourceInvoiceLine InvoiceLine @relation(fields: [sourceInvoiceLineId], references: [id], onDelete: Restrict)
  lineNo       Int      @default(10) // 行号（10/20/30/40 步进）
  itemId       String?  // 物料（继承 InvoiceLine.itemId，可空）
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description  String   // 描述（快照复制）
  quantity     Decimal  @db.Decimal(18, 4) // 调整数量（>0；部分行数量调整——CTO 拍板④，累计防超调）
  uomId        String?  // 单位（继承 InvoiceLine.uomId）
  uom          UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  // 金额快照（直接复制 InvoiceLine 快照，不重算）
  unitPrice    Decimal  @db.Decimal(18, 4) // 单价快照（复制）
  discountRate Decimal  @default(0) @db.Decimal(18, 4) // 折扣率快照（复制）
  lineAmount   Decimal  @db.Decimal(18, 4) // 行未税金额（复制计算值）
  taxAmount    Decimal  @db.Decimal(18, 4) // 行税额（复制）
  totalAmount  Decimal  @db.Decimal(18, 4) // 行含税金额（复制）
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  adjustments InvoiceAdjustment[]

  @@unique([creditDebitNoteId, lineNo])
  @@index([creditDebitNoteId])
  @@index([sourceInvoiceLineId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 发票调整事实中间层（4E-3 最核心事实层——真正影响 AR.adjustedAmount 的唯一入口）
/// 类比：ReceiptAllocation（收款↔AR 中间层）/ WriteOffAllocation（写销↔AR 明细）
/// CTO 98/100：adjustmentAmount 必须采用有符号 Decimal（CN<0、DN>0）；全系统唯一符号口径
/// 双溯源：sourceNoteId/sourceNoteLineId（单据侧）+ invoiceId/invoiceLineId（发票侧）+ accountsReceivableId（AR 侧）
model InvoiceAdjustment {
  id           String   @id @default(cuid())
  sourceNoteId String
  sourceNote   CreditDebitNote @relation(fields: [sourceNoteId], references: [id], onDelete: Restrict)
  sourceNoteLineId String
  sourceNoteLine CreditDebitNoteLine @relation(fields: [sourceNoteLineId], references: [id], onDelete: Restrict)
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceLineId String? // 可空：整票调整（invoiceLineId 为空）
  invoiceLine  InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  accountsReceivableId String
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  customerId   String // 冗余（Apply 事务校验与 AR 一致）
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currency     String   @default("CNY")
  adjustmentType CreditDebitNoteType // CREDIT 负向 / DEBIT 正向
  quantity     Decimal  @db.Decimal(18, 4) // 调整数量（累计防超调用）
  adjustmentAmount Decimal @db.Decimal(18, 4) // **有符号调整金额：CN<0 / DN>0（CTO 98/100，全系统唯一符号口径）**
  appliedAt    DateTime? @db.Timestamptz(3) // Apply 回写时间（null = 未生效）
  appliedById  String?
  // reversal 预留（CTO：4E-3 首版不实现 reversal，字段预留）
  reversedAt   DateTime? @db.Timestamptz(3)
  reversedById String?
  // 统一审计字段
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([sourceNoteId, invoiceId, invoiceLineId]) // 防重复调整行（同一调整单对同一发票/行只一条事实）
  @@index([sourceNoteId])
  @@index([sourceNoteLineId])
  @@index([invoiceId])
  @@index([invoiceLineId])
  @@index([accountsReceivableId])
  @@index([deletedAt])
}
