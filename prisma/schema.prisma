// Linier CRM Management System - Sprint 2 China Industrial Master Data schema (v2)
// CTO directive: unified Item model + BusinessPartner model for Chinese industrial enterprise.
// Master data foundation: Item / LinearGuideSpecification / BusinessPartner / PriceList /
// TechnicalStandard / ItemStandard / UnitOfMeasure / CommercialTerm / DocumentSequence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 物料分类：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物
/// 物料分类（CTO #2075：10 类，未来只加枚举值不加字段）
enum ItemType {
  FINISHED_GOOD // 成品
  RAW_MATERIAL // 原材料
  SEMI_FINISHED // 半成品
  PURCHASED_PART // 外购件
  ACCESSORY // 辅料/配件
  SERVICE // 服务
  CONSUMABLE // 消耗品
  ASSET // 资产
  TOOLING // 工装/模具
  PACKAGING // 包装材料
}

/// 审核状态：草稿 / 待审核 / 已审核 / 已驳回
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// 往来单位类型：客户 / 供应商 / 客户兼供应商
enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

/// 价格类型（采购价/销售价/VIP/代理/工程/战略客户/区域价/客户专属价/历史价）
enum PriceType {
  PURCHASE // 采购价
  SALES // 销售价
  VIP // VIP 价
  AGENT // 代理价
  ENGINEERING // 工程价
  STRATEGIC // 战略客户价
  REGIONAL // 区域价
  CUSTOMER // 客户专属价
  HISTORICAL // 历史价
}

/// 价格策略类型（CTO #2204/#2225：独立建模，不写死在 PriceList）
enum PricePolicyType {
  STANDARD   // 标准价
  VIP        // VIP 价
  PROJECT    // 项目价
  DEALER     // 经销商价
  REGIONAL   // 区域价
  PROMOTION  // 促销价
}

/// 价目表版本状态（CTO #2204：Draft/Published/Archived，报价可追溯）
enum PriceListStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 税率类型（CTO #2204/#2225：0%/6%/13%/免税/自定义）
enum TaxRateType {
  ZERO      // 0%
  SIX       // 6%
  THIRTEEN  // 13%
  EXEMPT    // 免税
  CUSTOM    // 自定义
}

/// 价格来源（CTO #2225：BI 分析价格来源）
enum PriceSource {
  MANUAL    // 手工
  IMPORT    // 导入
  FORMULA   // 公式计算
  PROMOTION // 促销
  SUPPLIER  // 供应商
  MARKET    // 市场行情
}

/// 价格匹配策略（CTO #2249：priority 不够，需策略）
enum PriceMatchStrategy {
  FIRST_MATCH      // 第一条命中即停止
  BEST_PRICE       // 最优价（业务定义）
  LOWEST_PRICE     // 最低价
  HIGHEST_PRIORITY // 最高优先级
  COMBINE          // 多规则叠加
}

/// 促销类型（CTO #2225：PromotionRule 独立模型）
enum PromotionType {
  PERCENT // 折扣百分比
  AMOUNT  // 固定金额
}

/// 汇率类型（CTO #2345：央行/ERP/人工可区分）
enum ExchangeRateType {
  CENTRAL_BANK // 央行
  BANK         // 银行
  MANUAL       // 人工
}

/// 价格规则类型（CTO #2345：PriceRule 独立，Pricing Engine 直接执行）
enum PriceRuleType {
  CUSTOMER_LEVEL // 客户等级
  REGION         // 区域
  QUANTITY_BREAK // 数量阶梯
  BRAND          // 品牌
  PROJECT_TYPE   // 项目类型
  CURRENCY       // 币种
  CHANNEL        // 渠道
}

/// 物料生命周期（CTO #2075：产品生命周期，与 ItemStatus 系统状态分离）
enum ItemLifecycle {
  DESIGN // 设计
  TRIAL // 试产
  MASS_PRODUCTION // 量产
  DISCONTINUED // 停产
  OBSOLETE // 淘汰
}

/// 物料系统状态（CTO #2075：是否允许使用，与 Lifecycle 分离）
enum ItemStatus {
  ACTIVE // 可用
  INACTIVE // 停用
  LOCKED // 锁定（不允许变更）
  ARCHIVED // 归档（只读）
}

/// 物料成本类型（CTO #2075：只建接口不写算法，Finance 引用）
enum ItemCostType {
  STANDARD // 标准成本
  LAST_PURCHASE // 最近采购价
  AVERAGE // 移动平均
  CURRENT // 现行成本
}

/// 附件类型（CTO #2075：统一放 File Center，Project/Supplier/Customer/Quotation 共用）
enum AttachmentType {
  DRAWING // 图纸
  CERTIFICATE // 证书
  PHOTO // 照片
  MANUAL // 手册
  MODEL_3D // 3D 模型
  VIDEO // 视频
  INSPECTION_REPORT // 检验报告
}

/// 单据类型（报价/SO/PO/PI/CI/DO/GRN/GI/发票/贷项/借项/付款/收款/费用/日记账/合同/项目）
enum DocumentType {
  QUOTATION // 报价单
  SALES_ORDER // 销售订单 SO
  PURCHASE_ORDER // 采购订单 PO
  PROFORMA_INVOICE // 形式发票 PI
  COMMERCIAL_INVOICE // 商业发票 CI
  DELIVERY_ORDER // 送货单 DO
  GOODS_RECEIPT_NOTE // 收货单 GRN
  GOODS_ISSUE // 出库单 GI
  INVOICE // 发票
  CREDIT_NOTE // 贷项通知单
  DEBIT_NOTE // 借项通知单
  PAYMENT_VOUCHER // 付款凭证
  RECEIPT // 收款收据
  WRITE_OFF // 坏账/折让写销（Sprint 4E-2）
  EXPENSE // 费用报销
  JOURNAL // 日记账
  CONTRACT // 合同
  PROJECT // 项目
}

/// Platform user account. Identity and credential record.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  isActive     Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([email])
  @@index([departmentId])
}

/// Organizational unit users belong to.
model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  users     User[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

/// Named role that bundles permissions (e.g. ADMIN, MANAGER, MEMBER, VIEWER).
model Role {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       UserRole[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([code])
}

/// Atomic capability, grouped by module (e.g. user:read, item:write).
model Permission {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  module      String
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([module, code])
}

/// Explicit many-to-many link between User and Role.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Immutable trail of security-sensitive and destructive actions.
/// 审计结果
enum AuditResult {
  SUCCESS
  FAILURE
  PARTIAL
}

/// 审计日志（Sprint 3B 升级：ObjectType/ObjectId/Before/AfterData/RequestId/TraceId/IP/Device/Browser/Duration/Result）
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String // ObjectType（如 workflow-definition）
  entityId   String? // ObjectId
  beforeData Json? // 操作前数据快照
  afterData  Json? // 操作后数据快照
  requestId  String? // 请求 ID（链路追踪）
  traceId    String? // 追踪 ID（全链路）
  meta       Json?
  ipAddress  String? // IP
  device     String? // 设备（mobile/desktop）
  browser    String? // 浏览器 UA 摘要
  duration   Int? // 耗时（毫秒）
  result     AuditResult @default(SUCCESS) // 操作结果
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([traceId])
  @@index([result])
  @@index([createdAt])
}

/// 计量单位主数据（如：kg、m、件、套）
model UnitOfMeasure {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  symbol        String?
  isActive      Boolean  @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int      @default(1)
  deletedAt     DateTime?
  items         Item[]          @relation("ItemUnit")
  stockItems    Item[]          @relation("ItemStockUom")
  purchaseItems Item[]          @relation("ItemPurchaseUom")
  salesItems    Item[]          @relation("ItemSalesUom")
  fromConversions UomConversion[] @relation("UomConversionFrom")
  toConversions   UomConversion[] @relation("UomConversionTo")
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  deliveryLines   DeliveryLine[]
  invoiceLines    InvoiceLine[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 统一物料主表：成品 / 原材料 / 配件 / 外购件 / 服务 / 包装物。
/// 名称、型号、规格、计量单位统一维护；品类差异通过扩展模型承载（如直线导轨规格）。
model Item {
  id            String          @id @default(cuid())
  code          String          @unique // InternalCode 内部编码（唯一）
  mnemonic      String? // 助记码
  name          String // 中文名称
  itemType      ItemType        @default(FINISHED_GOOD) // 分类枚举（CTO #2075：10 类）
  // 五级层级（CTO #2075）：Level1 Category → Level2 SubCategory → Level3 Series → Level4 Model → Level5 Variant
  categoryId    String? // Level2 SubCategory（ItemCategory 树叶子）
  category      ItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series        String? // Level3 系列（如 SM）
  model         String? // Level4 型号（如 SMH45A）
  variant       String? // Level5 变型（如 SMH45A-R1515-Z0）
  spec          String? // 规格描述（简要）
  brand         String? // 品牌
  manufacturer  String? // 制造商
  // Identification（CTO #2075）：CustomerCode/SupplierCode 由 SupplierItem（+Sprint 4 CustomerItem）承载
  oemCode       String? // OEM 编码
  barcode       String? // 条码
  qrCode        String? // 二维码内容
  drawingNo     String? // 图号（关联 File Center attachmentType=DRAWING）
  drawingVersion String? // 图纸版本
  revision      String? // 技术版本标识（如 A/B/1.0）
  // 生命周期与系统状态（CTO #2075：两者分离）
  lifecycle     ItemLifecycle? // 产品生命周期（DESIGN/TRIAL/MASS_PRODUCTION/DISCONTINUED/OBSOLETE）
  status        ItemStatus      @default(ACTIVE) // 系统状态（ACTIVE/INACTIVE/LOCKED/ARCHIVED）
  obsolete      Boolean         @default(false) // 停产标记（兼容）
  replacementItemId String? // 替代料
  replacementItem Item?          @relation("ItemReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  replacedBy    Item[]          @relation("ItemReplacement")
  minPackQty    Decimal?        @db.Decimal(14, 2) // 最小包装
  procurementLeadTime Int? // 采购周期（天）
  moq           Decimal?        @db.Decimal(14, 2) // MOQ
  safetyStock   Decimal?        @db.Decimal(14, 2) // 安全库存
  // 多 UOM（CTO #2075：Stock/Purchase/Sales + Conversion）
  unitId        String? // 兼容默认单位
  unit          UnitOfMeasure?  @relation("ItemUnit", fields: [unitId], references: [id], onDelete: SetNull)
  stockUomId    String? // 库存单位
  stockUom      UnitOfMeasure?  @relation("ItemStockUom", fields: [stockUomId], references: [id], onDelete: SetNull)
  purchaseUomId String? // 采购单位
  purchaseUom   UnitOfMeasure?  @relation("ItemPurchaseUom", fields: [purchaseUomId], references: [id], onDelete: SetNull)
  salesUomId    String? // 销售单位
  salesUom      UnitOfMeasure?  @relation("ItemSalesUom", fields: [salesUomId], references: [id], onDelete: SetNull)
  // 业务开关
  isSalable       Boolean @default(true) // 可销售
  isPurchasable   Boolean @default(true) // 可采购
  isManufacturable Boolean @default(false) // 可生产
  description   String?
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  linearGuide   LinearGuideSpecification?
  standards     ItemStandard[]
  priceListItems PriceListItem[]
  partnerPrices  PartnerPrice[]
  projectProducts ProjectProduct[]
  specifications ItemSpecification[]
  uomConversions UomConversion[]
  costs          ItemCost[]
  supplierItems  SupplierItem[]
  revisions      ItemRevision[]
  tags           ItemTag[]
  quotationLines QuotationLine[]
  salesOrderLines SalesOrderLine[]
  deliveryLines   DeliveryLine[]
  invoiceLines    InvoiceLine[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([model])
  @@index([mnemonic])
  @@index([itemType])
  @@index([categoryId])
  @@index([replacementItemId])
  @@index([deletedAt])
}

/// 直线导轨专用扩展规格（关联 Item，1:1）。
model LinearGuideSpecification {
  id                 String   @id @default(cuid())
  itemId             String   @unique
  item               Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  series             String? // 系列（SG/SM/SR/SV）
  slideBlockType     String? // 滑块型式
  railType           String? // 导轨型式
  interchangeability String? // 互换性
  precisionGrade     String? // 精度等级
  preload            String? // 预压力
  railLength         Decimal? @db.Decimal(12, 2) // 导轨长度 mm
  ratedDynamicLoad   Decimal? @db.Decimal(12, 2) // 额定动负荷 kN
  ratedStaticLoad    Decimal? @db.Decimal(12, 2) // 额定静负荷 kN
  ratedMoment        Json? // 额定力矩（MR/MP/MY）
  lubrication        String? // 润滑
  dustProtection     String? // 防尘
  material           String? // 材质
  hardness           String? // 硬度
  mountingType       String? // 安装方式
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

/// 技术标准主数据（如 GB/T、ISO）
model TechnicalStandard {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int            @default(1)
  deletedAt   DateTime?
  items       ItemStandard[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// Item 与 TechnicalStandard 的多对多关联
model ItemStandard {
  id         String            @id @default(cuid())
  itemId     String
  item       Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  standardId String
  standard   TechnicalStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([itemId, standardId])
  @@index([standardId])
}

/// 统一往来单位：客户 / 供应商 / 客户兼供应商。
model BusinessPartner {
  id                  String         @id @default(cuid())
  code                String         @unique // 内部编码
  mnemonic            String? // 助记码
  name                String // 中文名称
  type                PartnerType    @default(SUPPLIER)
  uscc                String?        @unique // 统一社会信用代码
  taxpayerType        String? // 纳税人类型（一般纳税人/小规模纳税人）
  legalRepresentative String? // 法定代表人
  registeredAddress   String? // 注册地址
  invoiceInfo         Json? // 开票信息
  bankName            String? // 开户银行
  bankAccount         String? // 银行账号
  settlementTerms     String? // 结算条款
  shortName            String? // 客户简称
  fullName             String? // 客户全称
  groupName            String? // 集团名称
  region               String? // 所属区域
  industry             String? // 所属行业
  companySize          String? // 企业规模
  creditRating         String? // 信用等级
  sourceChannel        String? // 来源渠道
  foundedDate          DateTime? // 成立日期
  registeredCapital    Decimal?      @db.Decimal(14, 2) // 注册资本（万元）
  employeeCount        Int? // 员工人数
  website              String? // 官网
  wechatOfficialAccount String? // 微信公众号
  tags                 Json? // 企业标签
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  isActive            Boolean        @default(true)
  createdById         String?
  updatedById         String?
  approvedById        String?
  approvalStatus      ApprovalStatus @default(DRAFT)
  version             Int            @default(1)
  deletedAt           DateTime?
  opportunities       ProjectOpportunity[]
  projects            Project[]
  customers           Customer[]
  roles               BusinessPartnerRole[]
  partnerContacts     PartnerContact[]
  partnerAddresses    PartnerAddress[]
  partnerTags         PartnerTag[]
  partnerBankAccounts PartnerBankAccount[]
  partnerCredit       PartnerCredit?
  suppliers           Supplier[]
  supplierItems       SupplierItem[]
  partnerPrices       PartnerPrice[]
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([mnemonic])
  @@index([type])
  @@index([deletedAt])
}

/// 价格表主数据（CTO #2225 双轨：pricePolicyId FK + policyType 快照；Base/Quote Currency；Status 版本化）
model PriceList {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  priceType       PriceType       @default(SALES) // 价格类型
  currency        String          @default("CNY") // 兼容旧字段
  pricePolicyId   String? // 双轨：FK 关联当前策略
  policyType      PricePolicyType? // 双轨：策略类型快照（历史可解释）
  baseCurrency    String          @default("CNY") // CTO #2204：基准币种
  quoteCurrency   String          @default("CNY") // CTO #2204：报价币种
  status          PriceListStatus @default(DRAFT) // CTO #2204：Draft/Published/Archived
  effectiveFrom   DateTime? // CTO #2204：统一时间窗口
  effectiveTo     DateTime? // CTO #2204
  validFrom       DateTime? // 兼容旧字段
  validTo         DateTime? // 兼容旧字段
  priceSource     PriceSource     @default(MANUAL) // CTO #2225：价格来源
  freightIncluded Boolean         @default(false) // 是否含运费
  isActive        Boolean         @default(true)
  createdById     String?
  updatedById     String?
  approvedById    String?
  approvalStatus  ApprovalStatus  @default(DRAFT)
  version         Int             @default(1)
  deletedAt       DateTime?
  policy          PricePolicy?    @relation(fields: [pricePolicyId], references: [id], onDelete: SetNull)
  versions        PriceListVersion[]
  items           PriceListItem[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([status])
  @@index([pricePolicyId])
  @@index([deletedAt])
}

/// 价格表明细（CTO #2225/#2345：未税价/税率/税额/含税价/阶梯价 + 时间窗口 + 价格来源）
model PriceListItem {
  id               String        @id @default(cuid())
  priceListId      String
  priceList        PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPriceExclTax Decimal       @db.Decimal(14, 4) // 未税价
  taxRate          Decimal       @db.Decimal(5, 2) // 税率 %（默认值来自配置）
  taxAmount        Decimal       @db.Decimal(14, 4) // 税额
  unitPriceInclTax Decimal       @db.Decimal(14, 4) // 含税价
  minOrderQty      Decimal?      @db.Decimal(14, 2) // 最小起订量
  tieredPricing    Json? // 阶梯价（如 [{qty, price}])
  priceSource      PriceSource   @default(MANUAL) // CTO #2225：价格来源
  effectiveFrom    DateTime? // CTO #2204：时间窗口
  effectiveTo      DateTime? // CTO #2204
  discountRate     Decimal?      @db.Decimal(5, 2) // 折扣率 %
  taxProfileId     String? // CTO #2225：税率档案
  taxProfile       TaxProfile?   @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)
  isActive         Boolean       @default(true)
  createdById      String?
  updatedById      String?
  approvedById     String?
  approvalStatus   ApprovalStatus @default(DRAFT)
  version          Int           @default(1)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([priceListId])
  @@index([itemId])
  @@index([taxProfileId])
  @@index([deletedAt])
}

/// 价格策略（CTO #2204/#2225/#2249：独立建模；matchStrategy + stopOnMatch）
model PricePolicy {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  policyType    PricePolicyType
  priority      Int             @default(100) // 数值越小优先级越高（基础排序）
  matchStrategy PriceMatchStrategy @default(HIGHEST_PRIORITY) // CTO #2249
  stopOnMatch   Boolean         @default(true) // CTO #2249：命中即停/继续叠加
  description   String?
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  priceLists    PriceList[]
  rules         PriceRule[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([policyType])
  @@index([deletedAt])
}

/// 价格规则（CTO #2345：规则独立于 Policy，Pricing Engine 直接执行）
model PriceRule {
  id            String       @id @default(cuid())
  policyId      String
  policy        PricePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType      PriceRuleType // CUSTOMER_LEVEL/REGION/QUANTITY_BREAK/BRAND/PROJECT_TYPE/CURRENCY/CHANNEL
  ruleName      String       // 规则名（如 "VIP 客户 9 折"）
  conditions    Json?        // 条件（如 {customerLevel: "VIP", minQty: 100}）
  discountRate  Decimal?     @db.Decimal(5, 2) // 折扣率 %
  priority      Int          @default(100)
  isActive      Boolean      @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int          @default(1)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([policyId])
  @@index([ruleType])
  @@index([deletedAt])
}

/// 价目表版本（CTO #2204/#2345：Draft/Published/Archived + revisionNo + workflowInstanceId）
model PriceListVersion {
  id                String        @id @default(cuid())
  priceListId       String
  priceList         PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  versionNo         Int           // 版本号（递增）
  revisionNo        Int           @default(1) // CTO #2345：修订号
  status            PriceListStatus @default(DRAFT)
  publishedBy       String? // CTO #2345
  publishedAt       DateTime? // CTO #2345
  workflowInstanceId String? // CTO #2345：审批完成后直接发布
  changeSummary     String?
  isActive          Boolean       @default(true)
  createdById       String?
  updatedById       String?
  approvedById      String?
  approvalStatus    ApprovalStatus @default(DRAFT)
  version           Int           @default(1)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([priceListId, versionNo])
  @@index([priceListId])
  @@index([status])
  @@index([deletedAt])
}

/// 专属价（CTO #2225/#2249/#2345：Partner 级 + 枚举/快照 + priority/approvalRequired）
model PartnerPrice {
  id               String        @id @default(cuid())
  partnerId        String
  partner          BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerRoleType  PartnerRoleType // CTO #2249：枚举（业务逻辑/查询/权限）
  partnerRoleName  String? // CTO #2249：名称快照（历史显示）
  itemId           String
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitPrice        Decimal       @db.Decimal(18, 4)
  currency         String        @default("CNY")
  taxProfileId     String?
  taxProfile       TaxProfile?   @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  priceSource      PriceSource   @default(MANUAL) // CTO #2225
  priority         Int           @default(100) // CTO #2345：优先级
  approvalRequired Boolean       @default(false) // CTO #2345：VIP 价可审批
  isActive         Boolean       @default(true)
  createdById      String?
  updatedById      String?
  approvedById     String?
  approvalStatus   ApprovalStatus @default(DRAFT)
  version          Int           @default(1)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([partnerId])
  @@index([itemId])
  @@index([partnerRoleType])
  @@index([deletedAt])
}

/// 促销规则（CTO #2225/#2345：独立模型 + priority/stackable/exclusive）
model PromotionRule {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  promotionType PromotionType // PERCENT/AMOUNT
  discountValue Decimal       @db.Decimal(18, 4) // 折扣% 或 固定金额
  startAt       DateTime?
  endAt         DateTime?
  priority      Int           @default(100) // CTO #2345
  stackable     Boolean       @default(false) // CTO #2345：可叠加
  exclusive     Boolean       @default(false) // CTO #2345：互斥（不与其他促销叠加）
  priceSource   PriceSource   @default(PROMOTION)
  status        String        @default("DRAFT") // DRAFT/ACTIVE/PAUSED/EXPIRED
  isActive      Boolean       @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int           @default(1)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([startAt, endAt])
  @@index([deletedAt])
}

/// 税率档案（CTO #2204/#2225/#2345：多国支持 country/region/taxIncluded）
model TaxProfile {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  country       String? // CTO #2345：CN/MY/SG
  region        String? // CTO #2345：区域
  taxIncluded   Boolean      @default(false) // CTO #2345：含税价标志
  rateType      TaxRateType
  rate          Decimal?     @db.Decimal(5, 2) // CUSTOM 时填写
  isActive      Boolean      @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int          @default(1)
  deletedAt     DateTime?
  priceListItems PriceListItem[]
  partnerPrices PartnerPrice[]
  taxRates      TaxRate[]
  taxProfileRules TaxProfileRule[]
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 税率（CTO #2225：TaxProfile → TaxRate → Environment Default；ENV 只选默认 Profile 不存税率）
model TaxRate {
  id            String    @id @default(cuid())
  taxProfileId  String
  taxProfile    TaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)
  rate          Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([taxProfileId])
  @@index([deletedAt])
}

/// 税率规则（CTO #2249：多国税制不改核心代码）
model TaxProfileRule {
  id            String     @id @default(cuid())
  country       String? // 国家（CN/MY/SG），空=全局
  itemCategory  String? // Item Category
  customerType  String? // Customer Type
  supplierType  String? // Supplier Type
  taxCode       String     // 税码（对应 TaxProfile）
  taxProfileId  String
  taxProfile    TaxProfile @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)
  priority      Int        @default(100)
  isActive      Boolean    @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int        @default(1)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  @@index([country, itemCategory, customerType, supplierType])
  @@index([priority])
  @@index([deletedAt])
}

/// 汇率（CTO #2249/#2345：独立维护，不依赖外部实时查询；provider/rateType/manualOverride）
model ExchangeRate {
  id             String           @id @default(cuid())
  baseCurrency   String           // 基准币种
  quoteCurrency  String           // 报价币种
  rate           Decimal          @db.Decimal(18, 8)
  effectiveDate  DateTime         @db.Timestamptz(3)
  provider       String? // CTO #2345：数据来源机构
  source         String? // CTO #2249：来源（央行/银行/自定义）
  rateType       ExchangeRateType @default(MANUAL) // CTO #2345：央行/ERP/人工
  manualOverride Boolean          @default(false) // CTO #2345：人工覆盖标志
  isActive       Boolean          @default(true)
  createdById    String?
  updatedById    String?
  approvedById   String?
  approvalStatus ApprovalStatus   @default(DRAFT)
  version        Int              @default(1)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([baseCurrency, quoteCurrency, effectiveDate])
  @@index([effectiveDate])
  @@index([deletedAt])
}

/// 报价价格快照（CTO #2225/#2249：完整定价链 + PricingEngineVersion；Sprint 4 Quotation 引用）
model QuotationPriceSnapshot {
  id                   String    @id @default(cuid())
  quotationId          String    // Sprint 4 建 Quotation 后补 FK（CTO #2225）
  quotationLineId      String?
  itemId               String
  priceListId          String?
  pricePolicyId        String?
  promotionRuleId      String?
  promotionDiscount    Decimal?  @db.Decimal(18, 4) // 促销命中折扣金额
  currency             String    @default("CNY")
  exchangeRateId       String?
  exchangeRate         Decimal?  @db.Decimal(18, 8)
  taxProfileId         String?
  taxRate              Decimal?  @db.Decimal(5, 2) // 税率快照
  baseUnitPrice        Decimal   @db.Decimal(18, 4) // Base Price
  discountRate         Decimal   @default(0) @db.Decimal(5, 2)
  finalUnitPrice       Decimal   @db.Decimal(18, 4) // Final Price
  finalAmount          Decimal   @db.Decimal(18, 4)
  pricingTime          DateTime  @default(now()) @db.Timestamptz(3)
  pricingEngineVersion String    @default("v1") // CTO #2249
  isActive             Boolean   @default(true)
  createdById          String?
  updatedById          String?
  approvedById         String?
  approvalStatus       ApprovalStatus @default(DRAFT)
  version              Int       @default(1)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  projectProducts      ProjectProduct[]
  quotationLines       QuotationLine[]
  salesOrderLines       SalesOrderLine[]
  invoiceLines          InvoiceLine[]

  @@index([quotationId])
  @@index([itemId])
  @@index([deletedAt])
}

/// 价格变更审计（CTO #2345：独立审计，Sprint 7 财务复用）
model PriceAudit {
  id                 String    @id @default(cuid())
  entityType         String    // PriceList/PriceListItem/PartnerPrice/PromotionRule
  entityId           String
  oldPrice           Decimal?  @db.Decimal(18, 4)
  newPrice           Decimal?  @db.Decimal(18, 4)
  reason             String?
  approvedBy         String?
  workflowInstanceId String?
  effectiveTime      DateTime  @default(now()) @db.Timestamptz(3)
  createdById        String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([workflowInstanceId])
}

/// 商业条款主数据（如 EXW/FOB/CIF/月结30天）
model CommercialTerm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 单据序列主数据（销售订单/采购订单/报价单等编号规则）
model DocumentSequence {
  id          String   @id @default(cuid())
  code        String   @unique // 单据类型编码
  name        String
  docType     DocumentType // 单据类型（枚举）
  prefix      String?
  nextNo      Int      @default(1)
  padLength   Int      @default(4)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

// ============================================================
// Sprint 2B：项目机会与项目执行领域（中国工业项目制业务）
// 阶段：线索 → 准入 → 方案 → 报价 → 试样 → 测试 → 小批量 → 批量供货 → 暂停/失败/结项
// ============================================================

/// 项目阶段：线索 / 准入 / 方案 / 报价 / 试样 / 测试 / 小批量 / 批量供货 / 暂停 / 失败 / 结项
enum ProjectStage {
  LEAD // 线索
  QUALIFIED // 准入
  SOLUTION // 方案
  QUOTATION // 报价
  SAMPLING // 试样
  TESTING // 测试
  SMALL_BATCH // 小批量
  MASS_SUPPLY // 批量供货
  PAUSED // 暂停
  FAILED // 失败
  CLOSED // 结项
}

/// 项目关系人角色：需求人 / 技术人 / 采购人 / 决策人 / 使用人
enum StakeholderRole {
  REQUESTER // 需求人
  TECHNICAL // 技术人
  PURCHASER // 采购人
  DECISION_MAKER // 决策人
  END_USER // 使用人
}

/// 回款状态：未回款 / 部分回款 / 已回款 / 逾期
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

/// 里程碑状态：计划中 / 进行中 / 已完成 / 已延期
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

/// 任务状态：待办 / 进行中 / 已完成 / 已取消
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// 风险状态：开启 / 应对中 / 已关闭
enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

/// 走访/沟通类型：走访 / 电话 / 视频 / 会议 / 其他
enum VisitType {
  VISIT
  PHONE
  VIDEO
  MEETING
  OTHER
}

/// 验收结果：通过 / 有条件通过 / 不通过 / 待验收
enum AcceptanceResult {
  PASSED
  CONDITIONAL_PASS
  FAILED
  PENDING
}

/// 项目机会（线索/准入/方案/报价阶段）。
/// 承载客户投入、预计营收/成本/毛利、费用预算、销售目标、回款状态、竞争对手、成功概率。
model ProjectOpportunity {
  id                 String           @id @default(cuid())
  code               String           @unique // 机会编号（用 DocumentSequence 生成）
  name               String // 机会名称
  customerId         String
  customer           BusinessPartner  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage     @default(LEAD)
  customerInvestment Decimal?         @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?         @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?         @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?         @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?         @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?         @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus    @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手（[{name, note}]）
  successProbability Decimal?         @db.Decimal(5, 2) // 成功概率 %
  ownerId            String? // 负责人
  description        String?
  project            Project?
  convertedAt        DateTime? // CTO #3C5：机会转项目时间（唯一入口 convert 回写）
  convertedBy        String? // CTO #3C5：机会转项目操作人
  quotations         Quotation[]
  isActive           Boolean          @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus   @default(DRAFT)
  version            Int              @default(1)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目（试样/测试/小批量/批量供货/暂停/失败/结项阶段）。
model Project {
  id                 String              @id @default(cuid())
  code               String              @unique // 项目编号（用 DocumentSequence 生成）
  name               String // 项目名称
  opportunityId      String?           @unique // 关联的项目机会（可空，1:1）
  opportunity        ProjectOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerId         String
  customer           BusinessPartner     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage        @default(SAMPLING)
  customerInvestment Decimal?            @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?            @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?            @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?            @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?            @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?            @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus       @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手
  successProbability Decimal?            @db.Decimal(5, 2) // 成功概率 %
  expectedContractAmount Decimal?        @db.Decimal(14, 2) // 预计合同金额
  expectedProfit Decimal?                 @db.Decimal(14, 2) // 预计利润
  expectedGrossMarginRate Decimal?        @db.Decimal(5, 2) // 预计毛利率 %
  receivedAmount Decimal?                 @db.Decimal(14, 2) // 回款金额
  invoicedAmount Decimal?                  @db.Decimal(14, 2) // 已开发票金额
  uninvoicedAmount Decimal?                @db.Decimal(14, 2) // 未开发票金额
  receivableBalance Decimal?               @db.Decimal(14, 2) // 应收余额
  projectRating String? // 项目评级
  failureReason String? // 失败原因
  priority     String? // 优先级（高/中/低，CTO #3C5 最小增量）
  progressPercent Decimal? @db.Decimal(5, 2) // 汇总进度 %（明细在 ProjectProgress）
  ownerId            String? // 项目负责人
  description        String?
  stakeholders       ProjectStakeholder[]
  members            ProjectMember[]
  milestones         ProjectMilestone[]
  tasks              ProjectTask[]
  budgets            ProjectBudget[]
  expenses           ProjectExpense[]
  products           ProjectProduct[]
  risks              ProjectRisk[]
  visits             ProjectVisit[]
  progresses         ProjectProgress[]
  acceptances        ProjectAcceptance[]
  closure            ProjectClosure?
  tags               ProjectTag[]
  quotations         Quotation[]
  salesOrders         SalesOrder[]
  isActive           Boolean             @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus      @default(DRAFT)
  version            Int                 @default(1)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目关系人：需求人 / 技术人 / 采购人 / 决策人 / 使用人。
model ProjectStakeholder {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        StakeholderRole
  name        String // 姓名
  title       String? // 职务
  department  String?
  phone       String?
  email       String?
  note        String?
  isActive    Boolean         @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([role])
  @@index([deletedAt])
}

/// 项目成员（内部团队）。
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String? // 关联系统用户（可空，允许未建账号成员）
  name        String // 姓名
  roleInProject String? // 项目内角色（如：项目经理/技术负责/销售）
  joinedAt    DateTime?
  leftAt      DateTime?
  isActive    Boolean  @default(true)
