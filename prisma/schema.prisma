/// 价格变更审计（CTO #2345：独立审计，Sprint 7 财务复用）
model PriceAudit {
  id                 String    @id @default(cuid())
  entityType         String    // PriceList/PriceListItem/PartnerPrice/PromotionRule
  entityId           String
  oldPrice           Decimal?  @db.Decimal(18, 4)
  newPrice           Decimal?  @db.Decimal(18, 4)
  reason             String?
  approvedBy         String?
  workflowInstanceId String?
  effectiveTime      DateTime  @default(now()) @db.Timestamptz(3)
  createdById        String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([workflowInstanceId])
}

/// 商业条款主数据（如 EXW/FOB/CIF/月结30天）
model CommercialTerm {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// 单据序列主数据（销售订单/采购订单/报价单等编号规则）
model DocumentSequence {
  id          String   @id @default(cuid())
  code        String   @unique // 单据类型编码
  name        String
  docType     DocumentType // 单据类型（枚举）
  prefix      String?
  startNo     Int      @default(1) // 起始序号（新建时 nextNo 初始 = startNo；可编辑）
  nextNo      Int      @default(1) // 当前序号（编号引擎推进；管理员可调整）
  padLength   Int      @default(4)
  periodPattern  String? // 期间前缀模板（如 "{YYYY}{MM}"；JOURNAL 启用，其余暂空 = 现状；ADR-0044）
  perPeriodReset Boolean @default(false) // 是否按月重排（JOURNAL = true）
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

// ============================================================
// Sprint 2B：项目机会与项目执行领域（中国工业项目制业务）
// 阶段：线索 → 准入 → 方案 → 报价 → 试样 → 测试 → 小批量 → 批量供货 → 暂停/失败/结项
// ============================================================

/// 项目阶段：线索 / 准入 / 方案 / 报价 / 试样 / 测试 / 小批量 / 批量供货 / 暂停 / 失败 / 结项
enum ProjectStage {
  LEAD // 线索
  QUALIFIED // 准入
  SOLUTION // 方案
  QUOTATION // 报价
  SAMPLING // 试样
  TESTING // 测试
  SMALL_BATCH // 小批量
  MASS_SUPPLY // 批量供货
  PAUSED // 暂停
  FAILED // 失败
  CLOSED // 结项
}

/// 项目关系人角色：需求人 / 技术人 / 采购人 / 决策人 / 使用人
enum StakeholderRole {
  REQUESTER // 需求人
  TECHNICAL // 技术人
  PURCHASER // 采购人
  DECISION_MAKER // 决策人
  END_USER // 使用人
}

/// 回款状态：未回款 / 部分回款 / 已回款 / 逾期
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

/// 里程碑状态：计划中 / 进行中 / 已完成 / 已延期
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

/// 任务状态：待办 / 进行中 / 已完成 / 已取消
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// 风险状态：开启 / 应对中 / 已关闭
enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

/// 走访/沟通类型：走访 / 电话 / 视频 / 会议 / 其他
enum VisitType {
  VISIT
  PHONE
  VIDEO
  MEETING
  OTHER
}

/// 验收结果：通过 / 有条件通过 / 不通过 / 待验收
enum AcceptanceResult {
  PASSED
  CONDITIONAL_PASS
  FAILED
  PENDING
}

/// 项目机会（线索/准入/方案/报价阶段）。
/// 承载客户投入、预计营收/成本/毛利、费用预算、销售目标、回款状态、竞争对手、成功概率。
model ProjectOpportunity {
  id                 String           @id @default(cuid())
  code               String           @unique // 机会编号（用 DocumentSequence 生成）
  name               String // 机会名称
  customerId         String
  customer           BusinessPartner  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage     @default(LEAD)
  customerInvestment Decimal?         @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?         @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?         @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?         @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?         @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?         @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus    @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手（[{name, note}]）
  successProbability Decimal?         @db.Decimal(5, 2) // 成功概率 %
  ownerId            String? // 负责人
  description        String?
  project            Project?
  convertedAt        DateTime? // CTO #3C5：机会转项目时间（唯一入口 convert 回写）
  convertedBy        String? // CTO #3C5：机会转项目操作人
  quotations         Quotation[]
  isActive           Boolean          @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus   @default(DRAFT)
  version            Int              @default(1)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目（试样/测试/小批量/批量供货/暂停/失败/结项阶段）。
model Project {
  id                 String              @id @default(cuid())
  code               String              @unique // 项目编号（用 DocumentSequence 生成）
  name               String // 项目名称
  opportunityId      String?           @unique // 关联的项目机会（可空，1:1）
  opportunity        ProjectOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customerId         String
  customer           BusinessPartner     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stage              ProjectStage        @default(SAMPLING)
  customerInvestment Decimal?            @db.Decimal(14, 2) // 客户投入
  expectedRevenue    Decimal?            @db.Decimal(14, 2) // 预计营收
  expectedCost       Decimal?            @db.Decimal(14, 2) // 预计成本
  grossProfit        Decimal?            @db.Decimal(14, 2) // 毛利
  expenseBudget      Decimal?            @db.Decimal(14, 2) // 费用预算
  salesTarget        Decimal?            @db.Decimal(14, 2) // 销售目标
  paymentStatus      PaymentStatus       @default(UNPAID) // 回款状态
  competitors        Json? // 竞争对手
  successProbability Decimal?            @db.Decimal(5, 2) // 成功概率 %
  expectedContractAmount Decimal?        @db.Decimal(14, 2) // 预计合同金额
  expectedProfit Decimal?                 @db.Decimal(14, 2) // 预计利润
  expectedGrossMarginRate Decimal?        @db.Decimal(5, 2) // 预计毛利率 %
  receivedAmount Decimal?                 @db.Decimal(14, 2) // 回款金额
  invoicedAmount Decimal?                  @db.Decimal(14, 2) // 已开发票金额
  uninvoicedAmount Decimal?                @db.Decimal(14, 2) // 未开发票金额
  receivableBalance Decimal?               @db.Decimal(14, 2) // 应收余额
  projectRating String? // 项目评级
  failureReason String? // 失败原因
  priority     String? // 优先级（高/中/低，CTO #3C5 最小增量）
  progressPercent Decimal? @db.Decimal(5, 2) // 汇总进度 %（明细在 ProjectProgress）
  ownerId            String? // 项目负责人
  description        String?
  stakeholders       ProjectStakeholder[]
  members            ProjectMember[]
  milestones         ProjectMilestone[]
  tasks              ProjectTask[]
  budgets            ProjectBudget[]
  expenses           ProjectExpense[]
  products           ProjectProduct[]
  risks              ProjectRisk[]
  visits             ProjectVisit[]
  progresses         ProjectProgress[]
  acceptances        ProjectAcceptance[]
  closure            ProjectClosure?
  tags               ProjectTag[]
  quotations         Quotation[]
  salesOrders         SalesOrder[]
  purchaseOrderLines  PurchaseOrderLine[] // 5B：直送 PO 行（PurchaseOrderLine.project 方向，P4 Final）
  isActive           Boolean             @default(true)
  createdById        String?
  updatedById        String?
  approvedById       String?
  approvalStatus     ApprovalStatus      @default(DRAFT)
  version            Int                 @default(1)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([stage])
  @@index([name])
  @@index([deletedAt])
}

/// 项目关系人：需求人 / 技术人 / 采购人 / 决策人 / 使用人。
model ProjectStakeholder {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        StakeholderRole
  name        String // 姓名
  title       String? // 职务
  department  String?
  phone       String?
  email       String?
  note        String?
  isActive    Boolean         @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([role])
  @@index([deletedAt])
}

/// 项目成员（内部团队）。
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String? // 关联系统用户（可空，允许未建账号成员）
  name        String // 姓名
  roleInProject String? // 项目内角色（如：项目经理/技术负责/销售）
  joinedAt    DateTime?
  leftAt      DateTime?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目里程碑（含交付成果与延期原因）。
model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String // 里程碑名称
  plannedDate   DateTime? // 计划日期
  actualDate    DateTime? // 实际日期
  status        MilestoneStatus @default(PLANNED)
  deliverable   String? // 交付成果
  delayReason   String? // 延期原因
  isActive      Boolean         @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int             @default(1)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目任务。
model ProjectTask {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String? // 关联里程碑（可空）
  name        String // 任务名称
  assigneeId  String? // 负责人
  dueDate     DateTime?
  status      TaskStatus  @default(TODO)
  priority    String? // 高/中/低
  description String?
  isActive    Boolean     @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([milestoneId])
  @@index([deletedAt])
}

/// 项目预算（按科目）。
model ProjectBudget {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String // 预算科目（如：差旅/招待/测试/试样）
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("CNY")
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目费用（实际支出）。
model ProjectExpense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String // 费用科目
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("CNY")
  incurredAt  DateTime?
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目产品（项目涉及的产品/物料，关联 Item 主数据）。
model ProjectProduct {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Decimal? @db.Decimal(14, 2) // 数量
  unitPrice   Decimal? @db.Decimal(14, 4) // 单价（历史快照兼容字段）
  priceSnapshotId String? // CTO #3C5：价格快照引用（resolvePrice 生成，可空）
  priceSnapshot QuotationPriceSnapshot? @relation(fields: [priceSnapshotId], references: [id], onDelete: SetNull)
  note        String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([itemId])
  @@index([priceSnapshotId])
  @@index([deletedAt])
}

/// 项目风险（含应对方案、责任人、关闭状态）。
model ProjectRisk {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String // 风险描述
  impact      String? // 影响
  probability String? // 概率（高/中/低）
  mitigation  String? // 应对方案
  ownerId     String? // 责任人
  status      RiskStatus @default(OPEN)
  closedAt    DateTime?
  isActive    Boolean    @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int        @default(1)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 客户走访与沟通记录（支持下次行动与提醒）。
model ProjectVisit {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitType   VisitType @default(VISIT)
  visitedAt   DateTime  @default(now())
  visitorId   String? // 走访人
  contactName String? // 客户联系人
  summary     String // 沟通纪要
  nextAction  String? // 下次行动
  reminderAt  DateTime? // 提醒时间
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目进展记录。
model ProjectProgress {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedAt      DateTime @default(now())
  progressPercent Decimal  @db.Decimal(5, 2) // 进度百分比
  summary         String // 进展说明
  isActive        Boolean  @default(true)
  createdById     String?
  updatedById     String?
  approvedById    String?
  approvalStatus  ApprovalStatus @default(DRAFT)
  version         Int      @default(1)
  deletedAt       DateTime?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目验收（含验收结果）。
model ProjectAcceptance {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // 验收项
  expectedDate DateTime?
  actualDate  DateTime?
  result      AcceptanceResult @default(PENDING)
  resultNote  String? // 验收结果说明
  isActive    Boolean          @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int              @default(1)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([projectId])
  @@index([deletedAt])
}

/// 项目结项（1:1）。
model ProjectClosure {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedAt    DateTime @default(now())
  reason      String // 结项原因
  summary     String? // 结项总结
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Workflow Foundation（工作流底座）
// CTO directive: Workflow（定义流程）与 Approval（执行审批）解耦；统一审计字段；
// 所有引用关系明确 onDelete；枚举集中管理。
// ============================================================================

/// 工作流状态：草稿 / 已启用 / 已归档
enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// 审批方式：串签 / 会签 / 或签 / 会签(多人全签)
enum ApprovalMode {
  SEQUENTIAL // 串签
  PARALLEL // 会签（多人并行，全部通过）
  ANY_ONE // 或签（任一通过）
  COUNTERSIGN // 会签（指定人数）
}

/// 审批人类型：用户 / 角色 / 部门 / 审批组
enum ApproverType {
  USER
  ROLE
  DEPARTMENT
  APPROVER_GROUP
}

/// 工作流动作：统一动作，业务模块不各自实现
enum WorkflowActionType {
  SUBMIT // 提交
  APPROVE // 审批通过
  REJECT // 驳回
  RETURN // 退回
  TRANSFER // 转交
  DELEGATE // 委托
  WITHDRAW // 撤销
  TERMINATE // 终止
  COMMENT // 评论
}

/// 条件操作符（与业务字段组合，如 amount > 100000）
enum ConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  CONTAINS
}

/// 工作流实例状态：运行中 / 已完成 / 已驳回 / 已终止 / 已撤销
enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  REJECTED
  TERMINATED
  WITHDRAWN
}

/// 审批人处理状态
enum ApproverStatus {
  PENDING // 待处理
  APPROVED // 已通过
  REJECTED // 已驳回
  DELEGATED // 已委托
  SKIPPED // 已跳过
}

/// 工作流定义（流程模板）。所有业务模块（报价/合同/采购/付款/费用）引用这里，禁止写死流程。
model WorkflowDefinition {
  id          String         @id @default(cuid())
  code        String         @unique // 工作流编码（如 QUOTATION_APPROVAL）
  name        String // 工作流名称
  module      String // 所属模块（quotation/contract/purchase/payment/expense/custom）
  version     Int            @default(1) // 流程版本
  status      WorkflowStatus @default(DRAFT)
  description String?
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
  approvalPolicyRules ApprovalPolicyRule[]
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([module])
  @@index([status])
  @@index([deletedAt])
}

/// 工作流步骤（节点）。
model WorkflowStep {
  id            String         @id @default(cuid())
  definitionId  String
  definition    WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  stepNo        Int // 步骤序号
  stepName      String // 步骤名称
  approverType  ApproverType   @default(USER) // 审批人类型
  approverValue String? // 审批人值（用户ID/角色编码/部门ID/审批组ID）
  approvalMode  ApprovalMode   @default(SEQUENTIAL) // 审批方式
  timeoutHours  Int? // 超时时间（小时）
  allowReject   Boolean        @default(true) // 允许驳回
  allowTransfer Boolean        @default(false) // 允许转交
  allowDelegate Boolean        @default(false) // 允许委托
  allowWithdraw Boolean        @default(false) // 允许撤销
  conditions    WorkflowCondition[]
  isActive      Boolean        @default(true)
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version       Int            @default(1)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([definitionId, stepNo])
  @@index([definitionId])
  @@index([deletedAt])
}

/// 工作流条件（结构化，不存 JSON）：field + operator + value
model WorkflowCondition {
  id          String          @id @default(cuid())
  stepId      String
  step        WorkflowStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  expression  String? // 组合表达式（如 A AND B）
  field       String // 字段名（amount/department/currency 等）
  operator    ConditionOperator // 操作符
  value       String // 比较值（如 100000/Sales/CNY）
  isActive    Boolean         @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([stepId])
  @@index([deletedAt])
}

/// 工作流实例（真正业务实例，如某张报价单的审批流）。
model WorkflowInstance {
  id           String          @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  businessType String // 业务类型（quotation/sales-order/purchase-order/expense 等）
  businessId   String // 业务单据 ID
  currentStepNo Int? // 当前步骤
  startedBy    String // 发起人
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  status       WorkflowInstanceStatus @default(RUNNING) // 实例状态
  actions      WorkflowAction[]
  history      WorkflowHistory[]
  approvers    Approver[]
  escalations  ApprovalEscalation[]
  timeouts     ApprovalTimeout[]
  reminders    ApprovalReminder[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  writeOffs    WriteOff[] // 4E-2：写销审批（Workflow 唯一审批事实源）
  creditDebitNotes CreditDebitNote[] // 4E-3：CN/DN 审批（Workflow 唯一审批事实源）
  purchaseRequisitions PurchaseRequisition[] // 5A：采购申请审批（Workflow 唯一审批事实源）
  purchaseOrders PurchaseOrder[] // 5A：采购订单审批（Workflow 唯一审批事实源）
  isActive     Boolean         @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version      Int             @default(1)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([businessType, businessId])
  @@index([definitionId])
  @@index([startedBy])
  @@index([status])
  @@index([deletedAt])
}

/// 工作流动作（统一动作记录）。
model WorkflowAction {
  id          String            @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actionType  WorkflowActionType // 动作类型
  actorId     String // 操作人
  targetUserId String? // 转交/委托目标
  stepNo      Int? // 所属步骤
  comment     String? // 备注
  isActive    Boolean           @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int               @default(1)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([actorId])
  @@index([deletedAt])
}

/// 工作流历史（一次做到位，与 Audit 共用字段）。
model WorkflowHistory {
  id           String            @id @default(cuid())
  instanceId   String
  instance     WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo       Int?
  actionType   WorkflowActionType
  beforeStatus String? // 前状态
  afterStatus  String? // 后状态
  actorId      String? // 操作人
  ip           String? // IP
  device       String? // 设备
  browser      String? // 浏览器
  remark       String? // 备注
  attachment   String? // 附件
  duration     Int? // 耗时（秒）
  isActive     Boolean           @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version      Int               @default(1)
  deletedAt    DateTime?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([actorId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Approval Engine（审批执行，与 Workflow 解耦）
// Workflow 定义流程；Approval 执行审批。两个领域。
// ============================================================================

/// 审批人（实例级：每个审批步骤的实际处理人）
model Approver {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int // 步骤
  userId      String // 审批人
  status      ApproverStatus  @default(PENDING) // 处理状态
  delegatedFrom String? // 委托来源
  decidedAt   DateTime?
  comment     String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([userId])
  @@index([deletedAt])
}

/// 审批组（可复用审批人集合，如"销售总监组"）
model ApproverGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  members     ApproverGroupMember[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 审批组成员
model ApproverGroupMember {
  id          String   @id @default(cuid())
  groupId     String
  group       ApproverGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([deletedAt])
}

/// 委托规则（用户→用户）
model ApprovalDelegate {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([deletedAt])
}

/// 升级规则（超时/未处理 → 升级到上级）
model ApprovalEscalation {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  thresholdHours Int // 超时阈值（小时）
  escalateToUserId String? // 升级到
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

/// 超时规则（实例级）
model ApprovalTimeout {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  timeoutHours Int
  actionOnTimeout WorkflowActionType @default(TERMINATE) // 超时动作
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

/// 提醒规则（催办）
model ApprovalReminder {
  id          String   @id @default(cuid())
  instanceId  String
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepNo      Int
  intervalHours Int // 提醒间隔（小时）
  maxTimes    Int      @default(3)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([instanceId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Notification（统一事件中心）
// ============================================================================

/// 通知渠道类型
enum NotificationChannelType {
  SYSTEM
  EMAIL
  TELEGRAM
  WEBHOOK
  WECHAT // 预留
  DINGTALK // 预留
}

/// 通知状态
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

/// 通知模板
model NotificationTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  channel     NotificationChannelType @default(SYSTEM)
  subject     String? // 标题
  content     String // 内容（支持变量占位）
  messages    NotificationMessage[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 通知消息
model NotificationMessage {
  id          String   @id @default(cuid())
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientUserId String? // 收件人
  channel     NotificationChannelType @default(SYSTEM)
  subject     String?
  content     String
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  readAt      DateTime?
  error       String?
  logs        NotificationLog[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([recipientUserId])
  @@index([status])
  @@index([deletedAt])
}

/// 通知渠道配置（预留 webhook/企业微信/钉钉）
model NotificationChannel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  channelType NotificationChannelType @default(SYSTEM)
  config      Json? // 渠道配置（webhook url/token 等）
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 通知发送日志
model NotificationLog {
  id          String   @id @default(cuid())
  messageId   String?
  message     NotificationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  channel     NotificationChannelType
  status      NotificationStatus
  payload     Json?
  error       String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([messageId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Dictionary（字典管理）
// ============================================================================

/// 字典类型
model DictionaryType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String? // 分类
  language    String   @default("zh-CN") // 语言
  sort        Int      @default(0)
  icon        String? // 图标
  color       String? // 颜色
  enabled     Boolean  @default(true)
  items       DictionaryItem[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 字典项
model DictionaryItem {
  id          String   @id @default(cuid())
  typeId      String
  type        DictionaryType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  code        String
  label       String
  sort        Int      @default(0)
  color       String?
  icon        String?
  enabled     Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([typeId, code])
  @@index([typeId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3A - Settings（参数配置：System / Tenant / User 三层 Key-Value）
// ============================================================================

/// 设置范围
enum SettingScope {
  SYSTEM
  TENANT
  USER
}

/// 设置数据类型
enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET // 加密存储
}

/// 系统设置（Key-Value，支持加密）
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  dataType    SettingDataType @default(STRING)
  encrypted   Boolean  @default(false) // 密码类直接加密
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 租户设置（预留多租户）
model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       String?
  dataType    SettingDataType @default(STRING)
  encrypted   Boolean  @default(false)
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([deletedAt])
}

/// 用户设置
model UserSetting {
  id          String   @id @default(cuid())
  userId      String
  key         String
  value       String?
  dataType    SettingDataType @default(STRING)
  encrypted   Boolean  @default(false)
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([userId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3B - Menu Center（菜单中心：前端直接读取，RouteMeta 内联）
// ============================================================================

/// 菜单组（顶级分组，如"主数据"）
model MenuGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  icon        String? // 分组图标
  sort        Int      @default(0)
  menus       Menu[]
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// 菜单（树形：parentId 自关联；RouteMeta 内联）
model Menu {
  id           String   @id @default(cuid())
  groupId      String
  group        MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Menu[]   @relation("MenuTree")
  code         String   @unique
  name         String
  path         String? // 路由路径
  icon         String? // 图标
  sort         Int      @default(0)
  hidden       Boolean  @default(false) // 隐藏
  cache        Boolean  @default(false) // 缓存
  externalLink String? // 外链（http(s)://）
  permission   String? // 关联权限码（如 workflow-definition:view）
  isActive     Boolean  @default(true)
  createdById  String?
  updatedById  String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version      Int      @default(1)
  deletedAt    DateTime?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([groupId])
  @@index([parentId])
  @@index([deletedAt])
}

// ============================================================================
// Sprint 3B - Dashboard API（只提供数据 API，页面以后开发）
// ============================================================================

/// Dashboard Widget 类型
enum DashboardWidgetType {
  KPI
  CHART
  TABLE
}

/// Dashboard Chart 类型
enum DashboardChartType {
  LINE
  BAR
  PIE
  AREA
  SCATTER
}

/// KPI 聚合方式
enum DashboardAggregate {
  SUM
  AVG
  COUNT
  MIN
  MAX
}

/// Dashboard Widget（组件定义）
model DashboardWidget {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  widgetType     DashboardWidgetType @default(KPI)
  dataSource     String? // 数据源标识（如 sales-order/project）
  query          Json? // 查询配置
  refreshInterval Int? // 刷新间隔（秒）
  sort           Int                 @default(0)
  enabled        Boolean             @default(true)
  isActive       Boolean             @default(true)
  createdById    String?
  updatedById    String?
  approvedById   String?
  approvalStatus ApprovalStatus      @default(DRAFT)
  version        Int                 @default(1)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// Dashboard Layout（布局：widget 位置网格）
model DashboardLayout {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  isDefault   Boolean  @default(false)
  grid        Json? // [{ widgetId, x, y, w, h }]
  enabled     Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// Dashboard KPI（指标定义）
model DashboardKpi {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  unit        String? // 单位（CNY/%/件）
  aggregate   DashboardAggregate @default(SUM)
  dataSource  String? // 数据源（如 project/sales-order）
  query       Json? // 过滤/统计配置
  target      Decimal? @db.Decimal(18, 2) // 目标值
  sort        Int                @default(0)
  enabled     Boolean            @default(true)
  isActive    Boolean            @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus  @default(DRAFT)
  version     Int                @default(1)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

/// Dashboard Chart（图表定义）
model DashboardChart {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  chartType   DashboardChartType @default(LINE)
  dataSource  String? // 数据源（如 sales-order/project）
  query       Json? // 查询配置
  xAxis       String? // X 轴字段
  yAxis       String? // Y 轴字段
  sort        Int                @default(0)
  enabled     Boolean            @default(true)
  isActive    Boolean            @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus  @default(DRAFT)
  version     Int                @default(1)
  deletedAt   DateTime?
