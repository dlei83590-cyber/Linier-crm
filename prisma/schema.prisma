/// 技术标准主数据（如 GB/T、ISO）
model TechnicalStandard {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  isActive    Boolean        @default(true)
  createdById String?
  updatedById String?
  approvedById String?
  approvalStatus ApprovalStatus @default(DRAFT)
  version     Int            @default(1)
  deletedAt   DateTime?
  items       ItemStandard[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([deletedAt])
}

/// Item 与 TechnicalStandard 的多对多关联
model ItemStandard {
  id         String            @id @default(cuid())
  itemId     String
  item       Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  standardId String
  standard   TechnicalStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([itemId, standardId])
  @@index([standardId])
}

/// 统一往来单位：客户 / 供应商 / 客户兼供应商。
model BusinessPartner {
  id                  String         @id @default(cuid())
  code                String         @unique // 内部编码
  mnemonic            String? // 助记码
  name                String // 中文名称
  type                PartnerType    @default(SUPPLIER)
  uscc                String?        @unique // 统一社会信用代码
  taxpayerType        String? // 纳税人类型（一般纳税人/小规模纳税人）
  legalRepresentative String? // 法定代表人
  registeredAddress   String? // 注册地址
  invoiceInfo         Json? // 开票信息
  bankName            String? // 开户银行
  bankAccount         String? // 银行账号
  settlementTerms     String? // 结算条款
  shortName            String? // 客户简称
  fullName             String? // 客户全称
  groupName            String? // 集团名称
  region               String? // 所属区域
  industry             String? // 所属行业
  companySize          String? // 企业规模
  creditRating         String? // 信用等级
  sourceChannel        String? // 来源渠道
  foundedDate          DateTime? // 成立日期
  registeredCapital    Decimal?      @db.Decimal(14, 2) // 注册资本（万元）
  employeeCount        Int? // 员工人数
  website              String? // 官网
  wechatOfficialAccount String? // 微信公众号
  tags                 Json? // 企业标签
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  isActive            Boolean        @default(true)
  createdById         String?
  updatedById         String?
  approvedById        String?
  approvalStatus      ApprovalStatus @default(DRAFT)
  version             Int            @default(1)
  deletedAt           DateTime?
  opportunities       ProjectOpportunity[]
  projects            Project[]
  customers           Customer[]
  roles               BusinessPartnerRole[]
  partnerContacts     PartnerContact[]
  partnerAddresses    PartnerAddress[]
  partnerTags         PartnerTag[]
  partnerBankAccounts PartnerBankAccount[]
  partnerCredit       PartnerCredit?
  invoiceInfoRecord   BusinessPartnerInvoiceInfo? // 开票资料（1:1；中国审计 P1，ADR-0043；invoiceInfo 遗留 Json 保留兼容）
  suppliers           Supplier[]
  supplierItems       SupplierItem[]
  partnerPrices       PartnerPrice[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  deliveries          Delivery[]
  invoices            Invoice[]
  accountsReceivables AccountsReceivable[] // 应收余额（4E-1；余额事实源，BusinessPartner 对账用）
  receipts            Receipt[] // 收款（4E-2；收款事实源）
  creditDebitNotes    CreditDebitNote[] // 4E-3：发票调整单（CN/DN；CreditDebitNote.customerId 方向）
  invoiceAdjustments  InvoiceAdjustment[] // 4E-3：调整事实（InvoiceAdjustment.customerId 方向）
