  updatedById String?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lines     InvoiceLine[]
  revisions InvoiceRevision[]
  snapshots InvoiceSnapshot[]
  accountsReceivable AccountsReceivable? // 余额事实源（4E-1；1:1，Invoice 为单据事实源，AR 持真实余额）
  creditDebitNotes CreditDebitNote[] // 4E-3：发票调整单（CN/DN；单票制 sourceInvoiceId）
  adjustments InvoiceAdjustment[] // 4E-3：调整事实（InvoiceAdjustment.invoiceId 方向）

  @@index([deliveryId])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
  @@index([workflowInstanceId])
  @@index([deletedAt])
